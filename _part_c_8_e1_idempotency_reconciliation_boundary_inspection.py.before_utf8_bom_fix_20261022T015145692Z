def sha256_path(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def source_hashes(paths: list[Path]) -> dict[str, str]:
    return {
        path.as_posix(): sha256_path(path)
        for path in paths
        if path.is_file()
    }


def clean_annotation(node: ast.AST | None) -> str:
    if node is None:
        return ""
    try:
        return ast.unparse(node)
    except Exception:
        return ""


def ast_signature(node: ast.FunctionDef | ast.AsyncFunctionDef) -> str:
    arguments = []
    positional = list(node.args.posonlyargs) + list(node.args.args)
    positional_defaults = [None] * (
        len(positional) - len(node.args.defaults)
    ) + list(node.args.defaults)

    for argument, default in zip(positional, positional_defaults):
        item = argument.arg
        annotation = clean_annotation(argument.annotation)
        if annotation:
            item += f": {annotation}"
        if default is not None:
            item += f" = {ast.unparse(default)}"
        arguments.append(item)

    if node.args.vararg is not None:
        item = "*" + node.args.vararg.arg
        annotation = clean_annotation(node.args.vararg.annotation)
        if annotation:
            item += f": {annotation}"
        arguments.append(item)
    elif node.args.kwonlyargs:
        arguments.append("*")

    for argument, default in zip(
        node.args.kwonlyargs,
        node.args.kw_defaults,
    ):
        item = argument.arg
        annotation = clean_annotation(argument.annotation)
        if annotation:
            item += f": {annotation}"
        if default is not None:
            item += f" = {ast.unparse(default)}"
        arguments.append(item)

    if node.args.kwarg is not None:
        item = "**" + node.args.kwarg.arg
        annotation = clean_annotation(node.args.kwarg.annotation)
        if annotation:
            item += f": {annotation}"
        arguments.append(item)

    result = f"({', '.join(arguments)})"
    returns = clean_annotation(node.returns)
    if returns:
        result += f" -> {returns}"
    return result


def dotted_call_name(node: ast.AST) -> str:
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Attribute):
        prefix = dotted_call_name(node.value)
        return f"{prefix}.{node.attr}" if prefix else node.attr
    return ""


def callable_inventory(path: Path) -> dict:
    text = path.read_text(encoding="utf-8")
    tree = ast.parse(text, filename=str(path))
    functions = []
    classes = []

    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            calls = sorted(
                {
                    dotted_call_name(call.func)
                    for call in ast.walk(node)
                    if isinstance(call, ast.Call)
                    and dotted_call_name(call.func)
                }
            )
            functions.append(
                {
                    "name": node.name,
                    "line": node.lineno,
                    "signature": ast_signature(node),
                    "calls": calls,
                }
            )
        elif isinstance(node, ast.ClassDef):
            methods = []
            for child in node.body:
                if isinstance(
                    child,
                    (ast.FunctionDef, ast.AsyncFunctionDef),
                ):
                    methods.append(
                        {
                            "name": child.name,
                            "line": child.lineno,
                            "signature": ast_signature(child),
                        }
                    )
            classes.append(
                {
                    "name": node.name,
                    "line": node.lineno,
                    "methods": methods,
                }
            )

    return {
        "functions": functions,
        "classes": classes,
    }


def matching_callables(
    inventory: dict,
    terms: tuple[str, ...],
) -> list[dict]:
    results = []
    for function in inventory["functions"]:
        name = function["name"].lower()
        if any(term in name for term in terms):
            results.append(function)
    for class_row in inventory["classes"]:
        for method in class_row["methods"]:
            qualified = (
                f"{class_row['name']}.{method['name']}"
            )
            if any(term in qualified.lower() for term in terms):
                results.append(
                    {
                        **method,
                        "name": qualified,
                        "calls": [],
                    }
                )
    return results


def public_callable_details(module, names: tuple[str, ...]) -> dict:
    result = {}
    for name in names:
        value = getattr(module, name, None)
        row = {
            "available": callable(value),
            "name": name,
        }
        if callable(value):
            try:
                row["signature"] = str(inspect.signature(value))
            except (TypeError, ValueError):
                row["signature"] = ""
            try:
                source = inspect.getsource(value)
            except (OSError, TypeError):
                source = ""
            row["source_excerpt"] = source[:12000]
        result[name] = row
    return result


def registry_file_hash(snapshot: Mapping) -> tuple[str, str | None]:
    path_text = str(
        snapshot.get("persistent_registry_path") or ""
    ).strip()
    if not path_text:
        return "", None
    path = Path(path_text)
    if not path.is_file():
        return str(path), None
    return str(path), sha256_path(path)


def render_report(
    *,
    generated: str,
    root: Path,
    checks: dict[str, bool],
    decision: dict,
    evidence: dict,
    execution_error,
) -> str:
    failed = [name for name, passed in checks.items() if not passed]
    status = "COMPLETE" if execution_error is None and not failed else "NOT_COMPLETE"
    final = (
        "PART C 8-E1 COMPLETE"
        if status == "COMPLETE"
        else "PART C 8-E1 NOT_COMPLETE"
    )
    lines = [
        "LINKCRAFTER UNIVERSAL COORDINATION",
        "PART C 8-E1 IDEMPOTENCY AND RECONCILIATION BOUNDARY INSPECTION",
        "",
        f"Generated: {generated}",
        "Mode: READ-ONLY TARGETED INSPECTION",
        f"Project root: {root}",
        "Production source changes: NONE",
        "Runtime registrations created: NO",
        "Registry persistence executed: NO",
        "Universal Jobs created: NO",
        "Queue claims executed: NO",
        "Handlers executed: NO",
        "Live network requests executed: NO",
        f"INSPECTION STATUS: {status}",
        "",
        "=" * 110,
        "INSPECTION DECISION",
        "=" * 110,
        json.dumps(decision, indent=2, sort_keys=True),
        "",
        "=" * 110,
        "CHECKS",
        "=" * 110,
        json.dumps(checks, indent=2, sort_keys=True),
        "",
        "FAILED_CHECKS:",
        json.dumps(failed, indent=2),
        "",
        "=" * 110,
        "BOUNDARY EVIDENCE",
        "=" * 110,
        json.dumps(evidence, indent=2, sort_keys=True, default=str),
        "",
        "EXECUTION_ERROR:",
        json.dumps(execution_error, indent=2, default=str),
        "",
        "=" * 110,
        "NEXT STEP",
        "=" * 110,
        (
            "Use this frozen boundary to implement Part C 8-E2. Reuse the canonical Universal Job "
            "idempotency authority; add only the Coordination-owned deterministic execution identity "
            "and partial-wave reconciliation boundary required by the evidence."
            if status == "COMPLETE"
            else "Correct the inspection failure before implementing Part C 8-E2."
        ),
        "",
        "=" * 110,
        "FINAL RESULT",
        "=" * 110,
        final,
        "",
    ]
    return "\n".join(lines)


