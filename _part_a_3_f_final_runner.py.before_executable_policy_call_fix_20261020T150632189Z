@dataclass
class ProbeJob:
    job_id: str
    workspace_id: str
    job_type: str
    status: str
    metadata: dict[str, Any] = field(default_factory=dict)


def canonical_metadata(
    job_id: str,
    dependency_ids: tuple[str, ...],
) -> dict[str, Any]:
    return {
        "universal_runtime": {
            "canonical_job": {
                "job_id": job_id,
                "dependency_job_ids":
                    list(dependency_ids),
            },
        },
    }


try:
    emit("=" * 112)
    emit("PART A 3-F - DEPENDENCIES AND FINAL CONNECTION")
    emit("=" * 112)

    required_paths = (
