def check(
    label: str,
    condition: Any,
    detail: Any = "",
) -> None:
    passed = bool(condition)
    checks.append((label, passed))

    emit(
        f"{label}: "
        + ("PASS" if passed else "FAIL")
    )

    if detail != "":
        emit("  " + str(detail))


def sha256(path: Path) -> str:
    return hashlib.sha256(
        path.read_bytes()
    ).hexdigest()


