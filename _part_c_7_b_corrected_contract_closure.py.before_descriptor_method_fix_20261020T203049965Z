def sha256(path: Path) -> str:
    return hashlib.sha256(
        path.read_bytes()
    ).hexdigest()


def module_source(module: Any) -> Path:
    source = getattr(
        module,
        "__file__",
        None,
    )

    if not source:
        raise RuntimeError(
            f"Source unavailable: {module.__name__}"
        )

    path = Path(source).resolve()

    if path.suffix == ".pyc":
        candidate = Path(
            str(path)[:-1]
        )

        if candidate.is_file():
            path = candidate

    if not path.is_file():
        raise RuntimeError(
            f"Source file unavailable: {path}"
        )

    return path


def frozen_dataclass(value: Any) -> bool:
    parameters = getattr(
        value,
        "__dataclass_params__",
        None,
    )

    return (
        dataclasses.is_dataclass(value)
        and parameters is not None
        and bool(parameters.frozen)
    )


def dataclass_field_names(
    value: Any,
) -> set[str]:
    if not dataclasses.is_dataclass(value):
        return set()

    return {
        field.name
        for field in dataclasses.fields(value)
    }


def property_names(value: Any) -> set[str]:
    return {
        name
        for name, member in vars(value).items()
        if isinstance(member, property)
    }


def method_names(value: Any) -> set[str]:
    return {
        name
        for name, member in vars(value).items()
        if (
            not name.startswith("_")
            and callable(member)
        )
    }


def enum_evidence(value: Any) -> dict[str, str]:
    if (
        not isinstance(value, type)
        or not issubclass(value, Enum)
    ):
        return {}

    return {
        name: str(member.value)
        for name, member in value.__members__.items()
    }


