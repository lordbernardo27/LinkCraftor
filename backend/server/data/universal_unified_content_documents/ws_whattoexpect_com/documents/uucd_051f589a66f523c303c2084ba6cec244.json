    "source_record_id": "raw_html_5551f41a15c22e35",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-health-chickenpox-myths_5551f41a.html",
