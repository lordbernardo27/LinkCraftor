  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/pregnancy/labor-and-delivery/procedures-and-interventions/vacuum-extraction.aspx",
    "source_record_id": "raw_html_a24a88ca1bef465d",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-labor-and-delivery-procedures-and-interventions-vacuum-extraction-aspx_a24a88ca.html",
