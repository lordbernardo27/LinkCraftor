    "source_record_id": "raw_html_6479bd19030bedcd",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-labor-and-delivery-shaking-labor_6479bd19.html",
