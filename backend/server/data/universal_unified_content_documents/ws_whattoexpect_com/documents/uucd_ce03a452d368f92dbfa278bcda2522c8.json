    "source_record_id": "raw_html_b27a13234cc8eb22",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-asthma-during-pregnancy_b27a1323.html",
