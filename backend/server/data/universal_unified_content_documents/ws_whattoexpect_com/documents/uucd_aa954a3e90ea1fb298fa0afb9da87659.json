        "text": "Your Next Read",
        "text_sha256": "6d2b65f6bc74d3f3d5656d8c88c806ff70605a0ce9d4fd990efe9af093220755",
        "word_count": 3
      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "p",
        "tag": "p",
        "text": "Can I Avoid an Episiotomy? Medically Reviewed by Andrei Rebarber, M.D.",
        "text_sha256": "bcebec3446e10f07e1a8d695d2caa53f11853b9131657b665b5ded53c6ad9ae8",
        "word_count": 11
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "Having a C-Section? Here’s What You Should Know Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "e4231dcb196d7c114468158470b7bf58ec9f6e8b2c98de924c96962d725a7fc0",
        "word_count": 15
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
        "tag": "p",
        "text": "Vaginal Tears During and After Childbirth Medically Reviewed by Shannon Smith, M.D.",
        "text_sha256": "67cebcafdd9e95cec89f4ba23d6e8b25fe210c6ed7a649b3186a1698f0c67c5e",
        "word_count": 12
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "p",
