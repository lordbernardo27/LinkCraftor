  "structure": {
    "block_count": 41,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "heading",
        "tag": "h1",
        "text": "What to Expect's Pregnancy & Baby App",
        "text_sha256": "f02dceb5fa664d45809e1491d66beddfd33da63348d6310568c9c316fbdc8fcb",
        "word_count": 7
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "p",
        "tag": "p",
        "text": "What to Expect Pregnancy and Baby App, woman in jeans looking at the app on her phone",
        "text_sha256": "68e2daefe6522580cb30950b098eddc6a2eef9fdd9c3885a9207f12b3ffcbb79",
        "word_count": 17
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "p",
        "tag": "p",
        "text": "Download for iPhone | Android",
        "text_sha256": "4a202330a0f2371e486340d4e0b8d40784fffe1d33bc49a789590fb918c4d980",
        "word_count": 5
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "What to Expect , the world’s best known, most trusted pregnancy and parenting brand, offers a pregnancy and baby app that guides you through your pregnancy and parenthood journey day-by-day and week-by-week.",
        "text_sha256": "4735a256c7b79561dec460e3c404b9b13fd8af8f2dcded1eef890a1e9347294c",
        "word_count": 32
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "The What to Expect pregnancy and baby tracker app is produced by our team of award-winning journalists, writers, editors, physicians and other pregnancy and parenting health experts, including the brand's founder Heidi Murkoff herself.",
        "text_sha256": "779085bee104eb8cbe2d59629564336d2f0138d35973a3f66c619461dd0085b9",
        "word_count": 34
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "Here are just a few of the key features and highlights of the What to Expect pregnancy and parenting app:",
        "text_sha256": "b1078c4a03f4630df0eeec6ab95d9427c098f639fa445578f299e45c7fc1b3b5",
        "word_count": 20
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "li",
        "tag": "li",
        "text": "A week-by-week pregnancy tracker that details your baby's development based on your due date and helps you understand your changing body",
        "text_sha256": "69e063da572fc98a2fbde9b4b9d596f74ef52f177981fd0889c47bcc9131e1bd",
        "word_count": 21
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "li",
        "tag": "li",
        "text": "A baby tracker that lets you time and track your baby’s feedings and log diaper changes, sleep routines, tummy time, solid foods, and your own notes",
        "text_sha256": "00e924c61b35496e2e0365fa5d89fecbb1025775ffa94eb88d68dd204d0d7a2e",
        "word_count": 26
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "li",
        "tag": "li",
        "text": "Community “birth month” groups based on your due date, so you can connect with other moms and moms-to-be at the same stage to get advice and support.",
        "text_sha256": "b7e96185e01b95285f59bb09b132060c8f26cb7246d1b4f636d829de48fd1812",
        "word_count": 27
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "li",
        "tag": "li",
        "text": "Special community groups based on locations, interests, health status and medical conditions, parenting styles, and more!",
        "text_sha256": "79af25bba8af462146675b81f69b93cb77338f3e228f7f92c7b6ccc2848910b3",
        "word_count": 16
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "li",
        "tag": "li",
        "text": "Personalized baby registry checklist and registry builder to help you build and share your registry with friends and family",
        "text_sha256": "1b48f9bd57bd1d044d0b2940e523e4e00a51736e8fd4f7a027a1bb9ccd92bee1",
        "word_count": 19
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "li",
        "tag": "li",
        "text": "Different baby size comparisons for each week of your pregnancy, including our ever-popular fruits for both singletons and twins, and other fun ones to choose from if you're just expecting one baby, including movie and TV props, nostalgia from the '80s and '90s, snacks, and sports",
        "text_sha256": "938c5577b8080907e3447c3e6a3186939e152db283085e3158e9308f25dd44e3",
        "word_count": 46
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "li",
        "tag": "li",
        "text": "Our My Journal feature that lets you track your symptoms, weight, medications, appointments, kick counts, memories and more while trying to conceive, during pregnancy and into postpartum",
        "text_sha256": "60ef833ddafbd615d0606c95c147f8607ea5b9c9d0d3dd54b386fb6228517bc7",
        "word_count": 27
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "li",
        "tag": "li",
        "text": "Baby development week-by-week and month-by-month guides that include sleep schedules, milestones, feeding tips and more",
        "text_sha256": "af2ac8c18599b8f34e0ada563c42fb737a0343268c3dc955a4111dd927a47eb3",
        "word_count": 15
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "li",
        "tag": "li",
        "text": "Helpful daily tips tailored to where you are in your pregnancy, postpartum or parenting journey",
        "text_sha256": "adea630fa6be3d0caa00da4839b0832467bb9faa65b91653193f8fe0bd5ed853",
        "word_count": 15
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "li",
        "tag": "li",
        "text": "Fun tools at your fingertips, like an ovulation calculator , due date calculator , Chinese gender predictor , pregnancy weight gain calculator and more!",
        "text_sha256": "862d183d32f56c3f5706ac3cc32e09dbf2a08c284cac8fa3a737393739053d4b",
        "word_count": 24
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "li",
        "tag": "li",
        "text": "Thousands of medically accurate articles, plus stories from real parents and parents-to-be, on every aspect of pregnancy and parenting, from the “trying to get pregnant” stage through the toddler years",
        "text_sha256": "e86dafc3fea14c4b3bc3fdb4fda7203c16995341fabcbf4fae17ab4f6f1087f3",
        "word_count": 30
      },
      {
        "block_id": "block_000017",
        "block_index": 17,
        "block_type": "li",
        "tag": "li",
        "text": "Videos about what to expect during each week of pregnancy and each month of your baby’s first year, hosted by What to Expect founder Heidi Murkoff",
        "text_sha256": "80466f6f9f7b0e49835348785488e56c1f91075796c54da64e67dc3491f2ff68",
        "word_count": 26
      },
      {
        "block_id": "block_000018",
        "block_index": 18,
        "block_type": "li",
        "tag": "li",
        "text": "Detailed baby product reviews and buying guides you can trust from our editorial team and experts",
        "text_sha256": "c227f9f0bfd2c85b793d7f2e621826fc0263f4acc92391ac0859eb0bb580c6fc",
        "word_count": 16
      },
      {
        "block_id": "block_000019",
        "block_index": 19,
        "block_type": "li",
        "tag": "li",
        "text": "A month-by-month toddler guide highlighting development, growth, milestones, health, tips and more",
        "text_sha256": "79d68fe5316f8de5854132f7ff4dc4e9824c2acf9f8b98950b00bc041a495625",
        "word_count": 12
      },
      {
        "block_id": "block_000020",
        "block_index": 20,
        "block_type": "li",
        "tag": "li",
        "text": "Search tools to help you find fast, accurate answers to your questions about pregnancy, parenting and fertility",
        "text_sha256": "9a2a48e74c5cfe5f386a9f9a13fe90cd72b7699059e52011d09c8cae5a7e2c9b",
        "word_count": 17
      },
      {
        "block_id": "block_000021",
        "block_index": 21,
        "block_type": "p",
        "tag": "p",
        "text": "All the content on What to Expect is accurate, up-to-date and regularly reviewed by the What to Expect Medical Review Board and other pregnancy and parenting health experts. It is in line with the latest evidence-based medical information and accepted health guidelines, including the What to Expect books by Heidi Murkoff.",
        "text_sha256": "fab26c7fced8de5228fab3b57675dcd986617330608af1d8aef9b3749938f5d5",
        "word_count": 51
      },
      {
        "block_id": "block_000022",
        "block_index": 22,
        "block_type": "p",
        "tag": "p",
        "text": "The medical guidelines and recommendations on What to Expect come from highly respected expert organizations including the American College of Obstetricians and Gynecologists (ACOG), the American Academy of Pediatrics (AAP) and the Centers for Disease Control and Prevention (CDC), as well as from peer-reviewed medical journals and other health and medical organizations.",
        "text_sha256": "3010cba18f6fe86557a2cd4ee1b5ebb02fbbdea133b1dc354f2a14ddf98cd700",
        "word_count": 52
      },
      {
        "block_id": "block_000023",
        "block_index": 23,
        "block_type": "p",
        "tag": "p",
        "text": "Use our pregnancy and parenting app to help you have a happy, healthy pregnancy and a happy, healthy baby! We're here for you as you embark (or continue) on this exciting, life-changing journey.",
        "text_sha256": "cff2108cd8bd5c459db027a3abb92cead843ed743567404c1f88e645612745ff",
        "word_count": 33
      },
      {
        "block_id": "block_000024",
        "block_index": 24,
        "block_type": "heading",
        "tag": "h2",
        "text": "Your Next Read",
        "text_sha256": "6d2b65f6bc74d3f3d5656d8c88c806ff70605a0ce9d4fd990efe9af093220755",
        "word_count": 3
      },
      {
        "block_id": "block_000025",
        "block_index": 25,
        "block_type": "p",
        "tag": "p",
        "text": "You're Going to Need to Track Your Baby’s Feedings, Diaper Changes, Sleep, and More. Here's How Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "2e830b42e9a1ed2b40979c05c0b7df9253885c8d28388249a7a0b42b7e8bba6e",
        "word_count": 23
      },
      {
        "block_id": "block_000026",
        "block_index": 26,
        "block_type": "p",
        "tag": "p",
        "text": "Meet the Winners of the 2025 What to Expect Mom Must-Have Awards Fact Checked by Morgan Bulman, Commerce Editor",
        "text_sha256": "147497d0fbeda2ffbf1c99828a35b133868eb12d9bc2d1ecc67ce7846d719162",
        "word_count": 19
      },
      {
        "block_id": "block_000027",
        "block_index": 27,
        "block_type": "p",
        "tag": "p",
        "text": "I Tried the Tinder of Baby Name Apps and It Was Not What I Expected Fact Checked by Kathleen Felton, Contributing Writer/Editor",
        "text_sha256": "4d922898679acffa428389641aeb8ee1e392ba5d7374b254266f5ba1cdb2a5bb",
        "word_count": 22
      },
      {
        "block_id": "block_000028",
        "block_index": 28,
        "block_type": "p",
        "tag": "p",
        "text": "Baby Gear Shopping: A Practical Guide to What You Really Need Fact Checked by Catherine Donaldson-Evans, Managing Editor",
        "text_sha256": "b30e88971795495e95b51e0a0f57188ae03fc3f7216a036b47a03804c7a13b12",
        "word_count": 18
      },
      {
        "block_id": "block_000029",
        "block_index": 29,
        "block_type": "p",
        "tag": "p",
        "text": "Pregnancy A to Z: A Complete Guide to Every Term Fact Checked by Karen Miles, Contributing Writer/Editor",
        "text_sha256": "9927d03985817e718e2563d9c169dc768f974c2dd1abc414e257d98d0377ed4b",
        "word_count": 17
      },
      {
        "block_id": "block_000030",
        "block_index": 30,
        "block_type": "p",
        "tag": "p",
        "text": "8 Things to Keep in Mind When Choosing a Baby Name Fact Checked by Catherine Donaldson-Evans, Managing Editor",
        "text_sha256": "0ec0179d49faa19709fdd1a714347a67b0a9f6832f2b202962e1bd1693d00cfb",
        "word_count": 18
      },
      {
        "block_id": "block_000031",
        "block_index": 31,
        "block_type": "p",
        "tag": "p",
        "text": "Do I Really Need All Those Prenatal Appointments? Medically Reviewed by Mark Payson, M.D.",
        "text_sha256": "1e8ad02f269641a870b39ae9f94669d44f5cc408aad2db4a7b7a03dd25327fbc",
        "word_count": 14
      },
      {
        "block_id": "block_000032",
        "block_index": 32,
        "block_type": "p",
        "tag": "p",
        "text": "The Ultimate Third Trimester Checklist: Everything to Do Before Your Baby’s Birthday Medically Reviewed by James Greenberg, M.D.",
        "text_sha256": "9fb67933548174b2e84f9734efb75c5f1c7449a29f31b862e6eeee5f26657807",
        "word_count": 18
      },
      {
        "block_id": "block_000033",
        "block_index": 33,
        "block_type": "p",
        "tag": "p",
        "text": "Baby Registry Checklist: Exactly What to Put on a Baby Registry Medically Reviewed by Gina Posner, M.D., F.A.A.P.",
        "text_sha256": "4455a49e52fb1dd09f3f65cb1ccba370588b2973e667c78ab7b11c3091852b6f",
        "word_count": 18
      },
      {
        "block_id": "block_000034",
        "block_index": 34,
        "block_type": "p",
        "tag": "p",
        "text": "Pregnancy Weight Gain Calculator Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "6d1b12c8f4ec5d054f19b6bba5df4b09beabd39aad69086dac4b8c7826287b9a",
        "word_count": 11
      },
      {
        "block_id": "block_000035",
        "block_index": 35,
        "block_type": "p",
        "tag": "p",
        "text": "The 11-Step First Trimester Checklist That’ll Keep You Sane While Growing a Human Medically Reviewed by James Greenberg, M.D.",
        "text_sha256": "5c8b546f7343c1322a0c74c174e39e0c4068a00053f6b71231d4498f783f3518",
        "word_count": 19
      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "p",
        "tag": "p",
        "text": "11 Questions Your OB/GYN Wishes You’d Ask When You Get Pregnant Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "f6b7e3c70aaed31924087beaa18aee90d1e056e949a85140d1bc8a184f2b5902",
        "word_count": 18
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "Week-by-Week Pregnancy Guide for Dads and Partners Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "6cc28b09022601909c8a5d7c4b19c360793c8dde1556d35a4779c2e46f5fb95c",
        "word_count": 14
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
        "tag": "p",
        "text": "7 Things I Wish I Had Known About Finding Out I Was Pregnant Fact Checked by Kathleen Felton, Contributing Writer/Editor",
        "text_sha256": "d39362006798bb0ae7e6f036a0da1ddd894d5ea9b94f79942bdb1d192500cac5",
        "word_count": 20
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000040",
