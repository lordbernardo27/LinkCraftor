  "source_id": "raw_html_8771b06446567efb",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/first-year/feeding-your-baby/milk-allergy-in-infants.aspx",
    "source_record_id": "raw_html_8771b06446567efb",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-feeding-your-baby-milk-allergy-in-infants-aspx_8771b064.html",
