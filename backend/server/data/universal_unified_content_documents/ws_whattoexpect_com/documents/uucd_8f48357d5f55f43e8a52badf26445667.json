  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/pregnancy/week-by-week/week-28.aspx",
    "source_record_id": "raw_html_bacaf224a1811191",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-week-by-week-week-28-aspx_bacaf224.html",
