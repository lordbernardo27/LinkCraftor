    "source_record_id": "raw_html_64fb6d5055482f90",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-complications-thyroid-disorder-aspx_64fb6d50.html",
