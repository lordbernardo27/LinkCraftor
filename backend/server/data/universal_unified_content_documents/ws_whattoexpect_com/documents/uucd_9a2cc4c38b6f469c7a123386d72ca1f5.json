    "source_record_id": "raw_html_3eb92a84226a858c",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-labor-and-delivery-hiring-midwife_3eb92a84.html",
