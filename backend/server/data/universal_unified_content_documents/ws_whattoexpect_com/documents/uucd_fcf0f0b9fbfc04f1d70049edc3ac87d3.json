    "source_record_id": "raw_html_5a1a5d17dc82db49",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-organic-diet_5a1a5d17.html",
