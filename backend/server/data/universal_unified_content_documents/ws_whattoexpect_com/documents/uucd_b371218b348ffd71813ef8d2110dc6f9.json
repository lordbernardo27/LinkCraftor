  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/first-year/breastfeeding/breast-pump-flange-size",
    "source_record_id": "raw_html_a42bcd31057e60be",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-breastfeeding-breast-pump-flange-size_a42bcd31.html",
