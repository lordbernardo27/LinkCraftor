    {
      "block_index": 4,
      "heading_id": "heading_00001",
      "level": 2,
      "text": "What is a forceps delivery?"
    },
    {
      "block_index": 7,
      "heading_id": "heading_00002",
      "level": 2,
      "text": "When and why is a forceps delivery done?"
    },
    {
      "block_index": 15,
      "heading_id": "heading_00003",
      "level": 2,
      "text": "How do doctors deliver a baby using forceps?"
    },
    {
      "block_index": 21,
      "heading_id": "heading_00004",
      "level": 2,
      "text": "Are there any risks to the baby or complications with a forceps delivery?"
    },
    {
      "block_index": 28,
      "heading_id": "heading_00005",
      "level": 2,
      "text": "Are there any downsides or risks to the mother with a forceps delivery?"
    },
    {
      "block_index": 37,
      "heading_id": "heading_00006",
      "level": 2,
      "text": "How often are forceps used during delivery?"
    }
