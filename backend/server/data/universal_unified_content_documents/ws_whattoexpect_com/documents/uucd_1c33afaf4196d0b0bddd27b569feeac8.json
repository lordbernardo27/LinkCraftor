    "source_record_id": "raw_html_c2217bf5038f5dea",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-baby-feeding-when-can-babies-eat-butternut-squash_c2217bf5.html",
