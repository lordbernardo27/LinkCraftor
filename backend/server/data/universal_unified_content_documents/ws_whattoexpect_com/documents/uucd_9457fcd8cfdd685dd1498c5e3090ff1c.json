    "source_record_id": "raw_html_7269621db7bc3807",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-safety-and-childproofing-top-choking-hazards-babies-toddlers_7269621d.html",
