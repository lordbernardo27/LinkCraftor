    "source_record_id": "raw_html_ced526a4c997df9d",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\getting-pregnant-brown-discharge-instead-period_ced526a4.html",
