    "source_record_id": "raw_html_c6a87de626021461",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\baby-growth-umbilical-cord-care-aspx_c6a87de6.html",
