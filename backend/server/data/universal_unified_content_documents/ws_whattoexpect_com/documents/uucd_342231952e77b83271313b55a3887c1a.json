    "source_record_id": "raw_html_40d3a364526aea65",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-loss-termination-of-pregnancy-fetal-maternal-health_40d3a364.html",
