  "structure": {
    "block_count": 18,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Rebecca Amaru",
        "text_sha256": "c356a53d4361ccd189b7f912ece08fc036ecc1d4105bcc9bd4e6eb2248edad20",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Rebecca Amaru, M.D.",
        "text_sha256": "895f0da0f950ed755ccdad6835afde3faf256796d80274939f9c8c50323e0d58",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Rebecca Amaru, M.D.",
        "text_sha256": "afa20937cc225689b083ee883bf0e7ace8b16b6d8a6563df983bfa0ef1ddb1d2",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Rebecca Amaru is a board-certified OB/GYN practicing in New York City.",
        "text_sha256": "75bb9f213ed192fbf22baabcfd8fed2817c04a3a5e8f6b67b471a4524a834cee",
        "word_count": 12
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Amaru completed her OB/GYN residency at Mount Sinai Hospital and received her M.D. from the Mount Sinai School of Medicine, both in New York City.",
        "text_sha256": "a47b3e305b4c989dfc97a1cbe32e21696d0325e5f6d628f42b6ffef3742c7258",
        "word_count": 26
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "She is currently in private practice at Brasner, Blumberg & Amaru in Manhattan.",
        "text_sha256": "9e4435ae5c3baa1fb8e7b4e0da4eb5e1e6184dc7424e5416e907c10a4873dfa0",
        "word_count": 13
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certification",
        "text_sha256": "c3898f54dc45eb740908fba4888cacdc613965ed71dc29f52a44926a33570aae",
        "word_count": 2
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Amaru is board-certified with the American Board of Obstetrics and Gynecology, and is a Fellow of the American College of Obstetricians and Gynecologists.",
        "text_sha256": "18c38b2e5da560b4b4c61b17ee1e8296ee9f4ca19e06c6cc405f159d8dae20f1",
        "word_count": 24
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Amaru is affiliated with Mount Sinai Hospital in New York City.",
        "text_sha256": "556a59d618f0d43fdd8ad2e4d3bb5966d254239b0ca7d89ce095b3de8d41c76b",
        "word_count": 12
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Amaru is an assistant clinical professor in the OB/GYN Department at the Icahn School of Medicine at Mount Sinai. Each year, she serves as preceptor for a group of third-year medical students during their clerkship in OB/GYN, and teaches the first-year medical students how to take a gynecologic history in their \"Art and Science of Medicine\" course.",
        "text_sha256": "1ea37de75316ab7741dcb603b0d80165d6c2a48659e85067b64061b5f9f415c2",
        "word_count": 58
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "Her practice interests include low- and moderate-risk obstetrics, breastfeeding support, adolescent gynecology, sexual and psychosocial health throughout womens' lifespans.",
        "text_sha256": "f8cd37c333f832be6b5fdc03df51b4586e43da40a8677627401cf15209799354",
        "word_count": 19
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Amaru lives with her husband and four daughters in White Plains, New York.",
        "text_sha256": "44b3b8b47024fc0e374e82b3a243cd6b403e0749da71cfdb073ed3c45838f4e8",
        "word_count": 14
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Amaru has been a Castle Connolly Top Doctor since 2017 and was an Exceptional Women in Medicine awardee in 2019 and 2020.",
        "text_sha256": "00a4ff4b894dc44bc6ab66bbefeccd029d86abd4374cc9c1a062c36aeea57710",
        "word_count": 23
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000017",
        "block_index": 17,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
