    },
    {
      "block_index": 46,
      "heading_id": "heading_00014",
      "level": 3,
      "text": "Explain the reasons behind the rules"
    },
    {
      "block_index": 48,
      "heading_id": "heading_00015",
      "level": 3,
      "text": "Don't scold too soon"
    },
    {
      "block_index": 50,
      "heading_id": "heading_00016",
