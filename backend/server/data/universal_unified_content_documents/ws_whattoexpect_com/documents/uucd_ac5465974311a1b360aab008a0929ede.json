    "source_record_id": "raw_html_26a95f049b72751c",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-brown-discharge_26a95f04.html",
