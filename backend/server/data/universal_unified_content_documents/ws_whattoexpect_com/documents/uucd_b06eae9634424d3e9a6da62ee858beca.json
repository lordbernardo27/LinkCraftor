    "canonical_url": "https://www.whattoexpect.com/pregnancy/symptoms-and-solutions/skin-changes.aspx",
    "source_record_id": "raw_html_3bfdf3fabcbb1992",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-symptoms-and-solutions-skin-changes-aspx_3bfdf3fa.html",
