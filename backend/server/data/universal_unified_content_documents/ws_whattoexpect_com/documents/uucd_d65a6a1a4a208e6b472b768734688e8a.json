    "source_record_id": "raw_html_f230bc469e85b284",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-week-by-week-weeks-1-and-2-aspx_f230bc46.html",
