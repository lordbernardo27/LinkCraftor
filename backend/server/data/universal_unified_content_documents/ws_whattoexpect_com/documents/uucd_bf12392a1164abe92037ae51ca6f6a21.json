    "source_record_id": "raw_html_a259a74b027f1a3d",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\toddler-health-ringworm-in-kids_a259a74b.html",
