        "text_sha256": "4e404cc8d552ad384ddb2d0ca3766294d6bde7a223c4054f70052fb5cd226982",
        "word_count": 359
      },
      {
        "block_id": "block_000092",
        "block_index": 92,
        "block_type": "heading",
        "tag": "h2",
        "text": "Updates history",
        "text_sha256": "8ce5f24a37ab68e01743f0cb3f0234dd767a31a441e3e3be35047619722ffec6",
        "word_count": 2
      },
      {
        "block_id": "block_000093",
        "block_index": 93,
        "block_type": "p",
        "tag": "p",
        "text": "October 27, 2025",
        "text_sha256": "3238c440cb1007f0ce9ff97f72f2679fdcbd1387b4a53c863f5da0fc05594d8b",
        "word_count": 3
      },
      {
        "block_id": "block_000094",
        "block_index": 94,
        "block_type": "p",
        "tag": "p",
        "text": "Editors: Marygrace Taylor/Catherine Donaldson-Evans",
        "text_sha256": "ca409fbde745f90d31c9a66881a93ff06d8aa80f5779ebaa4484678065854f5e",
        "word_count": 4
      },
