  "source_id": "raw_html_ee44d32f6ea924a2",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/toddler/health-and-safety/when-your-childs-cut-wont-stop-bleeding.aspx",
    "source_record_id": "raw_html_ee44d32f6ea924a2",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\toddler-health-and-safety-when-your-childs-cut-wont-stop-bleeding-aspx_ee44d32f.html",
