  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/baby-products/maternity/best-postpartum-belly-bands-corsets-girdles-help-recover-after-giving-birth/",
    "source_record_id": "raw_html_60483d27716bce49",
