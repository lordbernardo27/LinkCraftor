  "structure": {
    "block_count": 19,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Tarun Jain",
        "text_sha256": "8aa740fc37eb421e19902ac0dd320716dbd62c4d4ae610deefdfc693aaf6acb3",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Tarun Jain, M.D.",
        "text_sha256": "76690927e6230d3a6d7900c8546110f4639b3c96d400ecb17ab034722d191a41",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Tarun Jain, M.D.",
        "text_sha256": "ef3de4f3ff0877ca5e3681ac34b9504087cba7d313f285148116a9e2838f8f46",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Tarun Jain is a board-certified reproductive endocrinology and infertility (REI) physician and serves as the ambulatory medical director of Northwestern Fertility and Reproductive Medicine in Oak Brook, Illinois.",
        "text_sha256": "414f8307ee3f4501c99c95f8d93ce424d972418898b656e6ac51e6f038ffc023",
        "word_count": 29
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Jain did his fellowship at Brigham & Women's Hospital, Harvard Medical School, in Boston, Massachusetts, and his residency at the University of Washington in Seattle, Washington.",
        "text_sha256": "cc82337069a478ee1051dbb6dd4ad6338baeafb325780e66f3c0c3ce898bd038",
        "word_count": 27
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "He has Bachelor of Science degrees in biomedical and electrical engineering from the University of Southern California (USC), as well as a Master of Science in biomedical engineering from the University of Texas at Austin and an M.D. with Highest Distinction from the USC Keck School of Medicine.",
        "text_sha256": "c0044c4d3b85626e8be859dfe8e3c9afd519e57b2e4964ec7efe24dd6a9f4385",
        "word_count": 48
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certifications",
        "text_sha256": "b6ebfd0050d34a00e27b7a07eb958e6520d9d8c003bea281b96762ad17883d6b",
        "word_count": 2
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Jain is board-certified by the American Board of Obstetrics and Gynecology.",
        "text_sha256": "c3e1324c75f1ac00d5b470966ae1e9e634232c0fbbb7f498cd509d32f3a0c383",
        "word_count": 12
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Jain is affiliated with Northwestern Memorial Hospital in Chicago, Illinois, and Central DuPage Hospital in Winfield, Illinois.",
        "text_sha256": "a76fb278a5392b401b15f1051ab661279aa1f1be340e5f92dd6585264f9b0b46",
        "word_count": 18
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Jain is a professor of Obstetrics and Gynecology at Northwestern University Feinberg School of Medicine.",
        "text_sha256": "e853232261b6e6494a219c5c2480f7281ea4ddcae28c4075f7981f7a0973bc1a",
        "word_count": 16
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "heading",
        "tag": "h2",
        "text": "Publications and research",
        "text_sha256": "43d25db753fa567e93d8e6115d224c40fbbc46686c8a8215a91aeeeb3eb5f790",
        "word_count": 3
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Jain is the author of the book The Infertility Journey: Real voices. Real issues. Real insights, as well as authoring and contributing to numerous other academic articles and publications on infertility, fertility treatments and related subjects.",
        "text_sha256": "b19bfeac17de860d79254f1bb42705c5b066fd0b1ebe4ab8fc8c328d44b8f345",
        "word_count": 37
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Jain has been a Castle Connolly Top Doctor from 2018 to the present.",
        "text_sha256": "985d7c81f8d190569d65d90c1891aee0d7b8149d409848b28bb7b42e829150cb",
        "word_count": 14
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "p",
        "tag": "p",
        "text": "He's a past recipient of the American Medical Association (AMA)'s National Leadership Award, has been named to the Best Doctors in America list, has received the Top Reproductive Endocrinologist in the Nation award, and was recently honored with the ASRM Service Milestone Award for 15 years of service on American Society for Reproductive Medicine boards and committees.",
        "text_sha256": "cf8ec653d31ef6f4c9ad0dda4910b9d080a76b7a3f745fa8e86eb8275ef58f9f",
        "word_count": 57
      },
      {
        "block_id": "block_000017",
        "block_index": 17,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000018",
        "block_index": 18,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
