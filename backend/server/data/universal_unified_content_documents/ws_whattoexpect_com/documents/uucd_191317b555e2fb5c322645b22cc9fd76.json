      "level": 1,
      "text": "How to Share Your Baby News With Grandparents-to-Be"
    },
    {
      "block_index": 6,
      "heading_id": "heading_00001",
      "level": 2,
      "text": "Key-Takeaways"
    },
    {
      "block_index": 10,
      "heading_id": "heading_00002",
      "level": 2,
      "text": "How should you tell your parents that you're pregnant?"
    },
    {
      "block_index": 14,
      "heading_id": "heading_00003",
      "level": 2,
      "text": "What are some cute pregnancy announcements for grandparents?"
    },
    {
      "block_index": 16,
      "heading_id": "heading_00004",
      "level": 3,
      "text": "1. Win grandparents over with a onesie"
    },
    {
      "block_index": 19,
      "heading_id": "heading_00005",
      "level": 3,
      "text": "2. Snap a sibling photo"
    },
    {
      "block_index": 23,
      "heading_id": "heading_00006",
      "level": 3,
      "text": "3. Gift baby essentials"
    },
    {
      "block_index": 26,
      "heading_id": "heading_00007",
      "level": 3,
      "text": "4. Say it with sweets"
    },
    {
      "block_index": 29,
      "heading_id": "heading_00008",
      "level": 3,
      "text": "5. Make them a winner"
    },
    {
      "block_index": 32,
      "heading_id": "heading_00009",
      "level": 3,
      "text": "6. Let your baby-to-be help tell your parents you're pregnant"
    },
    {
      "block_index": 35,
      "heading_id": "heading_00010",
      "level": 3,
      "text": "7. Put a fork in it"
    },
    {
      "block_index": 38,
      "heading_id": "heading_00011",
      "level": 3,
      "text": "8. Add to their photo collection"
    },
    {
      "block_index": 41,
      "heading_id": "heading_00012",
      "level": 3,
      "text": "9. Replace their old coffee mugs"
    },
    {
      "block_index": 44,
      "heading_id": "heading_00013",
      "level": 3,
      "text": "10. Recruit the dog"
    },
    {
      "block_index": 46,
      "heading_id": "heading_00014",
      "level": 3,
      "text": "11. Make them a countdown clock"
    },
    {
      "block_index": 49,
      "heading_id": "heading_00015",
      "level": 3,
      "text": "12. Let them read between the lines"
    },
    {
      "block_index": 52,
      "heading_id": "heading_00016",
      "level": 3,
      "text": "13. Write a personalized note"
    },
    {
      "block_index": 55,
      "heading_id": "heading_00017",
      "level": 3,
      "text": "14. Seek a second opinion"
    },
    {
      "block_index": 58,
      "heading_id": "heading_00018",
      "level": 3,
      "text": "15. Show them what they're made of"
    },
    {
      "block_index": 61,
      "heading_id": "heading_00019",
      "level": 3,
      "text": "16. Create a sign"
    },
    {
      "block_index": 64,
      "heading_id": "heading_00020",
      "level": 3,
      "text": "17. Say it with special artwork"
    },
    {
      "block_index": 67,
      "heading_id": "heading_00021",
      "level": 3,
      "text": "18. Make a toast"
    },
    {
      "block_index": 70,
      "heading_id": "heading_00022",
      "level": 3,
      "text": "19. Break out the message board"
    },
    {
      "block_index": 73,
      "heading_id": "heading_00023",
      "level": 3,
      "text": "20. Help decorate their Christmas tree"
    },
    {
      "block_index": 76,
      "heading_id": "heading_00024",
      "level": 2,
      "text": "Updates history"
    },
    {
      "block_index": 80,
      "heading_id": "heading_00025",
      "level": 2,
      "text": "Jump to Your Week of Pregnancy"
    },
    {
