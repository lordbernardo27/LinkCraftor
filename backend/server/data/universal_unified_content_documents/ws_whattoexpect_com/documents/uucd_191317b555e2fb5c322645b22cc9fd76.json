      },
      {
        "block_id": "block_000089",
        "block_index": 89,
        "block_type": "p",
        "tag": "p",
        "text": "10 Funny Pregnancy Announcements That Are Sure to Amuse Fact Checked by Olivia DeLong, Senior Health Editor",
        "text_sha256": "7e1f23aa5bc5d09d1b8314207e6b577f4eb197807b957603fbda00e560429c4c",
        "word_count": 17
      },
      {
        "block_id": "block_000090",
        "block_index": 90,
        "block_type": "p",
        "tag": "p",
        "text": "12 Dog Pregnancy Announcements for Human Parents-to-Be Fact Checked by Olivia DeLong, Senior Health Editor",
        "text_sha256": "4b68c1624af5993ac9ad9c1611ad6fe792e03dc364721ab5f53defcd98d6c480",
        "word_count": 15
      },
      {
        "block_id": "block_000091",
        "block_index": 91,
        "block_type": "p",
