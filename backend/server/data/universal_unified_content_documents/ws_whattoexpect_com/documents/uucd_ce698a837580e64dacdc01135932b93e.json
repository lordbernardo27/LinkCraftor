        "text_sha256": "21e3e470f04c502ad695609cb08aff25114f5197a17f9f7dee4cb01c0cd66482",
        "word_count": 18
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "p",
        "tag": "p",
        "text": "How to Clean Baby Clothes By Maria Masters, Contributing Writer/Editor",
        "text_sha256": "1b1690b7f03588d368413cca27439cd835c14903d53bee46ebab3d31a747f06a",
        "word_count": 10
      },
      {
        "block_id": "block_000040",
        "block_index": 40,
        "block_type": "p",
        "tag": "p",
        "text": "When to Buy and Start Wearing Maternity Clothes Medically Reviewed by Shannon Smith, M.D.",
        "text_sha256": "7b11ab727852de78cfeedd9e25a9cb01a343c7bd13573d432c7ae284052b6731",
        "word_count": 14
      },
      {
        "block_id": "block_000041",
        "block_index": 41,
