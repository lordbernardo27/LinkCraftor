    "source_record_id": "raw_html_95c957948218b4e4",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\family-celebrations-november-birthdays_95c95794.html",
