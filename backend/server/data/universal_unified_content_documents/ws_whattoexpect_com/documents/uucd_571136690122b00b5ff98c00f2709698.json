        "text_sha256": "6d2b65f6bc74d3f3d5656d8c88c806ff70605a0ce9d4fd990efe9af093220755",
        "word_count": 3
      },
      {
        "block_id": "block_000034",
        "block_index": 34,
        "block_type": "p",
        "tag": "p",
        "text": "How to Spot Fake Baby Products Medically Reviewed by Suzanne Chan, D.N.P., C.L.C., C.P.S.T.",
        "text_sha256": "c24665be010f8a3baacb0d9fb54d5aafb0a8f37ab09181c7338fb3febc107d35",
        "word_count": 14
      },
      {
