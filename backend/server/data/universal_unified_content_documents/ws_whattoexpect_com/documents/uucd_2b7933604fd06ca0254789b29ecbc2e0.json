    "source_record_id": "raw_html_0f8f2ac37b7bb708",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-symptoms-and-solutions-symphysis-pubis-dysfunction_0f8f2ac3.html",
