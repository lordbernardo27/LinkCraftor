  "source_id": "raw_html_99845426a4bad618",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/toddler/childhood-injuries/treating-spider-bites.aspx",
    "source_record_id": "raw_html_99845426a4bad618",
