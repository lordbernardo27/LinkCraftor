        "text_sha256": "b9b3b15d5bc60fae787d04204d25c87dcc4edd8d7b546362de1dc4207ecfbfb7",
        "word_count": 4
      },
      {
        "block_id": "block_000034",
        "block_index": 34,
        "block_type": "li",
        "tag": "li",
        "text": "Friend or Foe?",
        "text_sha256": "5c0114b40fc019dbdbdbfa4b991f5d5212778ffabf17f9390fb81e1bdb5361ab",
        "word_count": 3
      },
      {
        "block_id": "block_000035",
