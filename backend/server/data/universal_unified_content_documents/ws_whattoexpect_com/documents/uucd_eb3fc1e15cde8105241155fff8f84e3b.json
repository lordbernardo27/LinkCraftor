        "block_type": "li",
        "tag": "li",
        "text": "Show in the article",
        "text_sha256": "b9b3b15d5bc60fae787d04204d25c87dcc4edd8d7b546362de1dc4207ecfbfb7",
        "word_count": 4
      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "li",
        "tag": "li",
        "text": "How to Help Your Toddler Make Friends",
        "text_sha256": "9cf5afbf8471e50714e1c66e406f8e6e9c6a2d35dcd8a30723a03800d08d4df8",
        "word_count": 7
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "li",
        "tag": "li",
        "text": "7 Ways to Discipline Your Toddler,",
        "text_sha256": "649a4a05c280be590f1e2cdc17fd4e3b1c6b36db342fb6e7abf13f8a18a9bc99",
        "word_count": 6
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "li",
        "tag": "li",
        "text": "Talking to a Teacher About Problems in Preschool",
        "text_sha256": "dacdc62155175eaf48c0505e270c2172b2f7ee74e38c118cc53fdff530071bfc",
        "word_count": 8
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "li",
        "tag": "li",
        "text": "Social Development in Preschoolers",
        "text_sha256": "c5a24602ac366d4f4fc2277bb22993f69def1ec6069aa97bfa362e7405df5084",
        "word_count": 4
      },
      {
        "block_id": "block_000040",
        "block_index": 40,
        "block_type": "li",
        "tag": "li",
        "text": "Milestones During the First 2 Years",
        "text_sha256": "cccc9e2767b8ac2cd2995e193ac07504c95ca1e8506391e3faf03368ca26a0f6",
        "word_count": 6
      },
      {
        "block_id": "block_000041",
        "block_index": 41,
        "block_type": "li",
