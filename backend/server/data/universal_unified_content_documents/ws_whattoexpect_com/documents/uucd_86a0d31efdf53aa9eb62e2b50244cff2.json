      "text": "3. Eat a healthy pregnancy diet"
    },
    {
      "block_index": 38,
      "heading_id": "heading_00008",
      "level": 3,
      "text": "4. Stay stocked"
    },
    {
      "block_index": 41,
      "heading_id": "heading_00009",
      "level": 3,
      "text": "5. Don't create forbidden fruit"
    },
    {
      "block_index": 44,
      "heading_id": "heading_00010",
