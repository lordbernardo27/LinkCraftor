    "source_record_id": "raw_html_cf77c4274fb41227",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-labor-and-delivery-cervidil-induction_cf77c427.html",
