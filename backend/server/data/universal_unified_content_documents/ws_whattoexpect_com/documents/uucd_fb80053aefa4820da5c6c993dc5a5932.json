    "source_record_id": "raw_html_1df798b7617c7f5e",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\toddler-ask-heidi-pinkeye-aspx_1df798b7.html",
    "udare_article_sha256": "4e40da156fac2e7472459b61e41a2f415f1d2c90b44f54bc812e34e83c665d9a"
  },
  "source_name": "https://www.whattoexpect.com/toddler/ask-heidi/pinkeye.aspx",
