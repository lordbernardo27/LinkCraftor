  "structure": {
    "block_count": 25,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Allison Bloom",
        "text_sha256": "e3e0fe3517497fa845036ae28bd399e037e6a9f7badc8e898da69d3c2d7a4b50",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Allison Bloom, D.O., M.P.H.",
        "text_sha256": "d5b9807330d94da9d8d94ef4654a37c2365a6571863be6d967db0ad6bb517342",
        "word_count": 4
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Allison Bloom, D.O., M.P.H.",
        "text_sha256": "a01fcf304296923fb6ccfd3c891a8afa3b1f36e4c7e0ac2e0d6f56b56e626089",
        "word_count": 5
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Allison Bloom is a board-certified OB/GYN and board-eligible reproductive endocrinology and infertility specialist practicing at Main Line Fertility in Philadelphia, Pennsylvania.",
        "text_sha256": "bf0366cdacb66dd7549a260f83d4397d496e7932b107c1cbf83af3c8ce7d8779",
        "word_count": 22
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Bloom graduated from the University of Massachusetts with a Bachelor of Science before earning her Doctor of Osteopathic Medicine (D.O.) and Masters in Public Health (M.P.H.) from Nova Southeastern University College of Osteopathic Medicine in Fort Lauderdale, Florida.",
        "text_sha256": "e51d9d26f420b81c02c5de32bbde8ce23c1a1bf4718009a6031e5da7a76e8a2f",
        "word_count": 39
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "She then completed her residency in Obstetrics and Gynecology at Drexel University College of Medicine/Hahnemann University Hospital in Philadelphia as well as a fellowship in Reproductive Endocrinology and Infertility with Main Line Fertility/Drexel University College of Medicine.",
        "text_sha256": "e737b8a97a34725d530adf7dbbdc445f403de085ed090a1ab7ceb521f516a7c1",
        "word_count": 37
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certifications",
        "text_sha256": "b6ebfd0050d34a00e27b7a07eb958e6520d9d8c003bea281b96762ad17883d6b",
        "word_count": 2
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Bloom is board-certified by the American College of Obstetrics and Gynecology.",
        "text_sha256": "bc2c06bff155befbe98242ddadd2714ba98198c3618bf019a897bffe2d026123",
        "word_count": 12
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Bloom is affiliated with Lankenau Medical Center, Bryn Mawr Hospital, Paoli Hospital and Chester County Hospital.",
        "text_sha256": "e522795a76ffb778bdd9390c7b6a83a2ca321109552d3b32329dad7be767e051",
        "word_count": 17
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Bloom is a member of the clinical faculty at Lankenau Hospital and a board member of the Philadelphia Area Reproductive Endocrine Society.",
        "text_sha256": "32c9cda9fed70e6a922c66df8ab7541fa4f68efc5c02d04637ca4975bf0afb65",
        "word_count": 23
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Bloom is also affiliated with the American Society for Reproductive Medicine (ASRM), Gay and Lesbian Medical Association, American Osteopathic Board of Obstetrics and Gynecology (AOBOG), American Osteopathic Association (AOA) and American Medical Association (AMA).",
        "text_sha256": "25a84639834f6db1587280da1111ea0f07cce9859e021e6f1e64329f6cd6312d",
        "word_count": 35
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Bloom has received a number of awards, including:",
        "text_sha256": "fa712b28908196fe22640d990be16034dd99a26818aab38376469be3e53d2519",
        "word_count": 9
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "li",
        "tag": "li",
        "text": "Health Care Hero Award, Penn Medicine",
        "text_sha256": "2bcc111b1b6fea2286ae8d1b6204d80e69cc81241c5c78b94b75670ffd2ee81e",
        "word_count": 6
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "li",
        "tag": "li",
        "text": "Seymour Stein Memorial Resident/Fellow Annual Research Award, three-time recipient",
        "text_sha256": "c8852f25de49c3c98d4150a5816812622a390ab88208226ef09c3cb059385aa0",
        "word_count": 9
      },
      {
        "block_id": "block_000017",
        "block_index": 17,
        "block_type": "li",
        "tag": "li",
        "text": "Educational Chief Resident, Obstetrics and Gynecology, Drexel University College of Medicine",
        "text_sha256": "ff0480d5f3e90e2a597c5c98329242dc381a7ec7d9c9b7774d31acd11dece190",
        "word_count": 11
      },
      {
        "block_id": "block_000018",
        "block_index": 18,
        "block_type": "li",
        "tag": "li",
        "text": "Medical Student Teaching Award Recipient, Drexel University College of Medicine, two-time recipient",
        "text_sha256": "ca9ba6762e373e946bd072f4aabbec0d1ceeb3d3ff127b21e106f7eb178a56f6",
        "word_count": 12
      },
      {
        "block_id": "block_000019",
        "block_index": 19,
        "block_type": "li",
        "tag": "li",
        "text": "Resident CREOG Exam Achievement Award, four-time recipient",
        "text_sha256": "83ebb1cb06660dc81087c4eb5ceac3e4f9f63f64e180a1653438c7a6cb638797",
        "word_count": 7
      },
      {
        "block_id": "block_000020",
        "block_index": 20,
        "block_type": "li",
        "tag": "li",
        "text": "Phi Sigma Alpha, National Osteopathic Scholastic Society inductee",
        "text_sha256": "1346129a67410b225d8f65d6acf7368d110336289607bb9dfd1f79fb3f8611d4",
        "word_count": 8
      },
      {
        "block_id": "block_000021",
        "block_index": 21,
        "block_type": "li",
        "tag": "li",
        "text": "Sigma Sigma Phi, National Honorary Service Fraternity, President",
        "text_sha256": "9c7679151372f934612a9ea4e3cc0a1e0c5a1b743c64a989926a0fdbbebfabb7",
        "word_count": 8
      },
      {
        "block_id": "block_000022",
        "block_index": 22,
        "block_type": "li",
        "tag": "li",
        "text": "Matthew Terry Scholarship recipient for scholastic excellence, service, empathy and congeniality",
        "text_sha256": "b6c7528a3d26f644b5f16be0559904c6bfa8b9857a690c0ab38eb2ceaaebf795",
        "word_count": 11
      },
      {
        "block_id": "block_000023",
        "block_index": 23,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
