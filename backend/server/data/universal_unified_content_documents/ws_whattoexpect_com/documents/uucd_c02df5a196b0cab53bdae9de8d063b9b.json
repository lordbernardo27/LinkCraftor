        "block_type": "li",
        "tag": "li",
        "text": "West Nile Virus",
        "text_sha256": "498872377eff6b3403b3fe1522ee63d53bc7a57e0d546d3016790204ed6d7b57",
        "word_count": 3
      },
      {
