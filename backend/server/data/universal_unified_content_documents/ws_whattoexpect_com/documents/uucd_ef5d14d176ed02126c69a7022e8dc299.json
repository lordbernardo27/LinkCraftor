        "text_sha256": "8d60bdafd1c84f331c768a5a837e17eece4627b0142e349d8d28ece5e22fb1ab",
        "word_count": 16
      },
      {
        "block_id": "block_000040",
        "block_index": 40,
        "block_type": "p",
        "tag": "p",
        "text": "From Sushi to Soft Cheese: What’s Off Limits During Pregnancy and Why Medically Reviewed by Alexandra Paetow, M.S., R.D.N.",
        "text_sha256": "914a81efb48b6f5f9d99ff1f6f4883ca20235bc4b92aee9d3a9ea2ca200d5518",
        "word_count": 19
      },
      {
        "block_id": "block_000041",
        "block_index": 41,
        "block_type": "p",
