    "source_record_id": "raw_html_f6963713b802e475",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-baby-care-baby-skin-care-mongolian-spots-aspx_f6963713.html",
