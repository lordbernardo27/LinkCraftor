  "headings": [
    {
      "block_index": 0,
      "heading_id": "heading_00000",
      "level": 1,
      "text": "9 Times When Pregnancy \"Gets Real\""
    },
    {
      "block_index": 6,
      "heading_id": "heading_00001",
      "level": 2,
      "text": "Key Takeaways"
    },
    {
      "block_index": 10,
      "heading_id": "heading_00002",
      "level": 2,
      "text": "1. When your family and friends start noticing how \"big\" you are"
    },
    {
      "block_index": 13,
      "heading_id": "heading_00003",
      "level": 2,
      "text": "2. When you have a visceral reaction at the sight of a tiny onesie or a super small diaper"
    },
    {
      "block_index": 15,
      "heading_id": "heading_00004",
      "level": 2,
      "text": "3. When you tell people your news"
    },
    {
      "block_index": 17,
      "heading_id": "heading_00005",
      "level": 2,
      "text": "4. When you buy your first maternity outfit"
    },
    {
      "block_index": 20,
      "heading_id": "heading_00006",
      "level": 2,
      "text": "5. When you can’t sleep on your tummy anymore"
    },
    {
      "block_index": 23,
      "heading_id": "heading_00007",
      "level": 2,
      "text": "6. When shaving your legs becomes an undertaking (legs? what legs?)"
    },
    {
      "block_index": 26,
      "heading_id": "heading_00008",
      "level": 2,
      "text": "7. When you get winded walking up the stairs"
    },
    {
      "block_index": 29,
      "heading_id": "heading_00009",
      "level": 2,
      "text": "8. When a stranger or someone you don’t know well notices you're pregnant — and comments on it"
    },
    {
      "block_index": 32,
      "heading_id": "heading_00010",
      "level": 2,
      "text": "9. When baby gear starts filling up your apartment or house."
    },
    {
      "block_index": 37,
      "heading_id": "heading_00011",
      "level": 2,
      "text": "Updates history"
    },
    {
      "block_index": 41,
      "heading_id": "heading_00012",
      "level": 2,
      "text": "Jump to Your Week of Pregnancy"
    },
    {
      "block_index": 42,
      "heading_id": "heading_00013",
      "level": 2,
      "text": "Your Next Read"
    },
    {
      "block_index": 59,
      "heading_id": "heading_00014",
      "level": 2,
      "text": "Opens a new window"
    }
  ],
