    "source_record_id": "raw_html_07557a229342408c",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-loss-threatened-miscarriage_07557a22.html",
