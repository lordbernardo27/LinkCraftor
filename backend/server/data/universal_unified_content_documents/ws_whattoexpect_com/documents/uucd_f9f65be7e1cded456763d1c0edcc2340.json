    "source_record_id": "raw_html_b7c6d1cfd469797e",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-postpartum-health-and-care-postpartum-backache-back-pain_b7c6d1cf.html",
