    "source_record_id": "raw_html_bb716545776d03fd",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-week-by-week-week-23-aspx_bb716545.html",
