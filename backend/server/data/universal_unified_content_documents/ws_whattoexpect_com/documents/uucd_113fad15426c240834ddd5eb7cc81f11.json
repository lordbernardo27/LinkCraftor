    "source_record_id": "raw_html_065506f9f96f2dae",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-ask-heidi-two-vessel-cord-aspx_065506f9.html",
