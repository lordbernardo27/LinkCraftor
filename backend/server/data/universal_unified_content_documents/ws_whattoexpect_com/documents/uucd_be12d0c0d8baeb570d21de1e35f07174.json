    "source_record_id": "raw_html_57ba5a26db6ee4b5",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-weight-gain-calculator_57ba5a26.html",
