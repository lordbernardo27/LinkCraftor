  "structure": {
    "block_count": 16,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Gina Posner",
        "text_sha256": "41c76c942d6241064c9f94413af7e301badd5ea4a433fd21d594585cc7894b1f",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Gina Posner, M.D., F.A.A.P.",
        "text_sha256": "bcafcb1857c865cc1e05226f6fd2ca856eced42f23a57770485732267800faf7",
        "word_count": 4
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Gina Posner, M.D., F.A.A.P.",
        "text_sha256": "59cbf7b72931238037c5c81bac7f94207f38bd0bb720c4c75b41cf355d753575",
        "word_count": 5
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Gina Posner is a board-certified pediatrician practicing at MemorialCare Medical Group in Fountain Valley, California.",
        "text_sha256": "7d4d53937030f2a9a3e769088eb2a7493d7edfd2047fabdfd0e737eef6aabfc4",
        "word_count": 16
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Posner completed her residency at White Memorial Medical Center in Los Angeles — where she was chief resident — and she received her M.D. from New York Medical College in Valhalla, New York. She previously graduated from Brandeis University in Waltham, Massachusetts, with a degree in International Health and the Environment.",
        "text_sha256": "bdd557801b8a7f2cde3d020fe413dbff6b4fdc6cb0f96fc47b56031831fbdb45",
        "word_count": 52
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certification",
        "text_sha256": "c3898f54dc45eb740908fba4888cacdc613965ed71dc29f52a44926a33570aae",
        "word_count": 2
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Posner has been board-certified with the American Board of Pediatrics since 2006, and is a Fellow of the American Academy of Pediatrics.",
        "text_sha256": "b332eac828f9adc01c8156002b41c793b4d87cb2da54ef2751beaf39019e5d9e",
        "word_count": 23
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Posner is affiliated with Orange Coast Memorial Medical Center in Fountain Valley, California.",
        "text_sha256": "f3d2ebd366de9a715429a1078e7b8cd6ce66376cf721b667d569263f2e03ff73",
        "word_count": 14
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Posner serves as the Assistant Chair of Pediatrics at Orange Coast Memorial Medical Center. She is bilingual in Spanish and English.",
        "text_sha256": "62bbc64a2bb1a8bd29e314c0668ada1bded586fa5ee866bd707bf42e240d0696",
        "word_count": 22
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Posner is the mother of two daughters.",
        "text_sha256": "2e013ae2dd88bf1e643e28f37c6de68bface1ca5d7edf89b8d5c06e25edd22a9",
        "word_count": 8
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Posner received the National Health Service Corps Scholarship, providing health services in an underserved area after completing her residency. She provided medical care at Clinica Sierra Vista in Lamont, California, during her time in the National Health Service Corps program.",
        "text_sha256": "a17459551f804b6e60b6cb5d6dd6e40ac25f1179b5c2388387abc60c3f23eb0a",
        "word_count": 41
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
