        "text_sha256": "116aace6d95d2bfafc120ebc10e3c97aaac3059103b86362d4d1a9f00d690931",
        "word_count": 19
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "When Will My Baby Sleep Through the Night? Here's the Scoop Medically Reviewed by Lauren Crosby, M.D., F.A.A.P.",
        "text_sha256": "fc8f0e5c2dbffe0cc13ac50886367aa46700847460abc5cefaaf325b549b756a",
        "word_count": 18
      },
      {
