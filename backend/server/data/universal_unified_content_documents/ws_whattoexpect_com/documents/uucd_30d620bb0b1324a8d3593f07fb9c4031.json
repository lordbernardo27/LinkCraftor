        "text_sha256": "00d54d366f22bc3899552e62179b5a65184a49facb8c28a738d51f9791b233f1",
        "word_count": 6
      },
      {
        "block_id": "block_000046",
        "block_index": 46,
        "block_type": "li",
        "tag": "li",
        "text": "10:00 P.M.: Mom pumps (and returns to bed after pumping) while the non-birthing parent gives baby a bottle of previously pumped milk",
        "text_sha256": "0ef71868129e2fbb1541efeae54611acb3ed3a27ddba496c7545ee7dd47fea4a",
        "word_count": 22
      },
