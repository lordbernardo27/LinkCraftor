        "block_type": "li",
        "tag": "li",
        "text": "8:00 P.M.: Mom goes to bed",
        "text_sha256": "4745384d31f4666af8dae4419177e044f2f9d35adc10d83cd94915777b77d3cb",
        "word_count": 6
      },
      {
        "block_id": "block_000059",
        "block_index": 59,
        "block_type": "li",
        "tag": "li",
        "text": "10:00 P.M.: Mom breastfeeds baby",
        "text_sha256": "5da9924eb58e1fc5b905ca36ad907455ba4d2518196fa6d6821937b40e07efdf",
        "word_count": 5
      },
      {
        "block_id": "block_000060",
        "block_index": 60,
        "block_type": "li",
        "tag": "li",
        "text": "10:30 P.M.: Mom goes back to bed, non-birthing parent handles diaper changes and burping",
        "text_sha256": "568741decef2523f90f0c2ce6d1b15fc88c1c591ce3fe90d4913f632c21858c9",
