        "block_type": "li",
        "tag": "li",
        "text": "2:00 A.M.: Mom goes to bed",
        "text_sha256": "4979ac6d1c2015c33ea1b25af4b7a57015e2b287f25618138c99951bb9855b29",
        "word_count": 6
      },
      {
        "block_id": "block_000038",
