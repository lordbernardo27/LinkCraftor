    "source_record_id": "raw_html_a6e585ea4a838d8e",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-winter-maternity-photos_a6e585ea.html",
