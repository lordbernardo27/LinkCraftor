  "source_id": "raw_html_9d29b2556c51c1ee",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/childrens-health-and-safety/diarrhea-in-toddlers-and-babies.aspx",
    "source_record_id": "raw_html_9d29b2556c51c1ee",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\childrens-health-and-safety-diarrhea-in-toddlers-and-babies-aspx_9d29b255.html",
