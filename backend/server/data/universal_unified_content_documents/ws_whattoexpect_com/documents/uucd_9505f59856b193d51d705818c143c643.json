      "text": "Diarrhea in Babies and Toddlers"
    },
    {
      "block_index": 7,
      "heading_id": "heading_00001",
      "level": 2,
      "text": "What causes diarrhea in babies and toddlers?"
    },
    {
      "block_index": 9,
      "heading_id": "heading_00002",
      "level": 3,
      "text": "Viral infections"
    },
    {
      "block_index": 13,
      "heading_id": "heading_00003",
      "level": 3,
      "text": "Antibiotic use"
    },
    {
      "block_index": 15,
      "heading_id": "heading_00004",
      "level": 3,
      "text": "Bacterial infections"
    },
    {
      "block_index": 17,
      "heading_id": "heading_00005",
      "level": 3,
      "text": "Dietary changes"
    },
    {
      "block_index": 19,
      "heading_id": "heading_00006",
      "level": 3,
      "text": "Too much juice"
    },
    {
      "block_index": 23,
      "heading_id": "heading_00007",
      "level": 3,
      "text": "Food allergies"
    },
    {
      "block_index": 25,
      "heading_id": "heading_00008",
      "level": 3,
      "text": "Teething"
    },
    {
      "block_index": 27,
      "heading_id": "heading_00009",
      "level": 2,
      "text": "What does diarrhea in babies and toddlers look like?"
    },
    {
      "block_index": 31,
      "heading_id": "heading_00010",
      "level": 2,
      "text": "Baby diarrhea effects"
    },
    {
      "block_index": 35,
      "heading_id": "heading_00011",
      "level": 2,
      "text": "How do you treat diarrhea in babies and toddlers?"
    },
    {
      "block_index": 38,
      "heading_id": "heading_00012",
      "level": 3,
      "text": "Offer liquids with electrolytes"
    },
    {
      "block_index": 42,
      "heading_id": "heading_00013",
      "level": 3,
      "text": "Keep breastfeeding or offering formula for babies"
    },
    {
      "block_index": 45,
      "heading_id": "heading_00014",
      "level": 3,
      "text": "Stick with bland foods in smaller, more frequent portions"
    },
    {
      "block_index": 50,
      "heading_id": "heading_00015",
      "level": 3,
      "text": "Avoid foods that might make the diarrhea worse"
    },
    {
      "block_index": 52,
      "heading_id": "heading_00016",
      "level": 3,
      "text": "Watch for diaper rash"
    },
    {
      "block_index": 55,
      "heading_id": "heading_00017",
      "level": 3,
      "text": "Don’t give anti-diarrhea meds"
    },
    {
      "block_index": 57,
      "heading_id": "heading_00018",
      "level": 2,
      "text": "When should you take your child to the doctor for diarrhea?"
    }
  ],
