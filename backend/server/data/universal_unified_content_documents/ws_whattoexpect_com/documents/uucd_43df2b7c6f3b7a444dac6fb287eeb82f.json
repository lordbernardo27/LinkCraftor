      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "heading",
        "tag": "h1",
        "text": "Hearing First",
        "text_sha256": "5b72c0f5f4cddb8dd434c025b6cf60de3d175b26f5ab0e1baa5161a72627e37d",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Hearing First",
        "text_sha256": "98d721ea667ebbe41f4b69429610ad31a0acfc86ce90622ae3415b4023d394c1",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "p",
        "tag": "p",
        "text": "Hearing First is a subsidiary organization of the Oberkotter Foundation, a private foundation with a 37-year history supporting listening and spoken language (LSL) opportunities for children who are deaf or hard of hearing.",
        "text_sha256": "ec688518b387e789e6ce8430882d824b9d15d70c8ad085c013fd4a45ff31460a",
        "word_count": 33
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Working with a multidisciplinary team of pediatric audiologists, otologists, pediatricians, speech-language pathologists, and teachers of the deaf, Hearing First supports families and professionals to help children with hearing loss. Its mission is to ensure that children who are deaf or hard of hearing have opportunities to reach their full potential.",
        "text_sha256": "bb9c9508804627617dcfddafacbfe6aed148fff5dec2f552d03f0722eebfda1e",
        "word_count": 50
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Hearing First uses its years of experience and expertise to connect professionals and communities with the latest evidence-based information. It makes all of its resources and learning experiences available to the public at no cost.",
        "text_sha256": "8da8b3f5073019d6fec2b6019b274b7b286710107e264e61958559baf7690006",
        "word_count": 35
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "Learn more about Hearing First and its work supporting children who are deaf or hard of hearing at hearingfirst.org .",
        "text_sha256": "2bafda111dfcfedb684a2340c0c946e7d1da0abe020b58f91f3e5297b76bf710",
        "word_count": 20
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
