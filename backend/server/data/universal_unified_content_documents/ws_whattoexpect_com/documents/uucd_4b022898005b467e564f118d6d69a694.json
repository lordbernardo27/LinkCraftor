  "structure": {
    "block_count": 16,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Lauren Crosby",
        "text_sha256": "e11a19b5700c1df9f38f1a900472f7ce870e82a1b80780214960b3e6d19ed9f4",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Lauren Crosby, M.D., F.A.A.P.",
        "text_sha256": "e0743285dfa4e20e31fe47709ec477a81a24a74f47fd7226383cbfa7403ba3c9",
        "word_count": 4
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Lauren Crosby, M.D., F.A.A.P.",
        "text_sha256": "5a4bfb750793dda51c7e7fbaadae167e84d05a3b9566a319979571c5a5ae2259",
        "word_count": 5
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Lauren Crosby is a pediatrician in Beverly Hills, California, and a nationally-recognized parenting expert.",
        "text_sha256": "94624d9e1f6912a98eb3c5e433c3268d74957284f4a0544cd60ca3de69cda976",
        "word_count": 15
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "After graduating from Smith College and the UCLA School of Medicine, Dr. Crosby trained at Cedars-Sinai Medical Center, where she served as Chief Resident.",
        "text_sha256": "2710a2dfaaafdb3980d0521b404d665aa5b59bc77ad8f86a8818c026fb6df277",
        "word_count": 24
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "She is currently in private practice at La Peer Pediatrics in Beverly Hills.",
        "text_sha256": "b24b428bf6c90c6877ca5f47633ebef7a39e8983bd888e95595c6af600b049de",
        "word_count": 13
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certifications",
        "text_sha256": "b6ebfd0050d34a00e27b7a07eb958e6520d9d8c003bea281b96762ad17883d6b",
        "word_count": 2
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Crosby is board-certified by the American Board of Pediatrics and is a Fellow of the American Academy of Pediatrics.",
        "text_sha256": "f3a85eda602c91e1c854e5783cff9889b1cb8686daaa891ea089f6f0e0ce56e8",
        "word_count": 20
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Crosby is an attending physician at Cedars-Sinai Medical Center in Los Angeles.",
        "text_sha256": "0875447d7017c3bdbed1cd2006b23221abd62b68080e862ae1ec505a95132c7d",
        "word_count": 13
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Crosby is a member of the American Academy of Pediatrics Council on Communications in Media and an official spokeswoman for the American Academy of Pediatrics.",
        "text_sha256": "671f760dade2c7c373cbb142a1983127c9ab27a2499cc284e782fc1a553a5698",
        "word_count": 26
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "She is a pediatric consultant and medical correspondent for television news, is on the Advisory Board of the Make-A-Wish Foundation, and is a founding member of Hope in A Suitcase.",
        "text_sha256": "92bac24d5b97428223b85737875c1b3234990e3d77a028ce0a364a874f692ac7",
        "word_count": 30
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Crosby is also the mother of two sons.",
        "text_sha256": "22ecbffbed5a719b469004f175a8aff0778bebc392e701a7d05bf4a5d2484f28",
        "word_count": 9
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
