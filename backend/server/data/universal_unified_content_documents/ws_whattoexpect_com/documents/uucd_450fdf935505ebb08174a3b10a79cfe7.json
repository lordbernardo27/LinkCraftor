      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "heading",
        "tag": "h2",
        "text": "The COVID-19 Vaccine During Pregnancy",
        "text_sha256": "5c235148cd12dd588d40da4868d599ae22580002891991361f9930a9a3d89f42",
        "word_count": 5
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "There's plenty of real-world evidence showing that the COVID-19 vaccines are safe and effective when you're expecting. Here, answers to all your questions about the COVID-19 vaccine during pregnancy .",
        "text_sha256": "67a5f4479e541a2f6b0ca2bfe24f60cb75d9d61c966d16b96a5e90d3968a921f",
        "word_count": 30
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "There's plenty of real-world evidence showing that the COVID-19 vaccines are safe and effective when you're expecting.",
        "text_sha256": "797b84b17a84a9ff4d7d89bdbffc4306d11d094e8cd7dcda2d11d92519611b97",
        "word_count": 17
