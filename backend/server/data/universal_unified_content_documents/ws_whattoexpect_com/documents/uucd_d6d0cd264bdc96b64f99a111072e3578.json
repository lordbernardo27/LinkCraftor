    "source_record_id": "raw_html_e012594906e11be4",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-week-by-week-week-36-aspx_e0125949.html",
