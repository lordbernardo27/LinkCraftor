    "source_record_id": "raw_html_4b95d6a97dd97610",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\baby-bathtime-basics-baby-bath-time-challenges-aspx_4b95d6a9.html",
