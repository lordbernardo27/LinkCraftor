    "source_record_id": "raw_html_75e201bf5d335347",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-cute-pregnancy-announcements_75e201bf.html",
