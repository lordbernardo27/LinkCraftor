      "text": "8 Walking Safety Tips for Toddlers to Keep Spills and Hazards at Bay"
    },
    {
      "block_index": 6,
      "heading_id": "heading_00001",
      "level": 2,
      "text": "Key Takeaways"
    },
    {
      "block_index": 10,
      "heading_id": "heading_00002",
      "level": 2,
      "text": "1. Double your childproofing efforts"
    },
    {
      "block_index": 12,
      "heading_id": "heading_00003",
      "level": 2,
      "text": "2. Put potential hazards behind a locked door or up and out of reach"
    },
    {
      "block_index": 14,
      "heading_id": "heading_00004",
      "level": 2,
      "text": "3. Remove roadblocks"
    },
    {
      "block_index": 16,
      "heading_id": "heading_00005",
      "level": 2,
      "text": "4. Set up baby gates and window guards"
    },
    {
      "block_index": 18,
      "heading_id": "heading_00006",
      "level": 2,
      "text": "5. Prevent furniture tip-overs"
    },
    {
      "block_index": 20,
      "heading_id": "heading_00007",
      "level": 2,
      "text": "6. Soften sharp corners and edges"
    },
    {
      "block_index": 22,
      "heading_id": "heading_00008",
      "level": 2,
      "text": "7. Keep doors and drawers closed"
    },
    {
      "block_index": 24,
      "heading_id": "heading_00009",
      "level": 2,
      "text": "8. Cover hot appliances and heated surfaces"
    }
  ],
