    "source_record_id": "raw_html_673c61190f907667",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-your-health-dizziness-sign-of-pregnancy_673c6119.html",
