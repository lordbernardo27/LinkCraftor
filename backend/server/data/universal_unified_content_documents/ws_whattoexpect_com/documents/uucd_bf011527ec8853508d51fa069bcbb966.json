        "text_sha256": "d5a4e06ef26475111ce2e9bf5577cf5e9b4a86a1789256b0ccab1c037e8221c8",
        "word_count": 11
      },
      {
        "block_id": "block_000085",
        "block_index": 85,
        "block_type": "p",
        "tag": "p",
        "text": "Blankets, Loveys, and Separation Anxiety: What’s Normal for Toddlers Medically Reviewed by Gina Posner, M.D., F.A.A.P.",
        "text_sha256": "a9e1a515ccda1e8e62ee934453cef90b55e8fb4a596c5ce4929694627f32ec20",
        "word_count": 16
      },
      {
        "block_id": "block_000086",
        "block_index": 86,
        "block_type": "p",
        "tag": "p",
        "text": "From One Child to Two: 23 Secrets of Second-Time Parents Fact Checked by Jennifer Kelly Geddes, Contributing Writer/Editor",
        "text_sha256": "45f1b5b6dafc019bf1e18c25ff3a3b3ce3859202a9c29a3449bac662d8d9f52f",
        "word_count": 18
      },
      {
        "block_id": "block_000087",
        "block_index": 87,
        "block_type": "p",
        "tag": "p",
        "text": "7 Books to Help Your Toddler Transition to Their Big Kid Bed Medically Reviewed by Kelley Yost Abrams, Ph.D.",
        "text_sha256": "cede5bd54bc018aa9a172741887d78310750b9d106234f0b9c40724256594943",
        "word_count": 19
      },
      {
        "block_id": "block_000088",
        "block_index": 88,
        "block_type": "p",
        "tag": "p",
        "text": "'I Had \"Big Brother Day\" When My Younger Child Was Born — And We All Loved It' Fact Checked by Olivia DeLong, Senior Health Editor",
        "text_sha256": "938e3f24c6d09f4c37d664922bb5c7c3de886e20686a077bf7439e3b00fae583",
        "word_count": 25
      },
      {
        "block_id": "block_000089",
        "block_index": 89,
        "block_type": "p",
        "tag": "p",
        "text": "Breastfeeding a Baby With a Toddler in the House Medically Reviewed by Kyle Monk, M.D.",
        "text_sha256": "0b24437fc8e1129e556b296b2309a3dd857c5e46d3fcb817910426c3ffd197d9",
        "word_count": 15
      },
      {
        "block_id": "block_000090",
        "block_index": 90,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
