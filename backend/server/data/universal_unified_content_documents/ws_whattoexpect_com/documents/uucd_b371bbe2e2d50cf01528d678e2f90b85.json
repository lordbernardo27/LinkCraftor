    "source_record_id": "raw_html_ae34d3fc7eab87d3",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-halloween-pregnancy-announcements_ae34d3fc.html",
