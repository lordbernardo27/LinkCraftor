    "source_record_id": "raw_html_70bf6cc33d5127a9",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\getting-pregnant-fertility-tests-and-treatments-clomid-infertility-treatment_70bf6cc3.html",
