      },
      {
        "block_id": "block_000046",
        "block_index": 46,
        "block_type": "p",
        "tag": "p",
        "text": "Adults and kids should eat one to three servings per week.",
        "text_sha256": "c04d8cc07ce1d3579822ace98f7913db57e1f4cd31507e3cea12702709f5d9c3",
        "word_count": 11
      },
      {
        "block_id": "block_000047",
        "block_index": 47,
        "block_type": "p",
        "tag": "p",
        "text": "The FDA and EPA also designate certain fish as being “good” choices. Your toddler or child can eat one serving per week (but no other fish that week) of the following options:",
        "text_sha256": "6767fdbf39ecf09cdfd383b669732fbce53b5376999f58da0d3799fef2337484",
        "word_count": 32
      },
      {
        "block_id": "block_000048",
        "block_index": 48,
