  "structure": {
    "block_count": 19,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Shubhangi Kesavan",
        "text_sha256": "619950b597d4927f1f2ad28949a6e9f90ffd5ce9386138af5cbeb7ee8fa220a0",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Shubhangi Kesavan, M.D.",
        "text_sha256": "163a9a8d388a6e4765ed59fec19d4538e8cacfeb057503df4b5e3e77f98d0b4d",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Shubhangi Kesavan, M.D.",
        "text_sha256": "87c235fa7547e77c359fbcb2bfa7fd5f7ee2bfad5083c79cfed7c3939b81d32f",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Shubhangi Kesavan is a board-certified OB/GYN practicing in Cleveland, Ohio.",
        "text_sha256": "03b1728c77250d03f68931995b93dd478083f3d15a75db2f755f80ea01ac37a2",
        "word_count": 11
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Kesavan completed her OB/GYN residency at Rutgers University in New Jersey and received her M.D. from the Pad. Dr. D.Y. Patil Medical college in India. She is currently an OB Laborist and Staff Physician at Cleveland Clinic in Ohio.",
        "text_sha256": "81b5e43b480c32f69c6d5319b824370575c390ec633ac99853562c2fb02cfd3a",
        "word_count": 40
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "Her practice interests include high-risk obstetrics management, breastfeeding support, and contraception management.",
        "text_sha256": "620e9781ae22c57467ed9ad6a427eeffaa84fe2d29f1fe6fe5929e41ae580dc7",
        "word_count": 12
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certifications",
        "text_sha256": "b6ebfd0050d34a00e27b7a07eb958e6520d9d8c003bea281b96762ad17883d6b",
        "word_count": 2
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Kesavan is board-certified by the American Board of Obstetrics and Gynecology and is a Fellow of the American College of Obstetricians and Gynecologists (ACOG).",
        "text_sha256": "e45e52cb6804fb47288a19988aa05fb79693bfbb6c7eabe3d895fae757ce7ff9",
        "word_count": 25
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Kesavan is affiliated with Fairview Hospital and Hillcrest Hospital, part of Cleveland Clinic's main campus in Cleveland.",
        "text_sha256": "3f0774b4caadf0fc1c03ded409c7f6f1a0941cf44400aa5cf486173b65c4316f",
        "word_count": 18
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Kesavan is a Clinical Assistant Professor and OBAI Director at Cleveland Clinic Lerner College of Medicine, affiliated with Case Western Reserve University in Cleveland. She serves on several committees for the Society of OB/GYN Hospitalists.",
        "text_sha256": "c49cba7e0dc4d3a2339aa903243afdc9d5db7cb07be88a8c17ca33f9f809b69a",
        "word_count": 36
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Kesavan lives with her husband and daughter.",
        "text_sha256": "cf218a1cc7e699f303fed62466cae20abbec1127351af4c927c616b754ca6b2e",
        "word_count": 8
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "heading",
        "tag": "h2",
        "text": "Publications and research",
        "text_sha256": "43d25db753fa567e93d8e6115d224c40fbbc46686c8a8215a91aeeeb3eb5f790",
        "word_count": 3
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Kesavan has authored many book chapters, including Merck Manuals and Elsevier publications.",
        "text_sha256": "5b694be951f9eafee7e4af41774a078d27b6241cf2e18593f83e8f38c4dadb34",
        "word_count": 13
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Kesavan received a CCLM Pin Recognition for year 3 clerkship in OB/GYN for excellence in teaching in 2023.",
        "text_sha256": "137b12f94a8b54cfadbfc251eecbf69be1b53b174997534ad25c975b871d6309",
        "word_count": 19
      },
      {
        "block_id": "block_000017",
        "block_index": 17,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
