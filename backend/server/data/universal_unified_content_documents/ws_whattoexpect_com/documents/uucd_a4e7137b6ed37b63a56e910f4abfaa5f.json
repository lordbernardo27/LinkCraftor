    "source_record_id": "raw_html_9a10af7450d4f13f",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-feeding-baby-how-to-make-your-own-baby-food_9a10af74.html",
