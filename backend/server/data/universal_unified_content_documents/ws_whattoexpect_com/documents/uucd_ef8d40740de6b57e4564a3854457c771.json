  "structure": {
    "block_count": 16,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Marvin Resmovits",
        "text_sha256": "bd3373ab97ff4c584275dbb003d70dc8584f64ef85b2d33d49687708e5219439",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Marvin Resmovits, M.D.",
        "text_sha256": "f2df086ce8ba24ccc0625281dad2097073ab92ce34e08a2c62c095b7d4743c62",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Marvin Resmovits, M.D.",
        "text_sha256": "4eebe2a590ccc0ba10a5979881c410f915397177ec77758c14d43c73e3d7c9f6",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Marvin Resmovits is a board-certified pediatrician in Great Neck, New York, and serves as Chief of the Western Division of Pediatrics at Optum. Dr. Resmovits has been a practicing primary care pediatrician for more than 35 years.",
        "text_sha256": "d4a99bcf0eea9f8ab06f0d07ecd214a0f2e1b9223472779d381727eebdd56a65",
        "word_count": 38
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Resmovits did his pediatric residency at Long Island Jewish Medical Center, in the pediatric program now referred to as Cohen Children's Medical Center, and served as Assistant Chief Resident in his third year.",
        "text_sha256": "0ddfe4f7c958911bf209268dbeeb8d8a471ca4dbaae05dae6c765a1d68f843c1",
        "word_count": 34
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "He has a Bachelor of Science degree from Yeshiva University in New York City, and received his M.D. from the State University of New York at Buffalo.",
        "text_sha256": "24c3a2c422a840e23906a48266b3e190b058f19307e2685539578037c354e844",
        "word_count": 27
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certification",
        "text_sha256": "c3898f54dc45eb740908fba4888cacdc613965ed71dc29f52a44926a33570aae",
        "word_count": 2
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Resmovits is board-certified by the American Board of Pediatrics.",
        "text_sha256": "912418671f8cdf39d56075ade2460625b7976d05e361d66108712612e567cfca",
        "word_count": 10
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Resmovits is affiliated with Cohen Children's Medical Center in New York, New York, and North Shore University Hospital in Manhasset, New York.",
        "text_sha256": "8ae1e8bec9e25c40abf395f9796654dfac3d939eb0d21d594785a0c1cba6535f",
        "word_count": 23
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Resmovits is an assistant clinical professor of Pediatrics at the Hofstra Northwell School of Medicine in Hempstead, New York. He is also a member of the American Academy of Pediatrics (AAP).",
        "text_sha256": "77afc05948d21f7e33304975feb13d58346d6a985577e226f62f2835afb58236",
        "word_count": 32
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Resmovits has been a Castle Connolly Top Doctor for more than 20 years.",
        "text_sha256": "0f8426ecbf87b904eca589fbd19af99b5d0dac6477c29bd8340f2011992965c0",
        "word_count": 14
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
