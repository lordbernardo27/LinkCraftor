  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/first-year/congenital-torticollis",
    "source_record_id": "raw_html_df5d9f81fd4bbfe0",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-congenital-torticollis_df5d9f81.html",
