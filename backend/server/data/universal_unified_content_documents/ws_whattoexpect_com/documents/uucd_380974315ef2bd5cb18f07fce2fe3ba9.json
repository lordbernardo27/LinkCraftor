  "source_id": "raw_html_9aad2edc7d584294",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/maternity-products/beauty/hair-dye-pregnancy/",
    "source_record_id": "raw_html_9aad2edc7d584294",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\maternity-products-beauty-hair-dye-pregnancy_9aad2edc.html",
    "udare_article_sha256": "bbc881af441c12a6c9e59b34fc3a70976b4af2b00641a023909c3e80ded7fd9b"
  },
  "source_name": "https://www.whattoexpect.com/maternity-products/beauty/hair-dye-pregnancy/",
