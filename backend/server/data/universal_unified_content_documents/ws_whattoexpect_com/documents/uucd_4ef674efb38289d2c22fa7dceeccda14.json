  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/pregnancy/pregnancy-health/complications/mumps.aspx",
    "source_record_id": "raw_html_e0106e2fc9966da6",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-complications-mumps-aspx_e0106e2f.html",
