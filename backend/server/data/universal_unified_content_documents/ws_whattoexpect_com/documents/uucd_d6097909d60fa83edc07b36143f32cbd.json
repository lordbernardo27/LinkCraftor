    "source_record_id": "raw_html_dcbb3b0ef45896a9",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-checklist-family-history-aspx_dcbb3b0e.html",
