  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/toddler/grooming/taking-care-of-toddler-nails.aspx",
    "source_record_id": "raw_html_01f1d82796a3b83f",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\toddler-grooming-taking-care-of-toddler-nails-aspx_01f1d827.html",
