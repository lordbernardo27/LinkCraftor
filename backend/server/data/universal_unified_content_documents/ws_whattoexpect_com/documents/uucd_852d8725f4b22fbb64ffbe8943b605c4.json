    "source_record_id": "raw_html_81b5781d467c8c83",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-get-a-breast-pump-through-your-health-insurance_81b5781d.html",
