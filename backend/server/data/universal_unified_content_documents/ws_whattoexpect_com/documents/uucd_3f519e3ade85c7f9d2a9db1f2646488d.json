  "structure": {
    "block_count": 17,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Eric Surrey",
        "text_sha256": "cb6b95b473a348435b6f31da1e66d68a5af43eb04809aa0852664a55b238f636",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Eric Surrey, M.D.",
        "text_sha256": "17ac00f15bfe0a5b079ca2e533586a18de47a8dea6c5d86aa9d3c32cd8f686b7",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Eric Surrey, M.D.",
        "text_sha256": "2989d2cf118d06a6f65ad4bf10ca2e683cac18aa59147a4f9bb015425560eafa",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Eric Surrey is a board-certified reproductive endocrinologist and fertility specialist who practices at the Colorado Center for Reproductive Medicine (CCRM) in Lone Tree, Colorado.",
        "text_sha256": "b4c914d2120d808d114ad2804ec2de8e7a0d7a554f461a6e2b7e82fa01814d78",
        "word_count": 25
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Surrey completed his residency and fellowship training in the Department of OB/GYN at the UCLA School of Medicine in Los Angeles, California.",
        "text_sha256": "96fac966bb1476af8c4d776dad8e561fb3c589bf87b9f21cdc82076dbc6942c6",
        "word_count": 23
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certifications",
        "text_sha256": "b6ebfd0050d34a00e27b7a07eb958e6520d9d8c003bea281b96762ad17883d6b",
        "word_count": 2
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Surrey is board-certified by the American Board of Obstetrics and Gynecology.",
        "text_sha256": "ba255ef259d7207f63f9b3fedae1f490f3a9e932efc0efd8e998f80adae218d3",
        "word_count": 12
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Surrey is affiliated with Sky Ridge Medical Center in Lone Tree, Colorado.",
        "text_sha256": "46d238e2bfa85188f81e33a75fed77897c1c8079bc0619a16dec89547bfc2939",
        "word_count": 13
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "p",
        "tag": "p",
        "text": "Prior to joining CCRM in 1999, Dr. Surrey was an associate clinical professor of OB/GYN at UCLA and had been director of the Division of Reproductive Medicine at Cedars-Sinai Medical Center and the Assisted Reproductive Technologies Program at Century City Hospital in Los Angeles.",
        "text_sha256": "c7bdc3a52207da6e484c888524e4586c5b7d9340a79b2debe6ab2baeae3c2773",
        "word_count": 44
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "He is past president of the Society for Assisted Reproductive Technology, Society of Reproductive Surgeons and the Pacific Coast Reproductive Society, and currently serves on the Executive Council of the Society for Assisted Reproductive Technology.",
        "text_sha256": "cf710e1487fdc18ed09eac91d3c54b18552577c0ff09d677b130cc98415461c8",
        "word_count": 35
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Surrey has authored more than 125 peer-reviewed articles and invited publications, and he has presented on more than 135 abstracts at national and international meetings on the subjects of infertility, endometriosis and assisted reproductive technologies.",
        "text_sha256": "7272a0d24b5dd9be985a6a78c3c78ae4ce3c161f4ca73c8fdddc6c7369de5efe",
        "word_count": 36
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Surrey has been named a Castle Connolly Top Doctor in Reproductive Endocrinology in 2017 and 2018 and was also selected as one of America’s Top Doctors for Women by Women’s Health Magazine in November 2008.",
        "text_sha256": "bf8dd4a02aee0666d287a6b9f9a5035ee7e1af8ebcab01014443cb6dce040b9d",
        "word_count": 36
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
