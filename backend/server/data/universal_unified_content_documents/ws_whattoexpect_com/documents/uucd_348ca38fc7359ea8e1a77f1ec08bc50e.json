  "source_format": "html",
  "source_id": "raw_html_5502ed272c13643c",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/pregnancy/baby-sprinkle-registry",
    "source_record_id": "raw_html_5502ed272c13643c",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-baby-sprinkle-registry_5502ed27.html",
