      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
        "tag": "p",
        "text": "16 Classic Yet Cool Italian Baby Boy Names for Your Bambino Fact Checked by Jennifer Kelly Geddes, Contributing Writer/Editor",
        "text_sha256": "572909a7354ee446d6e6cb53d0924ea17aaea9762a6f93c28cf7053fec3aa84f",
        "word_count": 19
      },
      {
        "block_id": "block_000039",
