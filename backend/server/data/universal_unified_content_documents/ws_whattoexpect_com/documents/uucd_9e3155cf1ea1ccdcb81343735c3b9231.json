        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "From Paris, With Love: 17 Sweet and Chic French Baby Girl Names Fact Checked by Jennifer Kelly Geddes, Contributing Writer/Editor",
        "text_sha256": "f479a15366aa52d4bf0b71bdfe463a969c9c58fa3a6c6e941ce20546e606ac2d",
