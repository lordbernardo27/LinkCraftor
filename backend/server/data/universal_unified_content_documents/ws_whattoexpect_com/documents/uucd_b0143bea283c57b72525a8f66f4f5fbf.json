  "source_format": "html",
  "source_id": "raw_html_9a0b76fdc7b62803",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/first-year/ask-heidi/thumb-sucking-baby.aspx",
    "source_record_id": "raw_html_9a0b76fdc7b62803",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-ask-heidi-thumb-sucking-baby-aspx_9a0b76fd.html",
