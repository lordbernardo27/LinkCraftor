  "structure": {
    "block_count": 17,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Shannon Smith",
        "text_sha256": "5c1adef38ba3ee986c66d1b1ff591e4702a4243ee52b1281bc1044b6bc564353",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Shannon Smith, M.D.",
        "text_sha256": "cf9fad9dacf78640af8523c179bae3aef6481f133896942a6f18dca6fd1dc864",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Shannon Smith, M.D.",
        "text_sha256": "2cc81a2fe24f085aab7d8e7f95f64ffc72898cf01f9e295aa84bf25f78d96b71",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Shannon Smith is a board-certified OB/GYN and partner at Brigham Faulkner Ob/Gyn Associates in Boston, Massachusetts.",
        "text_sha256": "4c4dd82485b493a92bb7ee0a7c254b0999ec780c0327c88e1c1b94c36000b648",
        "word_count": 17
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Smith has a B.A. degree in psychology with a distinction of honors from Wake Forest University. She earned her M.D. from Wake Forest University School of Medicine and completed her residency and training at Tufts Medical Center in Boston.",
        "text_sha256": "155528b6f96af7d3d167a692911f0fe52de6448c5d3ed8bb1d020fc85b0cef74",
        "word_count": 40
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certifications",
        "text_sha256": "b6ebfd0050d34a00e27b7a07eb958e6520d9d8c003bea281b96762ad17883d6b",
        "word_count": 2
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Smith is board-certified by the American Board of Obstetrics and Gynecology.",
        "text_sha256": "beaa130f6f455afba2cd6d3cc34cf2ee90a650545dad9c056369b76b8ef6f2d3",
        "word_count": 12
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Smith is affiliated with Brigham and Women’s Hospital and Brigham and Women’s Faulkner Hospital in Boston.",
        "text_sha256": "2b87f249f57049cd5396ca62ddc46930eb0f5c934276886987c43a7181922d60",
        "word_count": 17
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Smith is a faculty member at Harvard Medical School and a fellow of the American Congress of Obstetricians & Gynecologists (FACOG). She's also a member of the American College of Obstetrics & Gynecology (ACOG), the American Medical Association (AMA), the Massachusetts Medical Association (MMS) and the American Association of Gynecologic Laparoscopists (AAGL).",
        "text_sha256": "28f3c2aeefed370810cefcff17dac58ae9a85783f92094790412eea0bf3a569c",
        "word_count": 53
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "heading",
        "tag": "h2",
        "text": "Publications",
        "text_sha256": "82b2eb07aaea1da81684fdbaf171f0ef11c109a086a1040e84851d67ad01856e",
        "word_count": 1
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Smith has published a variety of abstracts and online articles covering subjects related to pregnancy and minimally invasive surgery.",
        "text_sha256": "e74a155fe1eff764be70a5ad6fd9c71513769593a35c2e33753e3e6521aec23d",
        "word_count": 20
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Smith has been honored as a Top Doctor in Massachusetts since 2015.",
        "text_sha256": "54091b56616fff9dc1c2626fd6e791838fb239c29011048b56bd45fadf9702a8",
        "word_count": 13
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
