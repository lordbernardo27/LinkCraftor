        "text_sha256": "8ce5f24a37ab68e01743f0cb3f0234dd767a31a441e3e3be35047619722ffec6",
        "word_count": 2
      },
      {
        "block_id": "block_000030",
        "block_index": 30,
        "block_type": "p",
        "tag": "p",
        "text": "November 13, 2025",
        "text_sha256": "07b7d369e2d683c726c87ddaf22cc65a7dd1c547484a351782e2a21fdcf891fd",
        "word_count": 3
      },
      {
