    "source_record_id": "raw_html_3fb9a0a814acdce1",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-symptoms-and-solutions-pelvic-discomfort-aspx_3fb9a0a8.html",
