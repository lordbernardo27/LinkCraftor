        "tag": "li",
        "text": "Whole-wheat pasta",
        "text_sha256": "bd8d012a24dc6b7c5d99026d2e505cb5ef82483304690638de5b346865a8a33e",
        "word_count": 2
      },
      {
        "block_id": "block_000022",
        "block_index": 22,
        "block_type": "li",
        "tag": "li",
        "text": "Whole-grain cereals and breads",
        "text_sha256": "7783c248b2c399c61faa8b6e188a6019bfdb772ca9cc160d956cb01d657482de",
        "word_count": 4
      },
      {
        "block_id": "block_000023",
        "block_index": 23,
        "block_type": "li",
        "tag": "li",
        "text": "Nut butters",
        "text_sha256": "b08dbfd47210ec9a77fec52e90f1a607846f92e3121abf83ec953c067f5828ed",
        "word_count": 2
      },
      {
        "block_id": "block_000024",
        "block_index": 24,
        "block_type": "li",
        "tag": "li",
        "text": "Walnuts, cashews, pistachios, almonds, Brazil nuts and pine nuts",
        "text_sha256": "c334ef9eecc2888093a368188c849f6256e9bfe22243850a1d5f21a20f7894c0",
        "word_count": 9
      },
      {
        "block_id": "block_000025",
        "block_index": 25,
        "block_type": "li",
        "tag": "li",
        "text": "Soy milk",
        "text_sha256": "c7f79bcc99251b6ebe807e545e57a35fda16c8af229c527ac1c56c1565585a03",
        "word_count": 2
      },
      {
        "block_id": "block_000026",
        "block_index": 26,
