        "text": "Tofu",
        "text_sha256": "a1fab401f55e3a63f7f760acb16b48ed8e6ab0b8ebb4101058f01fe2d42e2484",
        "word_count": 1
      },
      {
        "block_id": "block_000027",
        "block_index": 27,
        "block_type": "li",
        "tag": "li",
        "text": "Tempeh",
        "text_sha256": "ab0fcc7dc25e48f1d4d31af9bc7a22845d9085f1f56f57d00ec77b134319fbbc",
        "word_count": 1
      },
      {
        "block_id": "block_000028",
        "block_index": 28,
        "block_type": "li",
        "tag": "li",
        "text": "Lentils",
        "text_sha256": "52b746b6851495a831c61c5099b375114b0dcb60c320152624eb355fcf36a1c4",
        "word_count": 1
      },
      {
        "block_id": "block_000029",
        "block_index": 29,
        "block_type": "li",
        "tag": "li",
        "text": "Hemp seeds",
        "text_sha256": "a1f7302d6ca6bf30212c61ad70495d35ee1072d485263285f7af7f6f3fd14da1",
        "word_count": 2
      },
      {
        "block_id": "block_000030",
        "block_index": 30,
        "block_type": "li",
        "tag": "li",
        "text": "Edamame",
        "text_sha256": "f7dbe92aaef77a49de5216c5e63558a60f6296bdbda3d5a53c3d890ad645f898",
        "word_count": 1
      },
      {
        "block_id": "block_000031",
        "block_index": 31,
        "block_type": "li",
        "tag": "li",
        "text": "Miso",
        "text_sha256": "17c7fd8325bfbf464aa51caac07cc569e59f8676924ce0dab127d37e229bec5f",
        "word_count": 1
      },
      {
        "block_id": "block_000032",
        "block_index": 32,
        "block_type": "heading",
        "tag": "h3",
        "text": "Calcium",
        "text_sha256": "636f0dc2dfb9f86221365459a9145c904e211ee378a3a2b6a0aa3459873ef402",
        "word_count": 1
      },
      {
        "block_id": "block_000033",
        "block_index": 33,
        "block_type": "p",
        "tag": "p",
        "text": "Calcium is key during pregnancy for building your baby’s bones, muscles, heart and nerves, especially during the third trimester. In fact, it's so essential to his development that what he doesn't get from what you eat, your body will take from your bones, potentially putting you at risk of osteoporosis later in life.",
        "text_sha256": "78c5ce0f6789716567407357b54e28a311a099c6b4c37001e369c892b5c7c991",
        "word_count": 53
      },
      {
        "block_id": "block_000034",
        "block_index": 34,
        "block_type": "p",
        "tag": "p",
        "text": "If you're vegetarian, dairy products like yogurt, milk and cheese remain great options. But no matter your diet, other plant-based sources can help you get your daily recommended calcium . Your practitioner may also suggest that you add a calcium supplement for extra insurance.",
        "text_sha256": "b674fbab21c3ce23cea7b5cf7b51b6c4a9ba9af023e3f0181db5efe409848994",
        "word_count": 44
      },
      {
        "block_id": "block_000035",
        "block_index": 35,
        "block_type": "p",
        "tag": "p",
        "text": "How much: 1,000 mg per day",
        "text_sha256": "be39a470aa17b45e8342efb41653b0f8624dad75e8159775295bffcc3ec26a23",
        "word_count": 6
      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "p",
        "tag": "p",
        "text": "Best calcium sources for vegans or vegetarians to eat during pregnancy:",
        "text_sha256": "d7692291e85243205b7097d3aa120962dc7db06e809b0d2c4d4a69cb5407c66d",
        "word_count": 11
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "li",
        "tag": "li",
        "text": "Yogurt",
        "text_sha256": "bd4c1d9ac7fa95852ad1581dfb4d499f43022d4a71a2f3d1b86eec66c82d8d07",
        "word_count": 1
      },
      {
        "block_id": "block_000038",
