        "text_sha256": "ca32e25c53fa606d119e913c776536568ff5b701a0577d03a24fa94b134c0a1d",
        "word_count": 16
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "17 Ways Dads and Partners Can Advocate for a Healthy Pregnancy, Birth and Postpartum Medically Reviewed by Tarun Jain, M.D.",
        "text_sha256": "b068490d9ac61fa2572d17451048261e30ad4308bf9af422c7210be54837c407",
        "word_count": 20
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
