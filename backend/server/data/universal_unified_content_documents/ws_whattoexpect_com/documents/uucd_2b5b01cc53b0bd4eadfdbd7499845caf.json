    "source_record_id": "raw_html_dd747dc1e1a26802",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-when-to-call-a-doctor_dd747dc1.html",
