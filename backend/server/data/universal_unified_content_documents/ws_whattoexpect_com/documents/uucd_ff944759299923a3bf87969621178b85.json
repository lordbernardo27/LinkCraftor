    "source_record_id": "raw_html_fc12948c891ad0a4",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-placenta-accreta_fc12948c.html",
