  "structure": {
    "block_count": 18,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "James Greenberg",
        "text_sha256": "08957bf363587daffc7885834404f1c64390f808d16735860258823fa7366481",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "James Greenberg, M.D.",
        "text_sha256": "b1fbe827244b99727d7e48c73056d62e62173b73c2d9ea7f74f421ef17dc2869",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About James Greenberg, M.D.",
        "text_sha256": "b09e1d32b7bf7d11c6c9c9fb3e4a9eb39002490b59197755cde3db462e2fffc4",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. James Greenberg is a board-certified general obstetrician/gynecologist and serves as a Vice Chairman of the Department of Obstetrics & Gynecology at Brigham and Women's Hospital in Boston, Massachusetts.",
        "text_sha256": "097c2135a992a60f1950b5106dda59f8aaa64381610ab8b99d3522994383ac98",
        "word_count": 29
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Greenberg did his residency training at the Brigham and Women's Hospital and Massachusetts General Hospital in Boston, Massachusetts.",
        "text_sha256": "daba19fc7090cc5531a796bc2b76610f19f3192274538c49b411ec6f5eafa3c5",
        "word_count": 19
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "He has a Bachelor of Arts degree in history from Amherst College and received his M.D. from New York University School of Medicine.",
        "text_sha256": "85e63af28807a2c0b3c41eda20c80ccffa27fdabaae6ba84b544621c5dbc67a6",
        "word_count": 23
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certification",
        "text_sha256": "c3898f54dc45eb740908fba4888cacdc613965ed71dc29f52a44926a33570aae",
        "word_count": 2
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Greenberg is board-certified by the American Board of Obstetrics and Gynecology.",
        "text_sha256": "44678e7aab8044c5b0792665d825ee7dfc234d5884a15510e98af4c9787137e5",
        "word_count": 12
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Greenberg is affiliated with Brigham and Women's Hospital and Brigham and Women's Faulkner Hospital in Boston.",
        "text_sha256": "525327dba177066a15f8207569fde820e7e59d9a72a4a8dafc5608d230d625f9",
        "word_count": 17
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Greenberg is an associate professor of Obstetrics and Gynecology at Harvard Medical School and a team member of the International Organization for Women and Development (IOWD), which addresses women's health issues in Rwanda.",
        "text_sha256": "d6ea1077e36159caa983b0cef8dbc319d81c8d29bafcd8b9e756c8e055887daa",
        "word_count": 34
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "heading",
        "tag": "h2",
        "text": "Publications and research",
        "text_sha256": "43d25db753fa567e93d8e6115d224c40fbbc46686c8a8215a91aeeeb3eb5f790",
        "word_count": 3
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Greenberg has published more than 100 articles, abstracts and chapters in a wide variety of scientific media. He is a subject author for UpToDate on C-sections and vaginal deliveries requiring vacuum extraction.",
        "text_sha256": "b7b442c706b16ba0ff6c35e4b5ce3c13c62da0599b93c9b1c3c9fabb1f041586",
        "word_count": 33
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Greenberg has been a Castle Connolly Top Doctor since 2010.",
        "text_sha256": "c6007b387ed5e54c8cfd09fbf888b47a3afe4ffbaadbe6c9a7db6bd8256a93c8",
        "word_count": 11
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000017",
        "block_index": 17,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
