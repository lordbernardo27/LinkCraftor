        "text_sha256": "f5ea4c5c6d10064dd5f02e12d4db7b56a9074d7113acbc724b2ae5824bab6651",
        "word_count": 7
      },
      {
        "block_id": "block_000029",
        "block_index": 29,
        "block_type": "li",
        "tag": "li",
        "text": "Suavinex Pacifier (0-6 months)",
        "text_sha256": "3f496839d09f5f1a8e52bfe2b1645ebe96550ec027b07f4ce3f30c0b3c98996c",
        "word_count": 4
      },
      {
        "block_id": "block_000030",
        "block_index": 30,
        "block_type": "li",
        "tag": "li",
        "text": "Bibs Pacifier (0-6 months)",
        "text_sha256": "cf1aa4749b78050dba47881ee958193d8331d520ddd54675966cb0a04e93a14b",
        "word_count": 4
      },
      {
        "block_id": "block_000031",
        "block_index": 31,
        "block_type": "li",
        "tag": "li",
        "text": "Beaufort Bonnet Company burp cloth",
        "text_sha256": "279fe1600897602dad7fb3877f1cb97fc88851a488729917bc3e046b28540dbc",
        "word_count": 5
      },
      {
        "block_id": "block_000032",
        "block_index": 32,
        "block_type": "li",
        "tag": "li",
        "text": "Stonyfield Organic bib",
        "text_sha256": "fd24f221c00e6a9615f38a6dd6c0157bf6c32802d158cc4767daf3d820971697",
        "word_count": 3
      },
      {
        "block_id": "block_000033",
        "block_index": 33,
        "block_type": "heading",
        "tag": "h3",
        "text": "Sample-size Products:",
        "text_sha256": "3fec63222926a7aade8c8fed58d9be85166c5f662fc8b001d45c28262ec41179",
        "word_count": 2
      },
      {
        "block_id": "block_000034",
        "block_index": 34,
        "block_type": "p",
        "tag": "p",
        "text": "The 2026 Babylist Welcome Box: Huggies Skin essentials diapers, Honest company wipes, waterwipes, ubbi baby wipes, health baby diapers, triple paste",
        "text_sha256": "c7f2b3787883c2e69faef2a8b1da202730ecf437ae0b8ff8617ac3b339bbf78b",
        "word_count": 21
      },
      {
        "block_id": "block_000035",
        "block_index": 35,
        "block_type": "p",
        "tag": "p",
        "text": "Babylist stocks their welcome box with diapering samples — perfect for traveling or testing before investing in full-size products.",
        "text_sha256": "b8cd14ce1ae598a3dd4c3973fe1b907026475da76359b6e68bf240fa15f56411",
        "word_count": 19
      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "li",
        "tag": "li",
        "text": "WaterWipes (10-count)",
        "text_sha256": "3f2ffdb74c527f7768e43786fd896db174243ec50e67dae3e04e497689c77864",
        "word_count": 2
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "li",
        "tag": "li",
        "text": "Honest Clean Conscious Wipes (10-count)",
        "text_sha256": "57facd2ace47d7ed362dc53cf52cc60512e59ec04749335a84f23b3a1f4342dc",
        "word_count": 5
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "li",
