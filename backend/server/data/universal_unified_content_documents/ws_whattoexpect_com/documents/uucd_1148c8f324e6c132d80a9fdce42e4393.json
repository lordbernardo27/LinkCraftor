  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/family/gun-safes-for-homes-with-babies-and-kids",
    "source_record_id": "raw_html_f3d2201458b61ba7",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\family-gun-safes-for-homes-with-babies-and-kids_f3d22014.html",
