    "source_record_id": "raw_html_c2a48f82b8e1c7a7",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-complications-toxoplasmosis-aspx_c2a48f82.html",
