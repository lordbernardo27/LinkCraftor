      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "p",
        "tag": "p",
        "text": "Your Questions About Sex During Pregnancy, Answered Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "ef5155c9fccba9a7f0b9fddce259c832d039bd57db41163bef6ade8dd925f340",
        "word_count": 14
      },
      {
        "block_id": "block_000037",
