    "source_record_id": "raw_html_8a6abd7a8d9bedc7",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-health-aluminum-in-vaccines_8a6abd7a.html",
