    "source_record_id": "raw_html_f0106c59651989a8",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-thanksgiving-pregnancy-announcements_f0106c59.html",
