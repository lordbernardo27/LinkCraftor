      "text": "Does your baby really look like the 3D ultrasound?"
    },
    {
      "block_index": 17,
      "heading_id": "heading_00003",
      "level": 2,
      "text": "Other reasons your baby's face looks weird on an ultrasound"
    },
    {
      "block_index": 19,
      "heading_id": "heading_00004",
      "level": 3,
      "text": "Baby is still developing body fat."
    },
    {
      "block_index": 22,
      "heading_id": "heading_00005",
      "level": 3,
      "text": "Baby's face is turned toward the uterine wall."
    },
    {
      "block_index": 25,
      "heading_id": "heading_00006",
      "level": 3,
      "text": "Baby's face is covered by another body part."
    },
    {
      "block_index": 27,
      "heading_id": "heading_00007",
      "level": 3,
      "text": "Baby's soft spot is really big."
    }
  ],
