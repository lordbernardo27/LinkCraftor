  "structure": {
    "block_count": 19,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Oluwatosin Goje",
        "text_sha256": "9e686d5d26d6fec3775b6908a9aafad14fd0f1f647aa490e1139869198def65b",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Oluwatosin Goje, M.D.",
        "text_sha256": "95ce50e8aab2a7212bc644967b4e404c144c4830ec73ebfe6f3a4511214aa57a",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Oluwatosin Goje, M.D.",
        "text_sha256": "4f9c61c944d8adf3293df2e6b0d63eafd0977d189f827318b0d8b8f2b4e0a659",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Oluwatosin \"Tosin\" Goje is a board-certified OB/GYN and infectious diseases specialist at the Cleveland Clinic's Obstetrics, Gynecology and Women's Health Institute in Cleveland, Ohio. She works in the Obstetrics and Gynecology department and Center for Specialized Women’s Health.",
        "text_sha256": "e3e221501989e306dc1cda4e43efb0cac651564f0c76c7bd8006ac6dae3a37a7",
        "word_count": 39
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Goje is an expert in infectious diseases during pregnancy, including the impact of COVID-19, Zika, HIV, sexually transmitted diseases and other infections and diseases on pregnant women and their babies.",
        "text_sha256": "6321a6285475af411318ca47b9caea257d35542aa9d49f9b6fea87316ed1402a",
        "word_count": 31
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Goje received her medical degree from Ahmadu Bello University in Zaria, Kaduna, Nigeria, and earned a Master's of Science and Clinical Research at the Medical University of South Carolina in Charleston, South Carolina. She did an internship year in internal medicine at Metropolitan Hospital in New York, New York, and completed her obstetrics and gynecology residency at the University of Medicine and Dentistry of New Jersey-New Jersey Medical School, Rutgers University, in Newark, New Jersey.",
        "text_sha256": "16c984a137bd6ef5af7a4485fc1a30541ff27f4ccea07465121ee37844c60ca2",
        "word_count": 76
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Goje completed a fellowship in reproductive infectious diseases at the Medical University of South Carolina in Charleston.",
        "text_sha256": "4bb02cd6ebe417c1ee60fea2e42234724b6b15520a9c6f4fec9b122e8029dec0",
        "word_count": 18
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certifications",
        "text_sha256": "b6ebfd0050d34a00e27b7a07eb958e6520d9d8c003bea281b96762ad17883d6b",
        "word_count": 2
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Goje is board-certified by the American Board of Obstetrics and Gynecology.",
        "text_sha256": "6101caad0c774a1594a3e8b5e1aedcb6444458c3c7bc6c59beb36e12ff567a96",
        "word_count": 12
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Goje is affiliated with the Cleveland Clinic in Cleveland.",
        "text_sha256": "94f8ad94eb1183acf375cadfe8b24e7ec5223f94bf1067b9b842508f3764634a",
        "word_count": 10
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Goje is an assistant professor of obstetrics/gynecology and reproductive biology at Cleveland Clinic's Lerner College of Medicine of Case Western Reserve University.",
        "text_sha256": "83879aba8fdde87bf6bf8b1f90fca75dc9fc9afc004815a0e2a12506e2e10dea",
        "word_count": 23
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "p",
        "tag": "p",
        "text": "She is a member of the American College of Obstetricians and Gynecologists (ACOG), the Infectious Diseases Society for Obstetrics and Gynecology (IDSOG) and the Infectious Disease Society of America (IDSA).",
        "text_sha256": "2516a17e0868ea187a87a1335000eba85c02c72f82582d27610bd498430bb950",
        "word_count": 30
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Goje serves as a reviewer for Journal of Minimally Invasive Gynecology (JMIG), the British Medical Journal (BMJ) and other medical and academic journals. She is a regular and frequent media contributor and expert on pregnancy and infectious diseases, specifically COVID-19 and pregnancy.",
        "text_sha256": "dd0f024865172800401fc8045aa76df6a7c7b651628356c02538c6af2062f5f1",
        "word_count": 43
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "heading",
        "tag": "h2",
        "text": "Publications and research",
        "text_sha256": "43d25db753fa567e93d8e6115d224c40fbbc46686c8a8215a91aeeeb3eb5f790",
        "word_count": 3
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Goje is actively involved in research and clinical trials and has published numerous papers and peer-reviewed articles on infectious diseases during pregnancy, labor and delivery, and pregnancy complications, among other topics.",
        "text_sha256": "14a5131436ec9a96b1f5498d7f28aafa3b82c4084d422bf2885ee2dcacf8f777",
        "word_count": 32
      },
      {
        "block_id": "block_000017",
        "block_index": 17,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000018",
        "block_index": 18,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
