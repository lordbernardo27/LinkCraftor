    "source_record_id": "raw_html_9dac7fe3eb85ac54",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-complications-fifth-disease-aspx_9dac7fe3.html",
