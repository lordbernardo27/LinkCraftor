    },
    {
      "block_index": 37,
      "heading_id": "heading_00005",
      "level": 2,
      "text": "Is your toddler afraid of going to the doctor?"
    },
    {
      "block_index": 40,
      "heading_id": "heading_00006",
      "level": 3,
      "text": "Tell it like it is"
    },
    {
      "block_index": 42,
      "heading_id": "heading_00007",
      "level": 3,
      "text": "Read up"
    },
    {
      "block_index": 44,
      "heading_id": "heading_00008",
      "level": 3,
      "text": "Let him play doctor"
    },
    {
      "block_index": 46,
      "heading_id": "heading_00009",
      "level": 3,
      "text": "Make it a treat"
    },
    {
      "block_index": 48,
      "heading_id": "heading_00010",
      "level": 3,
      "text": "Check your own stress"
