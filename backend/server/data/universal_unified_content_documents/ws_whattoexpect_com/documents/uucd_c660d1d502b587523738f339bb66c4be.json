  "source_id": "raw_html_8ff4a623aaa3f196",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/toddler/health-and-safety/24-month-well-baby-visit/",
    "source_record_id": "raw_html_8ff4a623aaa3f196",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\toddler-health-and-safety-24-month-well-baby-visit_8ff4a623.html",
