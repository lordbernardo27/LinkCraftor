        "text_sha256": "3cb3e13d70e7fabfc46d0d5aa637a99872c0bf4d90413377262ecb00c84888f8",
        "word_count": 15
      },
      {
        "block_id": "block_000035",
        "block_index": 35,
        "block_type": "p",
        "tag": "p",
        "text": "Listen Up, Second-Time Moms: 9 Ways Your Second Pregnancy May Surprise You Medically Reviewed by Tarun Jain, M.D.",
        "text_sha256": "63c51f6b008977df2b39c8806844914cd1ea5a2d53c91f950f5998bf6a7087e1",
        "word_count": 18
      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "p",
        "tag": "p",
        "text": "16 Signs of Labor — Here’s What to Expect When It’s Go-Time Medically Reviewed by Shannon Smith, M.D.",
        "text_sha256": "64fb89ac71efcff557e43d30813200bb9b8473fe3444ea5a43e07d5468814adb",
        "word_count": 18
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "Is This It? How to Tell When It's Really Time to Go to the Hospital for Labor Medically Reviewed by Tarun Jain, M.D.",
        "text_sha256": "f9bfe7e6b935696dde65b0f4c95cd1ed8086334fe3b4de90b051a3e67becf2ea",
        "word_count": 23
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
        "tag": "p",
        "text": "9 Things I Wish I'd Known Before Giving Birth Fact Checked by Kathleen Felton, Contributing Writer/Editor",
        "text_sha256": "78518c576a33325b0ee4ba08380059c841c26d05414e986a7742dee69da8afd3",
        "word_count": 16
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
