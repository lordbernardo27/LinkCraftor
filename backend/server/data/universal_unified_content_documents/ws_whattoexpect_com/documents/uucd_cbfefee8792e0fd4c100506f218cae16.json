    "source_record_id": "raw_html_1ebe92f6419a8bd3",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-vaccinations-hepatitis-b-vaccine_1ebe92f6.html",
