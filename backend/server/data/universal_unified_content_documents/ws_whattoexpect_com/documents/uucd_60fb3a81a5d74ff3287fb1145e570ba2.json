    "source_record_id": "raw_html_7242dd8d98dbb363",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-baby-feeding-when-can-babies-eat-apples_7242dd8d.html",
