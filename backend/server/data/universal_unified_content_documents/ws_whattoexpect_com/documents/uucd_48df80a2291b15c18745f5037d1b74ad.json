    "source_record_id": "raw_html_05cf3833045bee8e",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-symptoms-and-solutions-visible-veins-aspx_05cf3833.html",
