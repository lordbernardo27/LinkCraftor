    "canonical_url": "https://www.whattoexpect.com/pregnancy/week-by-week/week-42.aspx",
    "source_record_id": "raw_html_aeaa3ab164346469",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-week-by-week-week-42-aspx_aeaa3ab1.html",
