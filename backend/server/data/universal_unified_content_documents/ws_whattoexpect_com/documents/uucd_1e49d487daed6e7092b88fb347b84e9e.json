    "source_record_id": "raw_html_faf2f90362adab74",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-symptoms-and-solutions-saliva-aspx_faf2f903.html",
