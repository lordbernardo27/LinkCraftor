    "source_record_id": "raw_html_ccdaab6a6df9378f",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-baby-care-baby-skin-care-impetigo-aspx_ccdaab6a.html",
