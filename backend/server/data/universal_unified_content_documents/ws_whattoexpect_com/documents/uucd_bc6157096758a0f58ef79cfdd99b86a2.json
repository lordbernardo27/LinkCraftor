        "word_count": 6
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "heading",
        "tag": "h2",
        "text": "What is your first impression of this boy name?",
        "text_sha256": "be58b0f881a614ce417a1aa15c629242a96857b4d0e3f019c6772e4a82527829",
        "word_count": 9
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "heading",
        "tag": "h2",
        "text": "Share your favourite feminine names starting with “L” ?",
        "text_sha256": "b7a50538e808b8a2e5cc75b5d63a5a053c8c7e2241abc7e632b9d7515d16f29b",
        "word_count": 9
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "heading",
        "tag": "h2",
        "text": "Tell me an uncommon name",
        "text_sha256": "9ff4902b4ceb010eca7e18572d87dd279751d0948d1c71e214c366b6a7373fd0",
        "word_count": 5
      },
      {
        "block_id": "block_000040",
        "block_index": 40,
        "block_type": "p",
        "tag": "p",
        "text": "There are 53,926 active discussions happening now in our Baby Names community group.",
        "text_sha256": "e06b6b371e571ebf4023339ac4b4c70069a17da7d81b96ea62890dff7dc06146",
        "word_count": 13
      },
      {
        "block_id": "block_000041",
