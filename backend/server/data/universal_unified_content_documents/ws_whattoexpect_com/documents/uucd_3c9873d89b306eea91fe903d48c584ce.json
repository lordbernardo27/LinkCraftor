  "source_id": "raw_html_7d72cb5152d92802",
  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/pregnancy/pregnancy-health/prenatal-testing-group-b-strep/",
    "source_record_id": "raw_html_7d72cb5152d92802",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-prenatal-testing-group-b-strep_7d72cb51.html",
