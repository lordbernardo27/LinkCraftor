    "source_record_id": "raw_html_139ee42244ba4114",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-gender-reveal-nails_139ee422.html",
