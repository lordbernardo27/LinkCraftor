  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/childrens-health-and-safety/stuffy-nose-in-toddlers-and-babies.aspx",
    "source_record_id": "raw_html_c83da06b190867d4",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\childrens-health-and-safety-stuffy-nose-in-toddlers-and-babies-aspx_c83da06b.html",
    "udare_article_sha256": "fa92b5255737cbcb343d104b87e7c16ee3f7eff18d0bb167c6ce40eefaf26445"
