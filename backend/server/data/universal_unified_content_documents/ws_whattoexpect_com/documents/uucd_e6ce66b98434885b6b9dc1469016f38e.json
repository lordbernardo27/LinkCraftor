    "source_record_id": "raw_html_099ce25c8553b911",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-baby-feeding-when-can-babies-eat-cucumber_099ce25c.html",
