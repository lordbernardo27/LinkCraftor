  "structure": {
    "block_count": 19,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Katie Propst",
        "text_sha256": "cf4addaf12d2a16bddddd6bb20d3381aeb5244dbad42934c1db700991b04b7c8",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Katie Propst, M.D.",
        "text_sha256": "c64c9e91f4a25f00e84bd9aedcee166fe5a045db2655651930833866695d0c47",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Katie Propst, M.D.",
        "text_sha256": "6bbabd44da673b46e303a9af010ed0fc71a2077620ce363e0b64d2281f556b23",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Katie Propst is a urogynecologist at the University of South Florida in Tampa, Florida. She is board-certified in obstetrics and gynecology and in female pelvic medicine and reconstructive surgery.",
        "text_sha256": "cf21c32e15b67b331941280c1072bb562e2aee3596723fdb4375dcf6eea8345c",
        "word_count": 30
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Propst serves as the division chief of female pelvic medicine and reconstructive surgery and the director of the female pelvic medicine and reconstructive surgery fellowship at the University of South Florida.",
        "text_sha256": "b1cacbbf30a1270db08a435d191b6f6a00a346933108dd62e32ffb6b3e966481",
        "word_count": 32
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certification",
        "text_sha256": "c3898f54dc45eb740908fba4888cacdc613965ed71dc29f52a44926a33570aae",
        "word_count": 2
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Propst is board-certified by the American Board of Obstetrics and Gynecology.",
        "text_sha256": "6c8f1d0d41ff65b0d487d82ab5cf56ef2d27498e88fabb4f694c4c347b1b1b0f",
        "word_count": 12
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Propst is affiliated with Tampa General Hospital.",
        "text_sha256": "602ff0fa0417739f068ce45ccad658343d25552bb338d46ef8be2012b704bdda",
        "word_count": 8
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Propst is an assistant professor of obstetrics and gynecology at the University of South Florida Morsani College of Medicine.",
        "text_sha256": "da106ef7fbb2dc5965d120419e3a2a249865cd550e4220d4daa3058037880c3f",
        "word_count": 20
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "She is the founder and chair of the Childbirth and Pelvic Floor Disorders Special Interest Group of the American Urogynecologic Society, where she works collaboratively with other experts from across the United States. She also serves as the chair of the Advanced Practice Provider Education Committee for the American Urogynecologic Society.",
        "text_sha256": "708d971a5dadcf52a983221cba9ae5deef1d37bf8042409d0ab35eda026a9da0",
        "word_count": 51
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Propst is actively involved in the education of medical students, residents and fellows.",
        "text_sha256": "9643dede9b756ef0fc00e3ff0396313362872710091084cf87e7eb0949a51bc9",
        "word_count": 14
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "heading",
        "tag": "h2",
        "text": "Publications and research",
        "text_sha256": "43d25db753fa567e93d8e6115d224c40fbbc46686c8a8215a91aeeeb3eb5f790",
        "word_count": 3
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Propst has published more than 30 peer-reviewed articles and regularly presents at scientific conferences.",
        "text_sha256": "10f38b480ba128cfcf9f15aeecf6dfcf957657b2469273025759ce88b5051a58",
        "word_count": 15
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "heading",
        "tag": "h2",
        "text": "Awards",
        "text_sha256": "669a46138d69d7c12f52f82ccde4385630ece1947fc7e3a382b371d4aed02f28",
        "word_count": 1
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Propst has received multiple awards throughout her career. She was awarded research grant funding from the American Association of Gynecologic Laparoscopists (AAGL) and the Cleveland Clinic Center for Populations Health Research. Dr. Propst has numerous teaching awards, including from the Council on Resident Education in Obstetrics and Gynecology.",
        "text_sha256": "0d410a947328dec6be0eaa908a69bef0c1b1dbd168318931f990a170a7faa013",
        "word_count": 49
      },
      {
        "block_id": "block_000017",
        "block_index": 17,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000018",
        "block_index": 18,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
