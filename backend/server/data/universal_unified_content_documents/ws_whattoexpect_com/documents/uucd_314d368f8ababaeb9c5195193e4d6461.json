  "structure": {
    "block_count": 16,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Ultrasounds are a regular part of pregnancy, but that first one is particularly special. It's the first time you'll get to see your growing little one (even if they just look like a little tadpole!) and the first time you'll hear their little heartbeat. So we asked moms to describe what they thought when they first saw baby on that screen. Here's what they had to stay:",
        "text_sha256": "998db3b55345f70b40df2255814717989d8bcd91cadc185af22e092b0a59b361",
        "word_count": 67
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "p",
        "tag": "p",
        "text": "\"That's a Baby?\"",
        "text_sha256": "76d4aeaccf197bbb6001901ac62939dbb7712366468c11de05f9e0719e662af0",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "p",
        "tag": "p",
        "text": "\"Yay, a Heartbeat\"",
        "text_sha256": "0cf7ca5897ae1ac94f38ad7e46cb196990c0deefc540299f1a007b53682c5760",
        "word_count": 3
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "\"Tears of Joy!\"",
        "text_sha256": "982e99b1fd11f3e7e871b55e63d0de3e852122a4bf8f258e5d978d92184ad23b",
        "word_count": 3
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "\"That's in There?\"",
        "text_sha256": "888f936f54f274f4d7de39a632abba5d7b816294dd9d031ba12b3089ff5b067d",
        "word_count": 3
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "\"It's a ... Tadpole!\"",
        "text_sha256": "81f76e977d6128fa0d6cbd7d5e7ab2db00da71db3604611ebd0ace6048393bc1",
        "word_count": 4
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "p",
        "tag": "p",
        "text": "\"My Little Blessing\"",
        "text_sha256": "49778ef1cf08303cf4877b5751dc2b3484a0ccb5d90283a9e214fa1903849cb6",
        "word_count": 3
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "\"My Poor Bladder\"",
        "text_sha256": "129e3cbf0a0c22a7a0ca371ebecde1d921591967388061de582bbcd949936b8d",
        "word_count": 3
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "p",
        "tag": "p",
        "text": "\"Where Is It?\"",
        "text_sha256": "980e59b449a7f6c546924afa688ba66b015e9070cd49b6ea8a7a0dca0047c5b4",
        "word_count": 3
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "\"There are Two?!\"",
        "text_sha256": "eb6312f0de59e7409817d9542abc8f88503fe7810ac0d4b357661e6d3d837d29",
        "word_count": 3
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "p",
        "tag": "p",
        "text": "\"This Feels Real\"",
        "text_sha256": "1ef6926fb243bac24a608462db14adea3b7170e629eef32f633852206b0f23bf",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "\"Cute Little Alien\"",
        "text_sha256": "10a7c0bbbd7f2ef0e827da2e8b2652f7fbf94aa8eeae4637dc31df74ac0cf05d",
        "word_count": 3
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "\"Nervous, Scared, Anxious\"",
        "text_sha256": "b1a6378cca082570ce86a61b318cebda5bfa5c0143b8dcdaf06a867b5a0ee94f",
        "word_count": 3
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "p",
        "tag": "p",
        "text": "\"Blew Me Away\"",
        "text_sha256": "551bdcf6f2e56985dd1d35107fe7271b1f8d0cce66fa37fe78f6c4081de4da05",
        "word_count": 3
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "\"I'm a Mom!\"",
        "text_sha256": "46db0e7e07c5d108d67c2e98701715e6429670e9fbedcde2f724275498616b3d",
        "word_count": 3
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "p",
        "tag": "p",
        "text": "\"That's My Baby!\"",
        "text_sha256": "4a1320816c852309341ca3a39d6fd1cdac2e6ee8e7bf324e59729faf38b8b06b",
        "word_count": 3
      }
    ],
