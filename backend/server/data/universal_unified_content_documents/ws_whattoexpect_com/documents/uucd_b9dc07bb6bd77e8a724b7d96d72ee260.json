    "source_record_id": "raw_html_5b882b34187a6040",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\getting-pregnant-fertility-tests-and-treatments-blocked-fallopian-tubes_5b882b34.html",
