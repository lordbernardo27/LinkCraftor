    "source_record_id": "raw_html_5ff128cf31e2a05f",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-your-health-hereditary-pregnancy-conditions_5ff128cf.html",
