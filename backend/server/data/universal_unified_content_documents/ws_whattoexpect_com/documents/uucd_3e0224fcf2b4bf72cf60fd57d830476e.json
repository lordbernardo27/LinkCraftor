    "source_record_id": "raw_html_1efd2ee05374a1b3",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-safety-and-childproofing-fisher-price-recalls-snuga-infant-swing-after-infant-deaths-reported_1efd2ee0.html",
