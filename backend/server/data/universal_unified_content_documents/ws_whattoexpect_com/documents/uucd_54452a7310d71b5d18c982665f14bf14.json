    "source_record_id": "raw_html_154da0b453def539",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-ask-heidi-blood-clot-aspx_154da0b4.html",
