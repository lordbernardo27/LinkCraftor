    "source_record_id": "raw_html_9d6514f159ff0b62",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\childrens-health-growing-pains_9d6514f1.html",
