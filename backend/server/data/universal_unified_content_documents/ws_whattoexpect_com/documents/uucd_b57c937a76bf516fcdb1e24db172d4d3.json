    "source_record_id": "raw_html_a82bf43367268c04",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-labor-and-delivery-procedures-and-interventions-electronic-fetal-monitoring-aspx_a82bf433.html",
