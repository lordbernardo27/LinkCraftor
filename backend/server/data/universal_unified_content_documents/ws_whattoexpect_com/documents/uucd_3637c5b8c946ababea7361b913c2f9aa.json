    "source_record_id": "raw_html_be2f5823821c29cb",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-pregnancy-hormones-aspx_be2f5823.html",
