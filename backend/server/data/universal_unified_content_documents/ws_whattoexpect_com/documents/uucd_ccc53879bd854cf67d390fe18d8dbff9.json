  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/first-year/first-laugh/",
    "source_record_id": "raw_html_b3e19d50958d68b3",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-first-laugh_b3e19d50.html",
    "udare_article_sha256": "2f5e9f02e17b456e2d0cb5c252cdeca0f64ff604cb78ba76659471f4f51c73e1"
