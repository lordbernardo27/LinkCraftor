      "text": "3 to 6 months"
    },
    {
      "block_index": 13,
      "heading_id": "heading_00004",
      "level": 3,
      "text": "6 to 12 months"
    },
    {
      "block_index": 17,
      "heading_id": "heading_00005",
      "level": 3,
      "text": "12 to 18 months"
    },
    {
