        "block_type": "p",
        "tag": "p",
        "text": "Hosting a Baby Shower? Here’s Your Stress-Free Planning Checklist Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "0ef97cd4c9694c095d0ca1fa2fab829918592222c70c8408eee79d0e1201cc3e",
        "word_count": 16
      },
      {
        "block_id": "block_000084",
        "block_index": 84,
        "block_type": "p",
        "tag": "p",
        "text": "15 Baby Shower Cupcake Ideas That Are Just as Sweet as Your Little One Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "3a6460a3544894b219494afed774640e605590145f7af7a0c91496957f1f27b2",
        "word_count": 21
      },
      {
        "block_id": "block_000085",
        "block_index": 85,
        "block_type": "p",
        "tag": "p",
        "text": "20 Fun Baby Shower Games Your Guests Will Love to Play Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "6f4f389e93e8b537c5f7e76add213e49303547a180a5d9142e3c8dd76adaa2ea",
        "word_count": 18
      },
      {
        "block_id": "block_000086",
        "block_index": 86,
        "block_type": "p",
        "tag": "p",
        "text": "How to Make Baby Shower Punch That Gets the Party Started Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "71dc872f4912d25d23b435200c68c36bf3f4f2fff19697a32029fbe853267301",
        "word_count": 18
      },
      {
        "block_id": "block_000087",
        "block_index": 87,
        "block_type": "p",
        "tag": "p",
        "text": "Planning a Baby Shower? Smart Etiquette Tips to Make The Day Run Smoother Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "1eba2d2b65e415bc67ecaabfb19ca2758b18bfa1920b1eb308a4bd31a795ef41",
        "word_count": 20
      },
      {
        "block_id": "block_000088",
        "block_index": 88,
        "block_type": "p",
        "tag": "p",
        "text": "Baby Shower Invitation Wording Ideas Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "e58d4f7d6fdf4cd7970f48ed82658c0cb4b7788a3d48551e5556bea4eb6f1f45",
        "word_count": 12
      },
      {
        "block_id": "block_000089",
