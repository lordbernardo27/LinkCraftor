        "text_sha256": "10a6cbde521cded737bb90e003580dccdfec36c6ea31005ffe84368bf46e8470",
        "word_count": 16
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "Fetal Heart Monitors During Pregnancy Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "f2c29b0cd52b88cd2a9f526b33825dfc03f14bcc9e652c3d9e0cee707e5115b9",
        "word_count": 12
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
        "tag": "p",
        "text": "Tiny Fingers, Big Impact: How Your Baby’s Sense of Touch Develops in Utero Medically Reviewed by James Greenberg, M.D.",
        "text_sha256": "0e484b1d7305d9ceb861ef784668af4f211af0b84678d1475970f8c86f41f1bb",
        "word_count": 19
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "p",
        "tag": "p",
        "text": "20 Baby Lullaby Songs to Help Your Little One Fall Asleep Fact Checked by Christine Gordon",
        "text_sha256": "dc01ac13fcff829e08a7ef48280a8fdf5deba37ec8b0bc6cced0e496781ada42",
        "word_count": 16
      },
      {
        "block_id": "block_000040",
        "block_index": 40,
        "block_type": "p",
