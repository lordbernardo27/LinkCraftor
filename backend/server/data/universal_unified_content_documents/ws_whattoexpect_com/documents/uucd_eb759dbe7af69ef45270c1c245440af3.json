        "text": "Your Next Read",
        "text_sha256": "6d2b65f6bc74d3f3d5656d8c88c806ff70605a0ce9d4fd990efe9af093220755",
        "word_count": 3
      },
      {
        "block_id": "block_000029",
        "block_index": 29,
        "block_type": "p",
        "tag": "p",
        "text": "Your Baby’s Tiny Ears Are Tuning In — Here’s When Hearing Develops in the Womb Medically Reviewed by James Greenberg, M.D.",
        "text_sha256": "6b0c2e3a69a24754f1ab5c534ce774f113e24d763c94f3396bc9c04c7ad58c85",
