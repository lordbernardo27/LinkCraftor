        "text": "How to Plan the Ultimate Gender Reveal Party Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "981a8e8914d97ada03eeff5a0a77174e1554a6fd14a6c82bf82c4dbac9b8465d",
        "word_count": 15
      },
      {
        "block_id": "block_000089",
        "block_index": 89,
        "block_type": "p",
        "tag": "p",
        "text": "15 Baby Shower Cupcake Ideas That Are Just as Sweet as Your Little One Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "3a6460a3544894b219494afed774640e605590145f7af7a0c91496957f1f27b2",
        "word_count": 21
      },
      {
        "block_id": "block_000090",
        "block_index": 90,
        "block_type": "p",
        "tag": "p",
        "text": "10 Gender Reveal Themes to Inspire Your Special Celebration Fact Checked by Caroline Picard, Deputy Editor",
        "text_sha256": "1e5a964550a789a48bbb63cbd6118a12a9112ce6ef6eadb02bb2e2fd0d3bde27",
        "word_count": 16
