    "source_record_id": "raw_html_e9c91e38e0667f16",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-baby-care-baby-skin-care-stork-bites-aspx_e9c91e38.html",
