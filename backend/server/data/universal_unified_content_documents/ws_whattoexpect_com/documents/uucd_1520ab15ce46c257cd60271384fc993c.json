        "block_type": "heading",
        "tag": "h2",
        "text": "Your Next Read",
        "text_sha256": "6d2b65f6bc74d3f3d5656d8c88c806ff70605a0ce9d4fd990efe9af093220755",
        "word_count": 3
      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "p",
        "tag": "p",
        "text": "Sexually Transmitted Diseases (STDs) During Pregnancy Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "5db3d58f186205b150eb5632ac35440762939ebaf9f484637866b4ecc5cafd77",
        "word_count": 13
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "Cytomegalovirus (CMV) During Pregnancy Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "7baa366f9ddf91c564e41b2b51b32accbaa32d93475c055afe4dd0552b0b1992",
        "word_count": 11
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
        "tag": "p",
        "text": "Chickenpox and Shingles During and After Pregnancy Medically Reviewed by Oluwatosin Goje, M.D.",
        "text_sha256": "6bbb0ce21d4838f3f2613b52a9cb79c01c5eefef6206191b227aa2dd3e720646",
        "word_count": 13
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "p",
        "tag": "p",
        "text": "Herpes and Pregnancy Medically Reviewed by Oluwatosin Goje, M.D.",
        "text_sha256": "11e79f8a5013dafd177b012375401373865c1187355f276cc02397582b67a47b",
        "word_count": 9
      },
      {
        "block_id": "block_000040",
        "block_index": 40,
