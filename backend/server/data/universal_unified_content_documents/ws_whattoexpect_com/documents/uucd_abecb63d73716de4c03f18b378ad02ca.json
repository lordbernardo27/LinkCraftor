    "source_record_id": "raw_html_b4a196f49ab662eb",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-ask-heidi-amusement-park-rides-aspx_b4a196f4.html",
