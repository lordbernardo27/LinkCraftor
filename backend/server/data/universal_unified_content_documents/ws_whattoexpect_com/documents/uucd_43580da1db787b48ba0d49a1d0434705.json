    "source_record_id": "raw_html_0af0c462b46c7ed9",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\first-year-baby-care-baby-skin-care-cradle-cap-aspx_0af0c462.html",
