        "block_type": "p",
        "tag": "p",
        "text": "How to Safely Support a Newborn's Head and Neck Medically Reviewed by Lauren Crosby, M.D., F.A.A.P.",
        "text_sha256": "47b35a50ea68fe3aa33b0c3ecdd0d5169e2d5149c01090639cda73bb652398a9",
