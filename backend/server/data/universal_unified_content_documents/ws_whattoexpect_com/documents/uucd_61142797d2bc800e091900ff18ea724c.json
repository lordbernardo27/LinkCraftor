    "source_record_id": "raw_html_671aa5b645229c48",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-your-health-heartburn-sign-of-pregnancy_671aa5b6.html",
