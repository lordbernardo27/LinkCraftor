    "source_record_id": "raw_html_12e7dc359c87aba2",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-fall-maternity-photos_12e7dc35.html",
