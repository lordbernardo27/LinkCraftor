    "udare_article_sha256": "e5045ef69211c769c7b7c996b84ba15660f2ba9cce893664c3fda250c01b59e9"
  },
  "source_name": "https://www.whattoexpect.com/toddler/childhood-injuries/splinters-in-children.aspx",
