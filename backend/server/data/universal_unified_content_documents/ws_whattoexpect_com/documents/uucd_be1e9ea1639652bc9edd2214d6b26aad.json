        "text": "Updates to copy, sources, and formatting.",
        "text_sha256": "2bf448333081ffc8549a45a6c4b7fc711ee4b93575f0fffd3c4a6212c13581c2",
        "word_count": 6
      },
      {
        "block_id": "block_000029",
        "block_index": 29,
        "block_type": "heading",
        "tag": "h2",
        "text": "What Our Community Is Talking About",
        "text_sha256": "d8b0012420e0596569d82492adcfd478e8a0515e246b6126fce1a6bca5cfe633",
        "word_count": 6
      },
      {
        "block_id": "block_000030",
        "block_index": 30,
        "block_type": "heading",
        "tag": "h2",
        "text": "40 Plus Ladies TTC Part 6",
        "text_sha256": "d9432903f7ac08712f59347448663327a8d2183f9cd36688cb4d5beefe898b97",
        "word_count": 6
      },
      {
        "block_id": "block_000031",
        "block_index": 31,
        "block_type": "heading",
        "tag": "h2",
        "text": "Late June early July testers!",
        "text_sha256": "d4e92b96f3bd8b590423702e3a38319dcb2040798d1faf8a4701266b2e0c4d72",
        "word_count": 5
      },
      {
        "block_id": "block_000032",
        "block_index": 32,
        "block_type": "p",
        "tag": "p",
        "text": "There are 91,506 active discussions happening now in our Trying to Conceive community group.",
        "text_sha256": "265f6914734becf95676d96812aac6c5553dee066969b7544a0524fdee0036c6",
        "word_count": 14
      },
      {
        "block_id": "block_000033",
        "block_index": 33,
        "block_type": "heading",
        "tag": "h2",
        "text": "Your Next Read",
        "text_sha256": "6d2b65f6bc74d3f3d5656d8c88c806ff70605a0ce9d4fd990efe9af093220755",
        "word_count": 3
      },
      {
        "block_id": "block_000034",
        "block_index": 34,
        "block_type": "p",
        "tag": "p",
        "text": "Why I Stayed on My Antidepressants While Pregnant, Despite the Risks Medically Reviewed by Shannon Smith, M.D.",
        "text_sha256": "ad09a69ef52e047b525abdabe12bc5c1af553e0cc2ae8f8cfb22b88c10974e43",
        "word_count": 17
      },
      {
        "block_id": "block_000035",
        "block_index": 35,
        "block_type": "p",
        "tag": "p",
        "text": "Depression During Pregnancy Medically Reviewed by Sipra Laddha, M.D.",
        "text_sha256": "b52248967033820c455a30c3ba0d220f3c481da72c6c0394add075db742d97b3",
        "word_count": 9
      },
      {
        "block_id": "block_000036",
        "block_index": 36,
        "block_type": "p",
        "tag": "p",
        "text": "Can You Drink Alcohol While Trying to Conceive? Here’s What Experts Recommend Medically Reviewed by Alexandra Paetow, M.S., R.D.N.",
        "text_sha256": "547eaa3bc092227a77885512e531e0c60bd480285ae7022cfa1474cb4df49c64",
        "word_count": 19
      },
      {
        "block_id": "block_000037",
        "block_index": 37,
        "block_type": "p",
        "tag": "p",
        "text": "Medications During Pregnancy: What’s Safe and What’s Not? Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "af01accb2230b393ee41ddc328bcc3b3ffd1995ff28b89cd8d8273dce647ced3",
        "word_count": 15
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
        "tag": "p",
        "text": "Is it Safe to Get A Facial When You're Pregnant or Trying to Conceive? Medically Reviewed by Jennifer Wu, M.D., F.A.C.O.G.",
        "text_sha256": "4e944bc09ec270eff4afddc6b71e2d3fa284cf3687a431c18ebdc3c3e6beb900",
        "word_count": 21
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "p",
