        "text": "Editor: Lisa Lombardi/Rebekah Wahlberg",
        "text_sha256": "af9172e3adad5114fe13be7fd7bb88da0dc167aa00a9c36b069ba18d07784149",
        "word_count": 4
      },
      {
        "block_id": "block_000028",
