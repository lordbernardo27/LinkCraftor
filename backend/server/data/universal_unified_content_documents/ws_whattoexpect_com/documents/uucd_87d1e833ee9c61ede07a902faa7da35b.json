    "source_record_id": "raw_html_54f6c85d7bb6135c",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-and-herbal-therapy-aspx_54f6c85d.html",
