  "structure": {
    "block_count": 17,
    "blocks": [
      {
        "block_id": "block_000000",
        "block_index": 0,
        "block_type": "p",
        "tag": "p",
        "text": "Robin Schaffran",
        "text_sha256": "77d052a6ed1f6b782b6869b015043ffb5c2f58ed7f18f92ae8fe90ca44b72fb0",
        "word_count": 2
      },
      {
        "block_id": "block_000001",
        "block_index": 1,
        "block_type": "heading",
        "tag": "h1",
        "text": "Robin Schaffran, M.D.",
        "text_sha256": "1fe93482a361877e921c7eee8cf7646fa816067ed3d1aea72df93eaee9b29167",
        "word_count": 3
      },
      {
        "block_id": "block_000002",
        "block_index": 2,
        "block_type": "heading",
        "tag": "h2",
        "text": "About Robin Schaffran, M.D.",
        "text_sha256": "e4a5792d75ead5d35dfa525d958db51bafd10f707cb5d820afbe9a1fea22ae33",
        "word_count": 4
      },
      {
        "block_id": "block_000003",
        "block_index": 3,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Robin Schaffran is a board-certified dermatologist practicing both pediatric and adult dermatology in Beverly Hills, California.",
        "text_sha256": "efc2d178b35327d509f943653bbb5ac7afd685dd25da9c07a5c724be196b227d",
        "word_count": 17
      },
      {
        "block_id": "block_000004",
        "block_index": 4,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Schaffran completed her dermatology residency at Oregon Health & Science University in Portland, Oregon, and an internal medicine internship at Harvard Medical School’s Beth Israel Deaconess Medical Center in Boston, Massachusetts.",
        "text_sha256": "f6778ff029e63e59eff2164537074cae223860dbfe6251fdcebc49c779fb1e93",
        "word_count": 32
      },
      {
        "block_id": "block_000005",
        "block_index": 5,
        "block_type": "p",
        "tag": "p",
        "text": "She received her M.D. from the University of Toronto, where she graduated as a member of the Alpha Omega Alpha honors society. She previously earned a Bachelor of Science from McGill University in Montreal.",
        "text_sha256": "f8e8a1f0f72602a660e7c3b25ef3c5ec8161bef1144c5a50944d2a82ab56a42f",
        "word_count": 34
      },
      {
        "block_id": "block_000006",
        "block_index": 6,
        "block_type": "heading",
        "tag": "h2",
        "text": "Board certification",
        "text_sha256": "c3898f54dc45eb740908fba4888cacdc613965ed71dc29f52a44926a33570aae",
        "word_count": 2
      },
      {
        "block_id": "block_000007",
        "block_index": 7,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Schaffran has been board-certified with the American Board of Dermatology since 1999.",
        "text_sha256": "bffef0878e6dd1e221f417238ea7f687561085768e6472cc37ec732e66324d72",
        "word_count": 13
      },
      {
        "block_id": "block_000008",
        "block_index": 8,
        "block_type": "heading",
        "tag": "h2",
        "text": "Hospital affiliations",
        "text_sha256": "e6504e68d7e8e6b8187bc1b13e33b31f751fb7b365b27cf9f90691053f642ba2",
        "word_count": 2
      },
      {
        "block_id": "block_000009",
        "block_index": 9,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Schaffran is affiliated with Cedars-Sinai Medical Center in Los Angeles, California.",
        "text_sha256": "f02c235d76442f27bde41b6e673c5504565dc93fa8ecd7473aa8059d484c6d0e",
        "word_count": 12
      },
      {
        "block_id": "block_000010",
        "block_index": 10,
        "block_type": "heading",
        "tag": "h2",
        "text": "Other relevant positions",
        "text_sha256": "3cb35bf4b505f1c9652a309bbf062b6c5ebff2ba01239bd968b9ac137f401f2b",
        "word_count": 3
      },
      {
        "block_id": "block_000011",
        "block_index": 11,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Schaffran is a fellow of the American Academy of Dermatology and a member of the Women’s Dermatologic Society and the American Society for Laser Medicine and Surgery.",
        "text_sha256": "ecd9512a71a832d26208924e72452ac9199abd4225686f42b98a90356a25177f",
        "word_count": 28
      },
      {
        "block_id": "block_000012",
        "block_index": 12,
        "block_type": "p",
        "tag": "p",
        "text": "She is married and a mom to three wonderful daughters ages 13, 12 and 9. She enjoys traveling, hiking, running, cooking and spending time with family.",
        "text_sha256": "1d410cb71e8be2fb91a362cda5744d189cfb789457e261e3ecfcde50b99343ef",
        "word_count": 26
      },
      {
        "block_id": "block_000013",
        "block_index": 13,
        "block_type": "heading",
        "tag": "h2",
        "text": "Publications and research",
        "text_sha256": "43d25db753fa567e93d8e6115d224c40fbbc46686c8a8215a91aeeeb3eb5f790",
        "word_count": 3
      },
      {
        "block_id": "block_000014",
        "block_index": 14,
        "block_type": "p",
        "tag": "p",
        "text": "Dr. Schaffran received a clinical research fellowship grant from the American Contact Dermatitis Society in 1997. She has been published in several peer-reviewed journals.",
        "text_sha256": "21b53b941cbce070c2f480c37ac959301217b965e724e327b95175f03d0f658e",
        "word_count": 24
      },
      {
        "block_id": "block_000015",
        "block_index": 15,
        "block_type": "p",
        "tag": "p",
        "text": "The educational health content on What To Expect is reviewed by our medical review board and team of experts to be up-to-date and in line with the latest evidence-based medical information and accepted health guidelines, including the medically reviewed What to Expect books by Heidi Murkoff. This educational content is not medical or diagnostic advice. Use of this site is subject to our terms of use and privacy policy . © 2005-2026 Everyday Health, Inc., a Ziff Davis company.",
        "text_sha256": "c423e7e136e9c8ebf39e668c5b1617d92d49cbd07ce74c8b1ec308c597fa3593",
        "word_count": 79
      },
      {
        "block_id": "block_000016",
        "block_index": 16,
        "block_type": "heading",
        "tag": "h2",
        "text": "Opens a new window",
        "text_sha256": "52b71e1a64c4aa4703a246e34de17b242088e4863ab032b365c12e07d7964633",
        "word_count": 4
      }
    ],
