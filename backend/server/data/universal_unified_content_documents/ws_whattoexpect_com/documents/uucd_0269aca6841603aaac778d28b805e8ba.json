    "source_record_id": "raw_html_60a43de934164784",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-photo-ideas_60a43de9.html",
