    "source_record_id": "raw_html_63d441af1e10c738",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-and-chiropractic-care-aspx_63d441af.html",
