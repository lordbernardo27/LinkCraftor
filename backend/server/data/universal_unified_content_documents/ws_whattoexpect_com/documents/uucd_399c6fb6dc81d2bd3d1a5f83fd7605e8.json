    "source_record_id": "raw_html_48cfc8e56ca5006a",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-skincare-ingredients-safe-not-safe_48cfc8e5.html",
