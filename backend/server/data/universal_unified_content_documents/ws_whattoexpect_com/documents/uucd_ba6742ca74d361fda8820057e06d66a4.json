      },
      {
        "block_id": "block_000044",
        "block_index": 44,
        "block_type": "li",
        "tag": "li",
        "text": "Tape the paper towel tube to a piece of circular cardboard.",
        "text_sha256": "c8c5240a5844c7473bba7a383e2aab76d766228a3b77d11012dd9105ce9de800",
        "word_count": 11
      },
      {
        "block_id": "block_000045",
        "block_index": 45,
        "block_type": "li",
        "tag": "li",
        "text": "Roll up diapers, and tie them with rubber bands.",
        "text_sha256": "76d3e88edd65ac9f124b8bc50987a3a26db0bea16a2762bb442a542423d0a96a",
        "word_count": 9
      },
      {
        "block_id": "block_000046",
        "block_index": 46,
        "block_type": "li",
        "tag": "li",
        "text": "Tie the diapers in rings around the tube.",
        "text_sha256": "1bb2b50ee151deb38d06c6a4ee0257e3596c80473cce7b63598ef4bb238d5a8d",
        "word_count": 8
      },
      {
        "block_id": "block_000047",
        "block_index": 47,
        "block_type": "li",
        "tag": "li",
        "text": "Stack additional rings of diapers on top.",
        "text_sha256": "827c146494d2fbef092b77b52c3d308ff5113904cb0b383c41e82e2dab579478",
        "word_count": 7
      },
      {
        "block_id": "block_000048",
        "block_index": 48,
        "block_type": "li",
        "tag": "li",
        "text": "Wrap ribbon to hide the twine.",
        "text_sha256": "9bc71c68b0793786a6897f74a0354def2cf0ef106e7a3d9b7ed22c1fb8132f5f",
        "word_count": 6
      },
      {
        "block_id": "block_000049",
        "block_index": 49,
        "block_type": "li",
        "tag": "li",
        "text": "Put washi tape around the edge of the cardboard.",
        "text_sha256": "68974cb6d3caf97cd63334251aec6b2b9680992df8482423ab94008c07c3016e",
        "word_count": 9
      },
      {
        "block_id": "block_000050",
