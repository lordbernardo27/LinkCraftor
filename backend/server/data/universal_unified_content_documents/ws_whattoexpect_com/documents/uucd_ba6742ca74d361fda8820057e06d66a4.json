        "text": "Paper towel tube",
        "text_sha256": "2668f9ef3b17af9e56889fce06069e1897cea030b0e5c0b9a9b1beeca22b5ca3",
        "word_count": 3
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "li",
        "tag": "li",
        "text": "Scotch tape",
        "text_sha256": "bfaf6e7397d223bff0bf9ed79e032db43e04e83a131416f684c96d37aadaebed",
        "word_count": 2
      },
      {
        "block_id": "block_000040",
        "block_index": 40,
        "block_type": "li",
        "tag": "li",
        "text": "Ribbon",
        "text_sha256": "ed5a4ba1c163cdddd7224f24a64a7a97eeb373b483978397c5216740ecd3c31a",
