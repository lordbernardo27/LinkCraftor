        "text": "Rubber bands",
        "text_sha256": "992c193e8871b31987acb59b6c2277093ade41c4e52cdf3c7ac87dbdc4da5601",
        "word_count": 2
      },
      {
        "block_id": "block_000035",
        "block_index": 35,
        "block_type": "li",
        "tag": "li",
        "text": "Scissors",
        "text_sha256": "0d30bdfcce4f3f5125745e9085fa5da1fc483ba3ea8262eb9993263788727d25",
        "word_count": 1
      },
      {
        "block_id": "block_000036",
