        "text": "Washi tape",
        "text_sha256": "05c3b11f7541fed198dd4e14d6dfd6aa8ce50f8b54c3c0e470cdbf99f0cb08fb",
        "word_count": 2
      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "li",
