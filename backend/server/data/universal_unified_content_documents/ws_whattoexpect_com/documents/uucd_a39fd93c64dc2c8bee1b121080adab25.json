    "source_record_id": "raw_html_5fc07e89dc6ac4b4",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-iodine-in-diet_5fc07e89.html",
