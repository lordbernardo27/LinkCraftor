      },
      {
        "block_id": "block_000038",
        "block_index": 38,
        "block_type": "p",
        "tag": "p",
        "text": "A Dozen Tips for Getting Pregnant Fast Medically Reviewed by Tarun Jain, M.D.",
        "text_sha256": "9875e456f7e1e78fc63d9cea7e13611d6cb87c905efeb17cfa044d1bf8fab30d",
        "word_count": 13
      },
      {
        "block_id": "block_000039",
        "block_index": 39,
        "block_type": "p",
        "tag": "p",
        "text": "Pinpoint Your Fertile Window: How to Track Ovulation and Boost Your Chances of Getting Pregnant Medically Reviewed by Mark Payson, M.D.",
        "text_sha256": "9f18f2130282a89a93ebdb75586fdb505561830e86a5a7b2632e9f223d810f6e",
        "word_count": 21
      },
      {
