  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/pregnancy/pregnancy-health/complications/cytomegalovirus.aspx",
    "source_record_id": "raw_html_4c20e63c1c87184a",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-pregnancy-health-complications-cytomegalovirus-aspx_4c20e63c.html",
