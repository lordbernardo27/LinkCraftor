  "source_identity": {
    "canonical_url": "https://www.whattoexpect.com/pregnancy/funny-pregnancy-announcements",
    "source_record_id": "raw_html_961a8dccf886ca4c",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-funny-pregnancy-announcements_961a8dcc.html",
