    "source_record_id": "raw_html_5ec6bda75dc33824",
    "udare_article_path": "C:\\Users\\HP\\Documents\\LinkCraftor\\backend\\server\\data\\udare_store\\ws_whattoexpect_com\\articles\\pregnancy-gender-reveal-themes_5ec6bda7.html",
