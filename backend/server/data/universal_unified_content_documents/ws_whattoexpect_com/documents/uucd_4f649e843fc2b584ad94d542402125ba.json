      "text": "Key Takeaways"
    },
    {
      "block_index": 10,
      "heading_id": "heading_00002",
      "level": 2,
      "text": "When should I schedule my first prenatal visit?"
    },
    {
      "block_index": 14,
      "heading_id": "heading_00003",
      "level": 2,
      "text": "When will my first prenatal visit take place?"
    },
    {
      "block_index": 20,
      "heading_id": "heading_00004",
      "level": 2,
      "text": "How should I prepare for my first pregnancy appointment?"
    },
    {
      "block_index": 23,
      "heading_id": "heading_00005",
      "level": 3,
      "text": "Make a list of key health facts"
    },
    {
      "block_index": 30,
      "heading_id": "heading_00006",
      "level": 3,
      "text": "Take stock of your medications"
    },
    {
      "block_index": 32,
      "heading_id": "heading_00007",
      "level": 3,
      "text": "Learn about family health history"
    },
    {
      "block_index": 34,
      "heading_id": "heading_00008",
      "level": 3,
      "text": "Write down your questions"
    },
    {
      "block_index": 37,
      "heading_id": "heading_00009",
      "level": 2,
      "text": "What will happen at my first prenatal visit?"
    },
    {
      "block_index": 39,
      "heading_id": "heading_00010",
      "level": 3,
      "text": "Get a check-up"
    },
    {
      "block_index": 47,
      "heading_id": "heading_00011",
      "level": 3,
      "text": "Get a confirmation of your pregnancy"
    },
    {
      "block_index": 49,
      "heading_id": "heading_00012",
      "level": 3,
      "text": "Get an official countdown"
    },
    {
      "block_index": 55,
      "heading_id": "heading_00013",
      "level": 3,
      "text": "Talk about yourself and your baby"
    },
    {
      "block_index": 59,
      "heading_id": "heading_00014",
