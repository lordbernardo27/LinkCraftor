from .models import JOB_STATUS_QUEUED, JOB_STATUS_RUNNING, OrchestrationJob

# ---------------------------------------------------------------------------
# Design notes (what changed and why)
#
# The previous implementation kept a module-level list (_queue_job_ids) that
# was rebuilt from the job store on every call via refresh_queue_from_store().
# Because the store was always authoritative, the list carried no information
# of its own — but it created two real problems:
#
#   1. NON-ATOMIC DEQUEUE: dequeue_job() removed a job from the local list
#      while its status in the store remained "queued" until the worker later
#      called mark_job_running(). Any concurrent worker (thread OR separate
#      process) refreshing from the store in that window would re-discover the
#      job and dequeue it again -> duplicate processing.
#
#   2. STATE DRIFT: two sources of truth that had to be defended against each
#      other in multiple places (dead "clear()" branch, redundant existence
#      checks, 2-3 load_jobs() calls per operation).
#
# This version deletes the in-memory list entirely. The job store IS the
# queue: a job is "queued" iff its persisted status is JOB_STATUS_QUEUED.
# dequeue_job() now CLAIMS the job atomically — it transitions the job to
# JOB_STATUS_RUNNING inside a cross-process lock before returning it — so a
# job can be handed to exactly one worker. This also means the queue trivially
# survives process restarts: anything persisted as "queued" is picked up.
#
# Ordering is unchanged: ascending (priority, created_at) — i.e. LOWER
# priority number is served first, ties broken oldest-first (FIFO). job_id is
# appended as a final tie-breaker so ordering is fully deterministic.
# ---------------------------------------------------------------------------

# Cross-process lock file guarding the dequeue critical section
# (read store -> pick job -> flip status). Lives next to this module by
# default; override with ORCHESTRATION_QUEUE_LOCK_PATH if the package
# directory is read-only in your deployment.
_LOCK_PATH = Path(
    os.environ.get(
        "ORCHESTRATION_QUEUE_LOCK_PATH",
        str(Path(__file__).resolve().parent / ".queue.lock"),
    )
)

# In-process lock: cheaper than the file lock for threads within one process,
# and required anyway because fcntl/msvcrt locks are per-process, not
# per-thread.
_thread_lock = threading.Lock()

try:
    import fcntl  # POSIX

    def _flock(fh) -> None:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)

    def _funlock(fh) -> None:
        fcntl.flock(fh.fileno(), fcntl.LOCK_UN)

except ImportError:  # Windows
    import msvcrt

    def _flock(fh) -> None:
        msvcrt.locking(fh.fileno(), msvcrt.LK_LOCK, 1)

    def _funlock(fh) -> None:
        fh.seek(0)
        msvcrt.locking(fh.fileno(), msvcrt.LK_UNLCK, 1)


@contextmanager
def _dequeue_lock() -> Iterator[None]:
    """Serialize the select-and-claim critical section across threads and
    processes on this machine."""
    with _thread_lock:
        _LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(_LOCK_PATH, "a+") as fh:
            _flock(fh)
            try:
                yield
            finally:
                _funlock(fh)


def _sort_key(job: OrchestrationJob):
    """Return the canonical Universal Queue priority ordering key."""
    created_at = (
        job.created_at.isoformat()
        if hasattr(job.created_at, "isoformat")
        else str(job.created_at)
    )

    return universal_queue_priority_sort_key(
        priority=job.priority,
        created_at=created_at,
        job_id=job.job_id,
    )


def _canonical_scheduled_at(
    job: OrchestrationJob,
) -> str | None:
    """
    Read scheduled_at from the canonical Universal Job projection.

    Legacy jobs without a canonical projection remain immediate.
    A malformed canonical projection fails closed.
    """
    metadata = (
        job.metadata
        if isinstance(job.metadata, dict)
        else {}
    )

    projections = [
        value
        for value in metadata.values()
        if (
            isinstance(value, dict)
            and "canonical_job" in value
        )
    ]

    if not projections:
        return None

    if len(projections) != 1:
        raise ValueError(
            "Expected exactly one canonical job projection."
        )

    canonical_job = projections[0].get(
        "canonical_job"
    )

    if not isinstance(canonical_job, dict):
        raise ValueError(
            "Canonical job projection is malformed."
        )

    projected_job_id = str(
        canonical_job.get("job_id")
        or ""
    ).strip()

    if projected_job_id != job.job_id:
        raise ValueError(
            "Canonical and orchestration job identities differ."
        )

    scheduled_at = canonical_job.get(
        "scheduled_at"
    )

    if scheduled_at is None:
        return None

    if not isinstance(scheduled_at, str):
        raise ValueError(
            "scheduled_at must be a string or None."
        )

    scheduled_at = scheduled_at.strip()

    if not scheduled_at:
        raise ValueError(
            "scheduled_at must not be blank."
        )

    return scheduled_at


def _is_job_time_eligible(
    job: OrchestrationJob,
    *,
    evaluation_time: str,
) -> bool:
    """Fail closed when canonical scheduling evidence is invalid."""
    try:
        return is_universal_queue_time_eligible(
            scheduled_at=_canonical_scheduled_at(
                job
            ),
            evaluation_time=evaluation_time,
        )
    except Exception:
        return False


def _canonical_dependency_job_ids(
    job: OrchestrationJob,
) -> tuple[str, ...]:
    """
    Read dependency_job_ids from the canonical Universal Job.

    Legacy jobs without a canonical projection have no dependencies.
    Present but malformed dependency evidence fails closed.
    """
    metadata = (
        job.metadata
        if isinstance(job.metadata, dict)
        else {}
    )

    projections = [
        value
        for value in metadata.values()
        if (
            isinstance(value, dict)
            and "canonical_job" in value
        )
    ]

    if not projections:
        return ()

    if len(projections) != 1:
        raise ValueError(
            "Expected exactly one canonical job projection."
        )

    canonical_job = projections[0].get(
        "canonical_job"
    )

    if not isinstance(canonical_job, dict):
        raise ValueError(
            "Canonical job projection is malformed."
        )

    projected_job_id = str(
        canonical_job.get("job_id")
        or ""
    ).strip()

    if projected_job_id != job.job_id:
        raise ValueError(
            "Canonical and orchestration job identities differ."
        )

    raw_dependency_ids = canonical_job.get(
        "dependency_job_ids",
        [],
    )

    if not isinstance(
        raw_dependency_ids,
        (list, tuple),
    ):
        raise ValueError(
            "dependency_job_ids must be a list or tuple."
        )

    normalized = []
    seen = set()

    for raw_dependency_id in raw_dependency_ids:
        if not isinstance(
            raw_dependency_id,
            str,
        ):
            raise ValueError(
                "Every dependency job ID must be a string."
            )

        dependency_id = raw_dependency_id.strip()

        if (
            not dependency_id
            or any(
                character.isspace()
                for character in dependency_id
            )
        ):
            raise ValueError(
                "Dependency job ID is invalid."
            )

        if dependency_id == job.job_id:
            raise ValueError(
                "A job cannot depend on itself."
            )

        if dependency_id in seen:
            raise ValueError(
                "Duplicate dependency job ID."
            )

        seen.add(
            dependency_id
        )

        normalized.append(
            dependency_id
        )

    return tuple(
        normalized
    )


def _canonical_dependency_status(
    dependency: OrchestrationJob,
) -> str:
    """
    Project the live orchestration status into Universal Job status.

    Orchestration uses 'completed'; the Universal Job authority uses
    'succeeded'. Other shared status names pass through unchanged.
    """
    status = str(
        dependency.status
        or ""
    ).strip().lower()

    if status == "completed":
        return "succeeded"

    return status


def _are_job_dependencies_satisfied(
    job: OrchestrationJob,
    *,
    jobs: Dict[str, OrchestrationJob],
) -> bool:
    """
    Return True only when every declared dependency has succeeded.

    Missing, unresolved, terminally unsuccessful or malformed evidence
    fails closed and leaves the target job queued.
    """
    try:
        dependency_ids = (
            _canonical_dependency_job_ids(
                job
            )
        )

        if not dependency_ids:
            return True

        for dependency_id in dependency_ids:
            dependency = jobs.get(
                dependency_id
            )

            if dependency is None:
                return False

            if (
                dependency.workspace_id
                != job.workspace_id
            ):
                return False

            classification = (
                classify_universal_orchestration_dependency_status(
                    _canonical_dependency_status(
                        dependency
                    )
                )
            )

            if (
                classification.value
                != "satisfied"
            ):
                return False

        return True

    except Exception:
        return False

def _queued_jobs(
    jobs: Optional[
        Dict[str, OrchestrationJob]
    ] = None,
    *,
    evaluation_time: str | None = None,
) -> List[OrchestrationJob]:
    """
    Return queued and time-eligible jobs in canonical service order.
    """
    if jobs is None:
        jobs = load_jobs()

    if evaluation_time is None:
        evaluation_time = datetime.now(
            timezone.utc
        ).isoformat()

    queued = [
        job
        for job in jobs.values()
        if (
            job.status == JOB_STATUS_QUEUED
            and _is_job_time_eligible(
                job,
                evaluation_time=evaluation_time,
            )
            and _are_job_dependencies_satisfied(
                job,
                jobs=jobs,
            )
        )
    ]

    queued.sort(
        key=_sort_key
    )

    return queued


def enqueue_job(job_id: str) -> bool:
    """Kept for API compatibility.

    Enqueueing is now implicit: create_job persists the job with status
    JOB_STATUS_QUEUED, and that persisted status is the queue membership.
    This function only verifies the job actually exists in a queued state,
    which catches caller bugs (e.g. enqueueing an ID that was never created).
    """
    job = get_job(job_id)
    return job is not None and job.status == JOB_STATUS_QUEUED


def dequeue_job(worker_id: str | None = None) -> Optional[OrchestrationJob]:
    """Atomically claim and return the highest-priority queued job.

    The returned job has ALREADY been transitioned to JOB_STATUS_RUNNING
    (with claim metadata) under a cross-process lock, so no other worker
    can receive the same job. Returns None when nothing is queued.

    Workers may still call mark_job_running() afterwards; with the
    corrected service.py that call is idempotent.
    """
    with _dequeue_lock():
        for candidate in _queued_jobs():
            metadata: Dict[str, object] = {"claimed_by_dequeue": True}
            if worker_id:
                metadata["worker_id"] = worker_id
            try:
                claimed = update_job_status(
                    candidate.job_id,
                    JOB_STATUS_RUNNING,
                    metadata=metadata,
                )
            except Exception:
                # Job vanished or store hiccuped between read and write —
                # skip it and try the next candidate rather than failing
                # the whole dequeue.
                continue
            return claimed
        return None


def queue_length() -> int:
    return len(_queued_jobs())


def refresh_queue_from_store() -> None:
    """Kept for API compatibility.

    There is no longer any in-memory queue state to refresh — every read
    goes straight to the job store — so this is a no-op.
    """
    return None


def queue_snapshot() -> Dict[str, object]:
    queued = _queued_jobs()

    return {
        "queue_length": len(queued),
        "queued_job_ids": [job.job_id for job in queued],
        "queued_jobs": [
            {
                "job_id": job.job_id,
                "workspace_id": job.workspace_id,
                "job_type": job.job_type,
                "priority": job.priority,
                "created_at": (
                    job.created_at.isoformat()
                    if hasattr(job.created_at, "isoformat")
                    else str(job.created_at)
                ),
            }
            for job in queued
        ],
    }


def is_job_queued(job_id: str) -> bool:
    job = get_job(job_id)
    return job is not None and job.status == JOB_STATUS_QUEUED