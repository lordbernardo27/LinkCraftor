{
  "template_id": "single_document_processing_v1",
  "template_name": "Single Document Processing",
  "template_type": "document_pipeline",
  "workspace_aware": true,
  "steps": [
    {
      "step_id": "upload",
      "worker": "upload_worker",
      "action": "store_upload"
    },
    {
      "step_id": "extract",
      "worker": "extraction_worker",
      "action": "extract_phrases"
    },
    {
      "step_id": "score",
      "worker": "scoring_worker",
      "action": "score_candidates"
    },
    {
      "step_id": "active_pool",
      "worker": "pool_worker",
      "action": "build_active_pool"
    },
    {
      "step_id": "highlight_selection",
      "worker": "highlight_worker",
      "action": "select_highlights"
    },
    {
      "step_id": "runtime",
      "worker": "runtime_worker",
      "action": "process_runtime"
    },
    {
      "step_id": "export",
      "worker": "export_worker",
      "action": "export_document"
    }
  ],
  "required_inputs": [
    "workspace_id",
    "document_id",
    "document_path"
  ],
  "outputs": [
    "highlighted_document",
    "runtime_results",
    "export_path"
  ],
  "retry_policy": {
    "max_retries": 3,
    "retry_delay_seconds": 5
  },
  "failure_handling": {
    "continue_on_noncritical_failure": false,
    "store_failure_snapshot": true
  }
}