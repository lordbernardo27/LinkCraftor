{
  "template_id": "batch_document_processing_v1",
  "template_name": "Batch Document Processing",
  "template_type": "batch_document_pipeline",
  "workspace_aware": true,
  "steps": [
    {
      "step_id": "batch_upload",
      "worker": "upload_worker",
      "action": "store_batch_upload"
    },
    {
      "step_id": "validate_batch",
      "worker": "batch_worker",
      "action": "validate_batch_inputs"
    },
    {
      "step_id": "split_documents",
      "worker": "batch_worker",
      "action": "split_batch_into_document_jobs"
    },
    {
      "step_id": "process_documents",
      "worker": "document_pipeline_worker",
      "action": "run_single_document_template_for_each_document",
      "template_ref": "single_document_processing_v1"
    },
    {
      "step_id": "collect_results",
      "worker": "batch_worker",
      "action": "collect_document_results"
    },
    {
      "step_id": "batch_summary",
      "worker": "batch_worker",
      "action": "build_batch_summary"
    },
    {
      "step_id": "batch_export",
      "worker": "export_worker",
      "action": "export_batch_package"
    }
  ],
  "required_inputs": [
    "workspace_id",
    "batch_id",
    "document_ids",
    "batch_upload_path"
  ],
  "outputs": [
    "document_results",
    "batch_summary",
    "batch_export_path"
  ],
  "retry_policy": {
    "max_retries": 3,
    "retry_delay_seconds": 10,
    "retry_individual_failed_documents": true
  },
  "failure_handling": {
    "continue_on_noncritical_failure": true,
    "store_failure_snapshot": true,
    "mark_failed_documents_individually": true
  }
}