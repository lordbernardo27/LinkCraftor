{
  "template_id": "tms_ticket_event_v1",
  "template_name": "TMS Ticket Event",
  "template_type": "tms_event_pipeline",
  "workspace_aware": true,
  "steps": [
    {
      "step_id": "receive_event",
      "worker": "tms_worker",
      "action": "receive_ticket_event"
    },
    {
      "step_id": "validate_event",
      "worker": "validation_worker",
      "action": "validate_tms_event"
    },
    {
      "step_id": "classify_event",
      "worker": "classification_worker",
      "action": "classify_tms_event"
    },
    {
      "step_id": "route_workflow",
      "worker": "routing_worker",
      "action": "route_tms_workflow"
    },
    {
      "step_id": "update_ticket",
      "worker": "tms_worker",
      "action": "update_ticket_state"
    },
    {
      "step_id": "send_notifications",
      "worker": "notification_worker",
      "action": "send_tms_notifications"
    },
    {
      "step_id": "event_summary",
      "worker": "summary_worker",
      "action": "build_tms_event_summary"
    }
  ],
  "required_inputs": [
    "workspace_id",
    "ticket_id",
    "event_type"
  ],
  "outputs": [
    "ticket_update",
    "notification_results",
    "event_summary"
  ],
  "retry_policy": {
    "max_retries": 5,
    "retry_delay_seconds": 10
  },
  "failure_handling": {
    "continue_on_noncritical_failure": true,
    "store_failure_snapshot": true
  }
}