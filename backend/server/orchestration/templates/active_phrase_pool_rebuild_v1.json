{
  "template_id": "active_phrase_pool_rebuild_v1",
  "template_name": "Active Phrase Pool Rebuild",
  "template_type": "active_pool_rebuild",
  "workspace_aware": true,
  "pool_type": "active_phrase_pool",
  "steps": [
    {
      "step_id": "load_upload_pool",
      "worker": "pool_worker",
      "action": "load_upload_phrase_pool"
    },
    {
      "step_id": "load_supporting_intelligence",
      "worker": "intelligence_worker",
      "action": "load_supporting_pools"
    },
    {
      "step_id": "merge_candidates",
      "worker": "pool_worker",
      "action": "merge_active_candidates"
    },
    {
      "step_id": "apply_quality_thresholds",
      "worker": "quality_worker",
      "action": "apply_quality_thresholds"
    },
    {
      "step_id": "suppress_duplicates",
      "worker": "semantic_worker",
      "action": "suppress_semantic_duplicates"
    },
    {
      "step_id": "build_active_pool",
      "worker": "pool_worker",
      "action": "build_active_phrase_pool"
    },
    {
      "step_id": "update_active_membership",
      "worker": "pool_worker",
      "action": "update_active_membership"
    },
    {
      "step_id": "rebuild_summary",
      "worker": "summary_worker",
      "action": "build_active_pool_summary"
    }
  ],
  "required_inputs": [
    "workspace_id",
    "document_ids"
  ],
  "outputs": [
    "active_phrase_pool",
    "active_membership",
    "rebuild_summary"
  ],
  "retry_policy": {
    "max_retries": 3,
    "retry_delay_seconds": 5
  },
  "failure_handling": {
    "continue_on_noncritical_failure": false,
    "store_failure_snapshot": true
  }
}