{
  "template_id": "live_domain_sync_v1",
  "template_name": "Live-Domain Sync",
  "template_type": "live_domain_sync",
  "workspace_aware": true,
  "steps": [
    {
      "step_id": "load_workspace_domain",
      "worker": "domain_worker",
      "action": "load_workspace_domain"
    },
    {
      "step_id": "fetch_sitemap",
      "worker": "sync_worker",
      "action": "fetch_sitemap_data"
    },
    {
      "step_id": "validate_domain_sources",
      "worker": "validation_worker",
      "action": "validate_live_domain_sources"
    },
    {
      "step_id": "extract_live_domain_data",
      "worker": "extraction_worker",
      "action": "extract_live_domain_titles_urls_headings"
    },
    {
      "step_id": "build_live_domain_pool",
      "worker": "pool_worker",
      "action": "build_live_domain_pool"
    },
    {
      "step_id": "build_live_domain_target_pool",
      "worker": "target_pool_worker",
      "action": "build_live_domain_target_pool"
    },
    {
      "step_id": "update_membership",
      "worker": "pool_worker",
      "action": "update_live_domain_membership"
    },
    {
      "step_id": "sync_summary",
      "worker": "summary_worker",
      "action": "build_live_domain_sync_summary"
    }
  ],
  "required_inputs": [
    "workspace_id",
    "domain"
  ],
  "outputs": [
    "live_domain_pool",
    "live_domain_target_pool",
    "membership_updates",
    "sync_summary"
  ],
  "retry_policy": {
    "max_retries": 3,
    "retry_delay_seconds": 15
  },
  "failure_handling": {
    "continue_on_noncritical_failure": false,
    "store_failure_snapshot": true
  }
}