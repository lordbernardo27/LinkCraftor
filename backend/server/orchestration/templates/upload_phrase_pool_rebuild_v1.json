{
  "template_id": "upload_phrase_pool_rebuild_v1",
  "template_name": "Upload Phrase Pool Rebuild",
  "template_type": "phrase_pool_rebuild",
  "workspace_aware": true,
  "pool_type": "upload_phrase_pool",
  "steps": [
    {
      "step_id": "load_documents",
      "worker": "document_worker",
      "action": "load_workspace_documents"
    },
    {
      "step_id": "extract_phrases",
      "worker": "extraction_worker",
      "action": "extract_candidates"
    },
    {
      "step_id": "validate_candidates",
      "worker": "validation_worker",
      "action": "validate_candidates"
    },
    {
      "step_id": "score_candidates",
      "worker": "scoring_worker",
      "action": "score_candidates"
    },
    {
      "step_id": "build_upload_pool",
      "worker": "pool_worker",
      "action": "build_upload_phrase_pool"
    },
    {
      "step_id": "update_membership",
      "worker": "pool_worker",
      "action": "update_upload_pool_membership"
    },
    {
      "step_id": "rebuild_summary",
      "worker": "summary_worker",
      "action": "build_rebuild_summary"
    }
  ],
  "required_inputs": [
    "workspace_id",
    "document_ids"
  ],
  "outputs": [
    "upload_phrase_pool",
    "membership_updates",
    "rebuild_summary"
  ],
  "retry_policy": {
    "max_retries": 3,
    "retry_delay_seconds": 5
  },
  "failure_handling": {
    "continue_on_noncritical_failure": false,
    "store_failure_snapshot": true
  }
}