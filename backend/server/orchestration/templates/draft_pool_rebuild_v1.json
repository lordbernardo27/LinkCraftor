{
  "template_id": "draft_pool_rebuild_v1",
  "template_name": "Draft Pool Rebuild",
  "template_type": "draft_pool_rebuild",
  "workspace_aware": true,
  "pool_type": "draft_pool",
  "steps": [
    {
      "step_id": "load_drafts",
      "worker": "draft_worker",
      "action": "load_workspace_drafts"
    },
    {
      "step_id": "extract_draft_candidates",
      "worker": "extraction_worker",
      "action": "extract_draft_candidates"
    },
    {
      "step_id": "validate_draft_candidates",
      "worker": "validation_worker",
      "action": "validate_draft_candidates"
    },
    {
      "step_id": "score_draft_candidates",
      "worker": "scoring_worker",
      "action": "score_draft_candidates"
    },
    {
      "step_id": "build_draft_pool",
      "worker": "pool_worker",
      "action": "build_draft_pool"
    },
    {
      "step_id": "update_draft_membership",
      "worker": "pool_worker",
      "action": "update_draft_membership"
    },
    {
      "step_id": "draft_summary",
      "worker": "summary_worker",
      "action": "build_draft_pool_summary"
    }
  ],
  "required_inputs": [
    "workspace_id",
    "draft_ids"
  ],
  "outputs": [
    "draft_pool",
    "draft_membership",
    "rebuild_summary"
  ],
  "retry_policy": {
    "max_retries": 3,
    "retry_delay_seconds": 5
  },
  "failure_handling": {
    "continue_on_noncritical_failure": false,
    "store_failure_snapshot": true
  }
}