{
  "template_id": "imported_pool_rebuild_v1",
  "template_name": "Imported Pool Rebuild",
  "template_type": "imported_pool_rebuild",
  "workspace_aware": true,
  "pool_type": "imported_pool",
  "steps": [
    {
      "step_id": "load_import_sources",
      "worker": "import_worker",
      "action": "load_import_sources"
    },
    {
      "step_id": "validate_import_records",
      "worker": "validation_worker",
      "action": "validate_import_records"
    },
    {
      "step_id": "extract_import_candidates",
      "worker": "extraction_worker",
      "action": "extract_import_candidates"
    },
    {
      "step_id": "score_import_candidates",
      "worker": "scoring_worker",
      "action": "score_import_candidates"
    },
    {
      "step_id": "build_imported_pool",
      "worker": "pool_worker",
      "action": "build_imported_pool"
    },
    {
      "step_id": "update_imported_membership",
      "worker": "pool_worker",
      "action": "update_imported_membership"
    },
    {
      "step_id": "import_summary",
      "worker": "summary_worker",
      "action": "build_imported_pool_summary"
    }
  ],
  "required_inputs": [
    "workspace_id",
    "import_source_ids"
  ],
  "outputs": [
    "imported_pool",
    "imported_membership",
    "rebuild_summary"
  ],
  "retry_policy": {
    "max_retries": 3,
    "retry_delay_seconds": 5
  },
  "failure_handling": {
    "continue_on_noncritical_failure": false,
    "store_failure_snapshot": true
  }
}