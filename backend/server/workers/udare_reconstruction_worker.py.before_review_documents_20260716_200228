        "job_type":
            UDARE_JOB_TYPE,

        "pipeline":
            UDARE_PIPELINE,

        "source_store":
            UDARE_SOURCE_STORE,

        "engine":
            UDARE_ENGINE,

        "article_document_format":
            UDARE_ARTICLE_FORMAT,

        "target_store":
            UDARE_TARGET_STORE,

        "requires_explicit_execution_authorization":
            True,

        "requires_explicit_store_authorization":
            True,

        "reconstructs_each_job_once":
            True,

        "batch_population_created":
            False,
    }
