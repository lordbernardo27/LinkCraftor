def _as_mapping_v1(
    value: Any,
    *,
    name: str,
) -> Mapping[str, Any]:
    if not isinstance(
        value,
        Mapping,
    ):
        raise UdareWorkerError(
            f"{name} must be a mapping."
        )

    return value


def _normalize_raw_record_v1(
    value: Any,
) -> Mapping[str, Any]:
    record = _as_mapping_v1(
        value,
        name="Raw HTML record",
    )

    nested_record = record.get(
        "record"
    )

    if isinstance(
        nested_record,
        Mapping,
    ):
        return nested_record

    nested_result = record.get(
        "result"
    )

    if isinstance(
        nested_result,
        Mapping,
    ):
        return nested_result

    return record


def _first_non_empty_v1(
    source: Mapping[str, Any],
    fields: tuple[str, ...],
) -> str:
    for field in fields:
        value = source.get(
            field
        )

        if value is None:
            continue

        text = str(
            value
        )

        if text.strip():
            return text

    return ""


def _heading_values_v1(
    reconstruction: Mapping[str, Any],
) -> list[str]:
    values: list[str] = []

    raw_headings = reconstruction.get(
        "headings"
    )

    if not isinstance(
        raw_headings,
        list,
    ):
        return values

    for heading in raw_headings:
        if isinstance(
            heading,
            Mapping,
        ):
            text = str(
                heading.get(
                    "text"
                )
                or ""
            ).strip()

        else:
            text = str(
                heading or ""
            ).strip()

        if text:
            values.append(
                text
            )

    return values


def _safe_status_update_v1(
    updater: Callable[..., Any],
    *,
    workspace_id: str,
    job_id: str,
    status: str,
    message: str,
    result: Mapping[str, Any] | None = None,
    error: str = "",
) -> Any:
    return _call_by_signature_v1(
        updater,
        {
            "workspace_id":
                workspace_id,

            "tenant_id":
                workspace_id,

            "job_id":
                job_id,

            "id":
                job_id,

            "status":
                status,

            "new_status":
                status,

            "state":
                status,

            "message":
                message,

            "result":
                dict(
                    result
                    or {}
                ),

            "error":
                error,

            "error_info":
                error,
        },
    )


