def run_udare_reconstruction_job_v1(
    *,
    job: Mapping[str, Any],
    raw_record_loader: Callable[..., Any] | None = None,
    reconstruction_engine: Callable[..., Any] | None = None,
    document_builder: Callable[..., Any] | None = None,
    store_persister: Callable[..., Any] | None = None,
    manifest_refresher: Callable[..., Any] | None = None,
    status_updater: Callable[..., Any] | None = None,
    progress_updater: Callable[..., Any] | None = None,
    failure_recorder: Callable[..., Any] | None = None,
    concurrency_checker: Callable[..., Any] | None = None,
) -> Dict[str, Any]:
    """
    Execute exactly one authorized UDARE reconstruction job.

    The handler reads one Raw HTML record, reconstructs it once,
    builds one complete HTML reader document, and persists that
    document to the UDARE Store.

    Batch population and queue creation are outside this function.
    """

    job_mapping = _as_mapping_v1(
        job,
        name="job",
    )

    job_type = str(
        job_mapping.get(
            "job_type"
        )
        or job_mapping.get(
            "stage"
        )
        or ""
    ).strip()

    if job_type != UDARE_JOB_TYPE:
        raise UdareWorkerError(
            "The UDARE worker received an unsupported job type: "
            + repr(
                job_type
            )
        )

    payload = _as_mapping_v1(
        job_mapping.get(
            "payload"
        )
        or {},
        name="job payload",
    )

    workspace_id = str(
        job_mapping.get(
            "workspace_id"
        )
        or payload.get(
            "workspace_id"
        )
        or ""
    ).strip()

    job_id = str(
        job_mapping.get(
            "job_id"
        )
        or ""
    ).strip()

    source_record_id = str(
        payload.get(
            "source_record_id"
        )
        or ""
    ).strip()

    html_id = str(
        payload.get(
            "html_id"
        )
        or ""
    ).strip()

    payload_source_url = str(
        payload.get(
            "source_url"
        )
        or ""
    ).strip()

    required_identity = {
        "workspace_id":
            workspace_id,

        "job_id":
            job_id,

        "source_record_id":
            source_record_id,

        "html_id":
            html_id,

        "source_url":
            payload_source_url,
    }

    missing_identity = [
        name

        for name, value
        in required_identity.items()

        if not value
    ]

    if missing_identity:
        raise UdareWorkerError(
            "Incomplete UDARE job identity: "
            + ", ".join(
                missing_identity
            )
        )

    expected_values = {
        "pipeline": (
            str(
                job_mapping.get(
                    "pipeline"
                )
                or payload.get(
                    "pipeline"
                )
                or UDARE_PIPELINE
            )
        ),

        "stage": (
            str(
                job_mapping.get(
                    "stage"
                )
                or job_type
            )
        ),

        "source_store_version": (
            str(
                payload.get(
                    "source_store_version"
                )
                or ""
            )
        ),

        "udare_engine": (
            str(
                payload.get(
                    "udare_engine"
                )
                or ""
            )
        ),

        "target_store": (
            str(
                payload.get(
                    "target_store"
                )
                or ""
            )
        ),

        "article_document_format": (
            str(
                payload.get(
                    "article_document_format"
                )
                or ""
            )
        ),
    }

    exact_contract = {
        "pipeline":
            UDARE_PIPELINE,

        "stage":
            UDARE_JOB_TYPE,

        "source_store_version":
            UDARE_SOURCE_STORE,

        "udare_engine":
            UDARE_ENGINE,

        "target_store":
            UDARE_TARGET_STORE,

        "article_document_format":
            UDARE_ARTICLE_FORMAT,
    }

    mismatches = [
        (
            f"{name}={expected_values[name]!r}; "
            f"expected {expected!r}"
        )

        for name, expected
        in exact_contract.items()

        if expected_values[
            name
        ]
        != expected
    ]

    if mismatches:
        raise UdareWorkerError(
            "UDARE job contract mismatch: "
            + "; ".join(
                mismatches
            )
        )

    execution_controls = payload.get(
        "execution_controls"
    )

    if not isinstance(
        execution_controls,
        Mapping,
    ):
        raise UdareWorkerError(
            "UDARE execution_controls are missing."
        )

    if (
        execution_controls.get(
            "execute_now"
        )
        is not True
    ):
        raise UdareWorkerError(
            "UDARE execution is not authorized for this job."
        )

    if (
        execution_controls.get(
            "store_population_allowed"
        )
        is not True
    ):
        raise UdareWorkerError(
            "UDARE Store population is not authorized for this job."
        )

    raw_record_loader = (
        raw_record_loader
        or _default_raw_record_loader_v1
    )

    reconstruction_engine = (
        reconstruction_engine
        or _default_reconstruction_engine_v1
    )

    document_builder = (
        document_builder
        or _default_document_builder_v1
    )

    store_persister = (
        store_persister
        or _default_store_persister_v1
    )

    manifest_refresher = (
        manifest_refresher
        or _default_manifest_refresher_v1
    )

    status_updater = (
        status_updater
        or _default_status_updater_v1
    )

    progress_updater = (
        progress_updater
        or _default_progress_updater_v1
    )

    failure_recorder = (
        failure_recorder
        or _default_failure_recorder_v1
    )

    concurrency_checker = (
        concurrency_checker
        or _default_concurrency_checker_v1
    )

    max_running = int(
        execution_controls.get(
            "workspace_max_running"
        )
        or 5
    )

    attempt = int(
        job_mapping.get(
            "attempt_count"
        )
        or job_mapping.get(
            "attempts"
        )
        or 0
    )

    batch_id = str(
        job_mapping.get(
            "batch_id"
        )
        or ""
    )

    try:
        concurrency = _call_by_signature_v1(
            concurrency_checker,
            {
                "workspace_id":
                    workspace_id,

                "tenant_id":
                    workspace_id,

                "max_running":
                    max_running,

                "limit":
                    max_running,
            },
        )

        concurrency_mapping = (
            concurrency
            if isinstance(
                concurrency,
                Mapping,
            )
            else {}
        )

        if (
            concurrency_mapping.get(
                "can_start_new_job"
            )
            is False
        ):
            return {
                "ok":
                    False,

                "status":
                    "throttled",

                "worker":
                    WORKER_NAME,

                "workspace_id":
                    workspace_id,

                "job_id":
                    job_id,

                "concurrency":
                    dict(
                        concurrency_mapping
                    ),
            }

        _safe_status_update_v1(
            status_updater,
            workspace_id=
                workspace_id,

            job_id=
                job_id,

            status=
                "running",

            message=
                "UDARE reconstruction worker started.",
        )

        _safe_progress_update_v1(
            progress_updater,
            workspace_id=
                workspace_id,

            job_id=
                job_id,

            percent=
                10,

            message=
                "Loading Raw HTML record.",

            step=
                "load_raw_html",
        )

        raw_result = _call_by_signature_v1(
            raw_record_loader,
            {
                "workspace_id":
                    workspace_id,

                "tenant_id":
                    workspace_id,

                "html_id":
                    html_id,

                "record_id":
                    source_record_id,

                "source_record_id":
                    source_record_id,
            },
        )

        if raw_result is None:
            raise UdareWorkerError(
                "Raw HTML record was not found: "
                + source_record_id
            )

        raw_record = _normalize_raw_record_v1(
            raw_result
        )

        raw_html = _first_non_empty_v1(
            raw_record,
            (
                "raw_html",
                "html",
                "html_text",
                "source_html",
                "content",
            ),
        )

        if not raw_html:
            raise UdareWorkerError(
                "Raw HTML record contains no HTML document."
            )

        record_url = _first_non_empty_v1(
            raw_record,
            (
                "source_url",
                "url",
                "canonical_url",
                "final_url",
            ),
        )

        source_url = (
            record_url
            or payload_source_url
        )

        if (
            record_url
            and payload_source_url
            and record_url
            != payload_source_url
        ):
            raise UdareWorkerError(
                "Raw HTML record URL does not match "
                "the queued UDARE payload URL."
            )

        source_title = _first_non_empty_v1(
            raw_record,
            (
                "title",
                "page_title",
                "source_title",
            ),
        )

        _safe_progress_update_v1(
            progress_updater,
            workspace_id=
                workspace_id,

            job_id=
                job_id,

            percent=
                35,

            message=
                "Running UDARE v1.7 reconstruction.",

            step=
                "reconstruct_article",
        )

        reconstruction_result = (
            _call_by_signature_v1(
                reconstruction_engine,
                {
                    "html_text":
                        raw_html,

                    "raw_html":
                        raw_html,

                    "source_html":
                        raw_html,

                    "source_url":
                        source_url,

                    "url":
                        source_url,

                    "title":
                        source_title,

                    "metadata": {
                        "workspace_id":
                            workspace_id,

                        "job_id":
                            job_id,

                        "source_record_id":
                            source_record_id,

                        "html_id":
                            html_id,

                        "correlation_id":
                            str(
                                payload.get(
                                    "correlation_id"
                                )
                                or ""
                            ),
                    },
                },
            )
        )

        reconstruction = _as_mapping_v1(
            reconstruction_result,
            name="UDARE reconstruction result",
        )

        if reconstruction.get(
            "ok"
        ) is not True:
            raise UdareWorkerError(
                "UDARE reconstruction returned ok=False."
            )

        if (
            str(
                reconstruction.get(
                    "engine"
                )
                or ""
            )
            != UDARE_ENGINE
        ):
            raise UdareWorkerError(
                "UDARE reconstruction returned an "
                "unexpected engine version."
            )

        document_id = (
            source_record_id
            or html_id
        )

        _safe_progress_update_v1(
            progress_updater,
            workspace_id=
                workspace_id,

            job_id=
                job_id,

            percent=
                60,

            message=
                "Building complete UDARE article document.",

            step=
                "build_article_document",
        )

        builder_result = _call_by_signature_v1(
            document_builder,
            {
                "reconstruction":
                    reconstruction,

                "source_url":
                    source_url,

                "url":
                    source_url,

                "document_id":
                    document_id,

                "html_id":
                    html_id,
            },
        )

        built_document = _as_mapping_v1(
            builder_result,
            name="UDARE article-document result",
        )

        if built_document.get(
            "ok"
        ) is not True:
            raise UdareWorkerError(
                "UDARE article-document builder returned ok=False."
            )

        if (
            str(
                built_document.get(
                    "article_document_format"
                )
                or ""
            )
            != UDARE_ARTICLE_FORMAT
        ):
            raise UdareWorkerError(
                "UDARE article-document format mismatch."
            )

        article_document = built_document.get(
            "article_document_bytes"
        )

        if article_document is None:
            article_document = built_document.get(
                "article_document"
            )

        if article_document is None:
            raise UdareWorkerError(
                "The UDARE builder returned no article document."
            )

        _safe_progress_update_v1(
            progress_updater,
            workspace_id=
                workspace_id,

            job_id=
                job_id,

            percent=
                80,

            message=
                "Persisting article in the UDARE Store.",

            step=
                "persist_udare_article",
        )

        selected_root = reconstruction.get(
            "selected_root"
        )

        selected_tag = (
            str(
                selected_root.get(
                    "tag"
                )
                or ""
            )
            if isinstance(
                selected_root,
                Mapping,
            )
            else ""
        )

        persistence_result = _call_by_signature_v1(
            store_persister,
            {
                "workspace_id":
                    workspace_id,

                "document_id":
                    document_id,

                "html_id":
                    html_id,

                "source_url":
                    source_url,

                "title":
                    str(
                        reconstruction.get(
                            "title"
                        )
                        or built_document.get(
                            "title"
                        )
                        or source_title
                        or ""
                    ),

                "h1":
                    str(
                        reconstruction.get(
                            "h1"
                        )
                        or built_document.get(
                            "h1"
                        )
                        or ""
                    ),

                "headings":
                    _heading_values_v1(
                        reconstruction
                    ),

                "article_document":
                    article_document,

                "udare_engine":
                    UDARE_ENGINE,

                "source_store_version":
                    UDARE_SOURCE_STORE,

                "source_record_id":
                    source_record_id,

                "reconstruction_status":
                    "completed",

                "selected_tag":
                    selected_tag,

                "udare_article_body_sha256":
                    str(
                        built_document.get(
                            "article_body_sha256"
                        )
                        or ""
                    ),

                "content_block_count":
                    int(
                        built_document.get(
                            "content_block_count"
                        )
                        or len(
                            reconstruction.get(
                                "content_blocks"
                            )
                            or []
                        )
                    ),

                "job_id":
                    job_id,

                "batch_id":
                    batch_id,

                "attempt":
                    attempt,

                "operational_metadata": {
                    "worker":
                        WORKER_NAME,

                    "pipeline":
                        UDARE_PIPELINE,

                    "stage":
                        UDARE_JOB_TYPE,

                    "builder":
                        str(
                            built_document.get(
                                "builder"
                            )
                            or ""
                        ),

                    "correlation_id":
                        str(
                            payload.get(
                                "correlation_id"
                            )
                            or ""
                        ),
                },

                "expected_document_sha256":
                    str(
                        built_document.get(
                            "article_document_sha256"
                        )
                        or ""
                    ),

                "allow_replace":
                    False,
            },
        )

        persisted = _as_mapping_v1(
            persistence_result,
            name="UDARE persistence result",
        )

        if persisted.get(
            "ok"
        ) is not True:
            raise UdareWorkerError(
                "UDARE Store persistence returned ok=False."
            )

        manifest_result = _call_by_signature_v1(
            manifest_refresher,
            {
                "workspace_id":
                    workspace_id,

                "tenant_id":
                    workspace_id,
            },
        )

        manifest = _as_mapping_v1(
            manifest_result,
            name="UDARE manifest refresh result",
        )

        if manifest.get(
            "ok"
        ) is not True:
            raise UdareWorkerError(
                "UDARE Store manifest refresh failed."
            )

        index_result = build_udare_store_index_v1(
            workspace_id
        )

        if (
            not isinstance(
                index_result,
                dict,
            )
            or index_result.get(
                "ok"
            )
            is not True
        ):
            raise UdareWorkerError(
                "UDARE Store index generation failed."
            )

        result_summary = {
            "ok":
                True,

            "status":
                "completed",

            "worker":
                WORKER_NAME,

            "pipeline":
                UDARE_PIPELINE,

            "stage":
                UDARE_JOB_TYPE,

            "workspace_id":
                workspace_id,

            "job_id":
                job_id,

            "document_id":
                document_id,

            "html_id":
                html_id,

            "source_record_id":
                source_record_id,

            "source_url":
                source_url,

            "udare_engine":
                UDARE_ENGINE,

            "article_document_format":
                UDARE_ARTICLE_FORMAT,

            "article_document_sha256":
                str(
                    persisted.get(
                        "document_sha256"
                    )
                    or built_document.get(
                        "article_document_sha256"
                    )
                    or ""
                ),

            "article_path":
                str(
                    persisted.get(
                        "article_path"
                    )
                    or ""
                ),

            "metadata_path":
                str(
                    persisted.get(
                        "metadata_path"
                    )
                    or ""
                ),

            "persistence_status":
                str(
                    persisted.get(
                        "status"
                    )
                    or ""
                ),

            "content_block_count":
                int(
                    built_document.get(
                        "content_block_count"
                    )
                    or 0
                ),

            "manifest_record_count":
                int(
                    manifest.get(
                        "record_count"
                    )
                    or 0
                ),

            "index_path":
                str(
                    index_result.get(
                        "index_path"
                    )
                    or ""
                ),

            "index_article_count":
                int(
                    index_result.get(
                        "article_count"
                    )
                    or 0
                ),

            "completed_at":
                _utc_now_v1(),
        }

        _safe_progress_update_v1(
            progress_updater,
            workspace_id=
                workspace_id,

            job_id=
                job_id,

            percent=
                100,

            message=
                "UDARE reconstruction job completed.",

            step=
                "completed",
        )

        _safe_status_update_v1(
            status_updater,
            workspace_id=
                workspace_id,

            job_id=
                job_id,

            status=
                "completed",

            message=
                "UDARE reconstruction job completed.",

            result=
                result_summary,
        )

        return result_summary

    except Exception as exc:
        error_message = (
            f"{type(exc).__name__}: {exc}"
        )

        try:
            _call_by_signature_v1(
                failure_recorder,
                {
                    "workspace_id":
                        workspace_id,

                    "tenant_id":
                        workspace_id,

                    "job_id":
                        job_id,

                    "id":
                        job_id,

                    "job_type":
                        UDARE_JOB_TYPE,

                    "stage":
                        UDARE_JOB_TYPE,

                    "error":
                        error_message,

                    "error_info":
                        error_message,

                    "payload":
                        dict(
                            payload
                        ),
                },
            )

        except Exception:
            try:
                _safe_status_update_v1(
                    status_updater,
                    workspace_id=
                        workspace_id,

                    job_id=
                        job_id,

                    status=
                        "failed",

                    message=
                        "UDARE reconstruction job failed.",

                    error=
                        error_message,
                )

            except Exception:
                pass

        raise


