def _is_weak_target_match(
    phrase_tokens: set[str],
    target_tokens: set[str],
    score: float,
) -> Tuple[bool, str]:

    overlap = phrase_tokens & target_tokens

    if not overlap:
        return True, "no_token_overlap"

    if len(overlap) == 1 and score < 120:
        return True, "single_weak_overlap"

    return False, ""



def _token_set_v1(value: str) -> set[str]:
    import re

    stop = {
        "the","a","an","and","or","to","of","in","on","for","with","by","from",
        "after","before","right","left","early","late","best","new","old","how",
        "what","why","when","where","can","does","do","is","are","was","were",
        "this","that","these","those","your","you","i","we","it","as","at"
    }

    return {
        t for t in re.findall(r"[a-z0-9]+", str(value or "").lower())
        if len(t) >= 3 and t not in stop
    }



def _intent_terms_v1(value: str) -> set[str]:
    base = _token_set_v1(value)

    groups = {
        "calculate": {"calculate", "calculator", "calculation", "estimate", "estimated", "estimator"},
        "compare": {"compare", "comparison", "versus", "vs"},
        "price": {"price", "pricing", "cost", "fee", "fees", "quote"},
        "buy": {"buy", "purchase", "order", "shop"},
        "review": {"review", "reviews", "rating", "ratings"},
        "symptom": {"symptom", "symptoms", "sign", "signs"},
        "treatment": {"treatment", "treat", "therapy", "medicine", "medication"},
        "guide": {"guide", "tips", "advice", "help"},
        "risk": {"risk", "risks", "chance", "chances"},
        "test": {"test", "testing", "screening", "scan", "exam"},
        "rule": {"rule", "rules", "policy", "policies", "requirement", "requirements"},
    }

    expanded = set(base)
    for canonical, terms in groups.items():
        if base.intersection(terms):
            expanded.add(canonical)
            expanded.update(terms)

    return expanded


def _topic_match_percent_v1(phrase: str, title: str, url: str) -> float:
    phrase_terms = _token_set_v1(phrase)
    if not phrase_terms:
        return 0.0

    target_terms = _token_set_v1(f"{title} {url}")
    overlap = phrase_terms.intersection(target_terms)

    return round((len(overlap) / max(1, len(phrase_terms))) * 100.0, 2)


def _intent_match_percent_v1(phrase: str, title: str, url: str) -> float:
    phrase_intent = _intent_terms_v1(phrase)
    if not phrase_intent:
        return 0.0

    target_intent = _intent_terms_v1(f"{title} {url}")
    overlap = phrase_intent.intersection(target_intent)

    return round((len(overlap) / max(1, len(phrase_intent))) * 100.0, 2)



def _universal_false_positive_gate_v1(
    *,
    phrase: str,
    title: str,
    url: str,
    resolver_decision: str,
    auto_link_allowed: bool,
    suggest_only: bool,
    runtime_normalized_score: float | None,
    source_type: str = "",
) -> dict:

    phrase_terms = _token_set_v1(phrase)
    target_terms = _token_set_v1(f"{title} {url}")

    overlap = phrase_terms.intersection(target_terms)
    overlap_count = len(overlap)

    topic_match_percent = _topic_match_percent_v1(phrase, title, url)
    intent_match_percent = _intent_match_percent_v1(phrase, title, url)

    score = float(runtime_normalized_score or 0.0)
    reasons = []

    if not str(url or "").strip():
        reasons.append("no_target_url")

    if str(source_type or "") == "live_domain" and overlap_count < 1:
        reasons.append("zero_topic_overlap")

    if str(source_type or "") == "live_domain" and score and score < 0.75:
        reasons.append("low_runtime_confidence")

    # Universal intent gate:
    # If the phrase has a clear action/intent token, target must share some intent evidence.
    # This prevents "calculate X" linking to generic "X advice" pages unless other evidence is strong.
    phrase_intent_terms = _intent_terms_v1(phrase)
    target_intent_terms = _intent_terms_v1(f"{title} {url}")
    intent_overlap_terms = phrase_intent_terms.intersection(target_intent_terms)

    if str(source_type or "") == "live_domain":
        strong_topic_match = topic_match_percent >= 66.0
        if phrase_intent_terms and not intent_overlap_terms and not strong_topic_match:
            reasons.append("intent_mismatch")

    if reasons:
        return {
            "resolver_decision": "NO_TARGET" if "no_target_url" in reasons else "SUGGEST_ONLY",
            "auto_link_allowed": False,
            "suggest_only": True,
            "false_positive_blocked": True,
            "false_positive_reasons": reasons,
            "topic_overlap_count": overlap_count,
            "topic_overlap_terms": sorted(overlap),
            "topic_match_percent": topic_match_percent,
            "intent_match_percent": intent_match_percent,
            "intent_overlap_terms": sorted(intent_overlap_terms) if "intent_overlap_terms" in locals() else [],
        }

    return {
        "resolver_decision": resolver_decision,
        "auto_link_allowed": bool(auto_link_allowed),
        "suggest_only": bool(suggest_only),
        "false_positive_blocked": False,
        "false_positive_reasons": [],
        "topic_overlap_count": overlap_count,
        "topic_overlap_terms": sorted(overlap),
        "topic_match_percent": topic_match_percent,
        "intent_match_percent": intent_match_percent,
        "intent_overlap_terms": sorted(intent_overlap_terms) if "intent_overlap_terms" in locals() else [],
    }



def _runtime_normalized_score(source_type: str, intelligence: Dict[str, Any], target_score: Any) -> float:
    try:
        raw = float(target_score or 0)
    except Exception:
        raw = 0.0

    if source_type in {"draft", "document_registry"}:
        return max(0.0, min(1.0, raw))

    # Live-domain/imported legacy scores commonly use larger numeric scales.
    if source_type in {"live_domain", "imported"}:
        return max(0.0, min(1.0, raw / 300.0))

    return max(0.0, min(1.0, raw))


def _meaningful_tokens(text: str) -> set[str]:
    stop = {
        "a", "an", "and", "are", "as", "at", "be", "by", "for", "from",
        "how", "in", "into", "is", "it", "of", "on", "or", "the", "to",
        "what", "when", "where", "why", "with", "your", "you"
    }
    tokens = re.findall(r"[a-z0-9]+", str(text or "").lower())
    return {_stem_token(t) for t in tokens if len(t) >= 3 and t not in stop}



