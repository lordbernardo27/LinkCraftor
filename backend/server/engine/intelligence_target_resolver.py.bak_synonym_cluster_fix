def _expanded_meaningful_tokens(text: Any) -> set[str]:
    base = _meaningful_tokens(str(text or ""))
    expanded = set(base)

    for group in _UNIVERSAL_SYNONYM_GROUPS:
        stems = {_stem_token(x) for x in group}
        if expanded & stems:
            expanded |= stems

    return expanded


def _detect_intent(text: Any) -> str:
    t = _norm_text(text)

    for intent, patterns in _UNIVERSAL_INTENT_PATTERNS.items():
        for pattern in patterns:
            if pattern in t:
                return intent

    return "informational"


def _intent_match_score(anchor_text: Any, target_text: Any, page_type: Any = "") -> float:
    anchor_intent = _detect_intent(anchor_text)
    target_intent = _detect_intent(" ".join([str(target_text or ""), str(page_type or "")]))

    if anchor_intent == target_intent and anchor_intent != "informational":
        return 1.0

    if anchor_intent != "informational" and anchor_intent in _norm_text(target_text):
        return 0.75

    if anchor_intent == "informational" and target_intent in {"guide", "definition", "research"}:
        return 0.45

    return 0.0


def _phrase_evidence_score(anchor_text: Any, target_text: Any, aliases: List[Any] | None = None) -> Dict[str, Any]:
    anchor_norm = _norm_text(anchor_text)
    target_norm = _norm_text(target_text)
    alias_texts = [_norm_text(x) for x in (aliases or []) if str(x or "").strip()]

    anchor_tokens = _expanded_meaningful_tokens(anchor_norm)
    target_tokens = _expanded_meaningful_tokens(" ".join([target_norm] + alias_texts))

    overlap = anchor_tokens & target_tokens
    ratio = (len(overlap) / max(1, len(anchor_tokens))) if anchor_tokens else 0.0

    exact = bool(anchor_norm and (anchor_norm in target_norm or anchor_norm in alias_texts))
    partial = bool(overlap)
    alias_match = any(anchor_norm and (anchor_norm in a or a in anchor_norm) for a in alias_texts)

    return {
        "phrase_overlap_count": len(overlap),
        "phrase_overlap_ratio": round(ratio, 4),
        "exact_phrase_match": exact,
        "partial_phrase_match": partial,
        "alias_match": alias_match,
        "stem_match": bool(overlap),
        "expanded_overlap_terms": sorted(overlap),
        "phrase_evidence_score": round(min(1.0, (1.0 if exact else 0.0) + (0.25 if alias_match else 0.0) + ratio), 4),
    }


def _concept_alignment_score(anchor_text: Any, target_text: Any) -> Dict[str, Any]:
    a = _expanded_meaningful_tokens(anchor_text)
    t = _expanded_meaningful_tokens(target_text)
    overlap = a & t
    score = len(overlap) / max(1, len(a)) if a else 0.0

    return {
        "concept_alignment_score": round(score, 4),
        "concept_overlap_terms": sorted(overlap),
    }



def _passes_phrase_title_overlap_guard(phrase: str, title: str, source_type: str) -> bool:
    # Guard mainly protects draft/imported semantic drift.
    if source_type not in {"draft", "imported"}:
        return True

    p = _meaningful_tokens(phrase)
    t = _meaningful_tokens(title)
    overlap = p & t

    # Require at least two meaningful shared tokens for draft/imported auto-linking.
    return len(overlap) >= 2



def _is_non_linkable_asset_url(url: str) -> bool:
    u = str(url or "").lower().strip()
    if not u:
        return True

    return (
        "images." in u
        or "/images/" in u
        or "/gcms/" in u
        or "/wp-content/uploads/" in u
        or u.endswith((
            ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg", ".avif",
            ".pdf", ".mp4", ".mov", ".mp3", ".wav", ".zip"
        ))
    )


