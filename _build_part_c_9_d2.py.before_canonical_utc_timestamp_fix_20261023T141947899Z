def candidate(source: str) -> str:
    source = source.replace("\r\n", "\n")
    if "apply_runtime_terminal_lifecycle" in source:
        raise RuntimeError("Part C 9-D lifecycle connection is already present.")
    replacements = (
        ("from dataclasses import dataclass\n", "from dataclasses import dataclass, replace\n"),
        ("from pathlib import Path\n", "import hashlib\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n"),
        (
            "from backend.server.coordination.workflow_persistence.repository import WorkflowRepository\n",
            "from backend.server.coordination.workflow_persistence.repository import WorkflowRepository\n"
            "from backend.server.coordination.universal_workflows.contract import UniversalWorkflowStatus\n"
            "from backend.server.coordination.workflow_lifecycle.transition_validation import require_valid_workflow_transition\n"
            "from backend.server.coordination.workflow_lifecycle.terminal_state_protection import require_terminal_state_mutation_allowed\n"
            "from backend.server.coordination.workflow_lifecycle.lifecycle_history import (\n"
            "    LifecycleHistoryEntry,\n"
            "    append_lifecycle_history,\n"
            "    create_lifecycle_history_entry,\n"
            ")\n",
        ),
        (
            'RUNTIME_COORDINATION_GATEWAY_VERSION = "runtime_coordination_gateway_v1.1.0"',
            'RUNTIME_COORDINATION_GATEWAY_VERSION = "runtime_coordination_gateway_v1.2.0"',
        ),
    )
    for old, new in replacements:
        if source.count(old) != 1:
            raise RuntimeError(f"Patch anchor is not unique: {old!r}")
        source = source.replace(old, new, 1)
    anchor = "\n\n@dataclass(frozen=True, slots=True)\nclass RuntimeCoordinationGateway:\n"
    if source.count(anchor) != 1:
        raise RuntimeError("RuntimeCoordinationGateway class anchor is not unique.")
    source = source.replace(anchor, RESULT_CLASS + anchor, 1)
    method_anchor = "\n    def snapshot(self) -> Mapping[str, Any]:\n"
    if source.count(method_anchor) != 1:
        raise RuntimeError("snapshot() method anchor is not unique.")
    source = source.replace(method_anchor, METHOD + method_anchor, 1)
    return source


