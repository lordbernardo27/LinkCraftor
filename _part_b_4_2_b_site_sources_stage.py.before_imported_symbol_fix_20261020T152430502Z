    )

    def isolated_http_get(
        url: str,
    ) -> tuple[int, bytes, str]:
        http_calls.append(url)

        if url.endswith("/robots.txt"):
            return (
                200,
                (
                    "User-agent: *\n"
                    f"Sitemap: {robots_sitemap}\n"
                ).encode("utf-8"),
                "text/plain",
            )

        return (
            404,
            b"",
            "text/plain",
        )

    def isolated_sitemap_expander(
        sitemap_url: str,
        *,
        max_sitemaps: int = 250,
    ) -> tuple[list[str], list[dict[str, Any]]]:
        expansion_calls.append(
            {
                "sitemap_url": sitemap_url,
                "max_sitemaps": max_sitemaps,
            }
        )

        if sitemap_url == robots_sitemap:
            return (
                [
                    "https://example.com/",
                    "https://example.com/about",
                    "https://example.com/about",
                    "https://example.com/articles/one",
                ],
                [],
            )

        return (
            [],
            [
                {
                    "url": sitemap_url,
                    "error": "not_found_in_probe",
                }
            ],
        )

