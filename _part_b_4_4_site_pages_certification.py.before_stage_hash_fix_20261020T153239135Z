def sha256(path: Path) -> str:
    return hashlib.sha256(
        path.read_bytes()
    ).hexdigest()


def record(
    name: str,
    passed: bool,
    detail: Any = None,
) -> None:
    results.append(
        (
            name,
            bool(passed),
            detail,
        )
    )

    print(
        f"{name}: {'PASS' if passed else 'FAIL'}"
    )

    if detail is not None:
        rendered = json.dumps(
            detail,
            indent=2,
            sort_keys=True,
            default=str,
        )

        for line in rendered.splitlines():
            print("  " + line)


def source_calls(path: Path) -> list[str]:
    source = path.read_text(
        encoding="utf-8-sig",
    )

    tree = ast.parse(
        source,
        filename=str(path),
    )

    calls: set[str] = set()

    def dotted_name(node: ast.AST) -> str:
        parts: list[str] = []

        while isinstance(node, ast.Attribute):
            parts.append(node.attr)
            node = node.value

        if isinstance(node, ast.Name):
            parts.append(node.id)

        return ".".join(
            reversed(parts)
        )

    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            calls.add(
                dotted_name(node.func)
            )

    return sorted(calls)


def write_report(
    *,
    status: str,
    standard_error: str = "",
) -> None:
    passed = sum(
        1
        for _, value, _ in results
        if value
    )

    failed = sum(
        1
        for _, value, _ in results
        if not value
    )

    lines = [
        "LINKCRAFTER PIPELINE REGISTRATION",
        "PART B 4.4 SITE PAGES STAGE CERTIFICATION",
        "",
        "Generated: "
        + datetime.now(timezone.utc).isoformat(),
        "Mode: ISOLATED EXISTING-STAGE CERTIFICATION",
        "Production source changes: NONE",
        "Production persistence executed: NO",
        "Temporary isolated persistence used: YES",
        "Runtime registrations created: NO",
        "Universal jobs created: NO",
        "Queue claims executed: NO",
        "Production handlers executed: NO",
        "Live network requests executed: NO",
        f"CERTIFICATION STATUS: {status}",
        "",
        "=" * 112,
        "RUNTIME VERIFICATION",
        "=" * 112,
    ]

    for name, value, detail in results:
        lines.append(
            f"{name}: {'PASS' if value else 'FAIL'}"
        )

        if detail is not None:
            rendered = json.dumps(
                detail,
                indent=2,
                sort_keys=True,
                default=str,
            )

            lines.extend(
                "  " + line
                for line in rendered.splitlines()
            )

    lines.extend(
        [
            "",
            "=" * 112,
            "STANDARD ERROR",
            "=" * 112,
            standard_error,
            "",
            "=" * 112,
            "PART B 4.4 CERTIFIED BOUNDARY",
            "=" * 112,
            "- build_site_pages() remains the canonical Site Pages authority.",
            "- Only URL Cleaner-admitted same-domain records become Site Pages.",
            "- Canonical duplicates, external domains and rejected inputs fail closed.",
            "- Explicit and uncertain cleaner confidence values are retained.",
            "- Site Pages evidence is persisted atomically through its repository.",
            "- Certification persistence is restricted to a temporary directory.",
            "- Live Domain Target Pool and all later stages remain excluded.",
            "- Runtime registration remains deferred to Part B Step 5.",
            "",
            "=" * 112,
            "FINAL RESULT",
            "=" * 112,
            f"TESTS_PASSED={passed}",
            f"TESTS_FAILED={failed}",
        ]
    )

    if status == "CERTIFIED":
        lines.extend(
            [
                "PART_B_4_4_CERTIFICATION=PASS",
                "FINAL RESULT: PART B 4.4 SITE PAGES STAGE CERTIFIED",
            ]
