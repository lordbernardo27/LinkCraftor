def sha256_bytes(
    value: bytes,
) -> str:
    return hashlib.sha256(
        value
    ).hexdigest()


def tree_snapshot(
    root: Path,
) -> Dict[str, Any]:
    if not root.exists():
        return {
            "exists":
                False,

            "files":
                {},
        }

    files: Dict[str, Any] = {}

    for path in sorted(
        root.rglob("*")
    ):
        if not path.is_file():
            continue

        stat = path.stat()

        files[
            path.relative_to(
                root
            ).as_posix()
        ] = {
            "size":
                stat.st_size,

            "modified_ns":
                stat.st_mtime_ns,
        }

    return {
        "exists":
            True,

        "files":
            files,
    }


def protected_snapshot() -> Dict[str, Any]:
    return {
        str(path):
            tree_snapshot(
                path
            )

        for path
        in PROTECTED_DIRECTORIES
    }


def require(
